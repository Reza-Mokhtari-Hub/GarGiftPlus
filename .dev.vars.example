# Copy to .dev.vars (gitignored) for local Wrangler / Astro development ONLY.
# NEVER reuse local development secrets in Staging or Production!
#
# In Staging / Production, set distinct values per environment via:
#   npx wrangler secret put <NAME> --env staging
#   npx wrangler secret put <NAME> --env production
#
# Provider credentials (Zarinpal, Zibal, Resend, Turnstile) and their settings
# are stored per-environment in D1 via Admin -> Settings (keys encrypted using
# SECRETS_KEK; never placed in .dev.vars or wrangler.jsonc).
#
# `npm run provision:local` automatically generates local SECRETS_KEK and AUTH_SECRET.

# ── One-click deploy label (ignored locally; unused value) ────────────────────
USE_A_LONG_RANDOM_STRING_FOR_SECRETS_KEK_AND_AUTH_SECRET=unused

# Key-encryption key for the encrypted D1 vault (generate: openssl rand -base64 32)
SECRETS_KEK=

# HMAC key signing admin sessions, customer magic-links, and cart/guest tokens.
# MUST be a different random secret from SECRETS_KEK.
AUTH_SECRET=

# Optional dedicated secret for /api/internal/cache-purge (recommended when caching is enabled).
# Generate a distinct random string from SECRETS_KEK and AUTH_SECRET.
CACHE_PURGE_SECRET=

