---
import { fa } from '../i18n/fa';
import { toPersianDigits } from '../lib/format';

// Admin list filter bar.
export interface SelectFilter {
  name: string;
  label: string;
  anyLabel: string;
  value: string | null;
  options: { value: string; label: string }[];
}

interface Props {
  action: string;
  selects: SelectFilter[];
  search?: { name: string; value: string | null; placeholder: string };
  hidden?: Record<string, string | undefined>;
  active: boolean;
  count?: number;
  noun?: string;
}

const { action, selects, search, hidden = {}, active, count, noun = 'مورد' } = Astro.props;
---

<form method="GET" action={action} class="mb-6 flex flex-wrap items-end gap-3" data-filter-bar>
  {
    Object.entries(hidden).map(([name, value]) =>
      value ? <input type="hidden" name={name} value={value} /> : null,
    )
  }

  {
    search && (
      <label class="flex flex-col gap-1">
        <span class="text-xs font-medium text-faint">{fa.navigation.search}</span>
        <input
          type="search"
          name={search.name}
          value={search.value ?? ''}
          placeholder={search.placeholder}
          class="w-56 rounded-md border border-line bg-surface px-3 py-1.5 text-sm text-ink focus:border-brand focus:outline-none"
        />
      </label>
    )
  }

  {
    selects.map((s) => (
      <label class="flex flex-col gap-1">
        <span class="text-xs font-medium text-faint">{s.label}</span>
        <select
          name={s.name}
          class="rounded-md border border-line bg-surface px-2.5 py-1.5 text-sm text-ink focus:border-brand focus:outline-none"
          data-filter-select
        >
          <option value="">{s.anyLabel}</option>
          {s.options.map((o) => (
            <option value={o.value} selected={s.value === o.value}>
              {o.label}
            </option>
          ))}
        </select>
      </label>
    ))
  }

  <button
    type="submit"
    class="rounded-md border border-line bg-surface px-4 py-1.5 text-xs font-semibold text-ink transition-colors hover:border-brand hover:text-brand-fg"
  >
    {fa.common.apply}
  </button>

  {
    active && (
      <a
        href={action}
        class="py-1.5 text-xs font-medium text-faint transition-colors hover:text-brand-fg"
      >
        {fa.common.clear}
      </a>
    )
  }

  {
    active && count !== undefined && (
      <span class="py-1.5 text-xs tabular-nums text-muted">
        {toPersianDigits(count)} {noun}
      </span>
    )
  }
</form>

<script>
  // Progressive enhancement only: with JS the dropdowns apply immediately, and
  // without it the Apply button still submits the same form.
  document.querySelectorAll('[data-filter-bar]').forEach((form) => {
    form.querySelectorAll('[data-filter-select]').forEach((select) => {
      select.addEventListener('change', () => (form as HTMLFormElement).requestSubmit());
    });
  });
</script>
