---
import { fa } from '../i18n/fa';
import { toPersianDigits } from '../lib/format';

interface Props {
  page: number;
  totalPages: number;
  hrefFor: (page: number) => string;
}

const { page, totalPages, hrefFor } = Astro.props;

function windowed(cur: number, total: number): (number | '…')[] {
  const keep = new Set<number>([1, total, cur, cur - 1, cur + 1]);
  const nums = [...keep].filter((p) => p >= 1 && p <= total).sort((a, b) => a - b);
  const out: (number | '…')[] = [];
  let prev = 0;
  for (const p of nums) {
    if (p - prev > 1) out.push('…');
    out.push(p);
    prev = p;
  }
  return out;
}

const items = totalPages > 1 ? windowed(page, totalPages) : [];
const linkCls =
  'rounded-md px-3 py-1.5 text-xs font-medium text-muted transition-colors hover:bg-surface-elevated hover:text-brand-fg';
---

{
  totalPages > 1 && (
    <nav class="mt-14 flex items-center justify-center gap-1.5" aria-label={fa.navigation.paginationAria}>
      {page > 1 && (
        <a href={hrefFor(page - 1)} class={linkCls} rel="prev">
          {fa.common.previous}
        </a>
      )}
      {items.map((it) =>
        it === '…' ? (
          <span class="px-2 text-xs text-faint">…</span>
        ) : (
          <a
            href={hrefFor(it)}
            aria-current={it === page ? 'page' : undefined}
            class={`${linkCls} tabular-nums ${
              it === page ? 'bg-brand text-on-brand hover:bg-brand-hover hover:text-on-brand' : ''
            }`}
          >
            {toPersianDigits(it)}
          </a>
        ),
      )}
      {page < totalPages && (
        <a href={hrefFor(page + 1)} class={linkCls} rel="next">
          {fa.common.next}
        </a>
      )}
    </nav>
  )
}

