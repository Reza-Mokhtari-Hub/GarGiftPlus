---
// One encrypted-vault key INPUT, designed to live inside a section's form (which
// carries the single Save button). Submits the typed value as `secret:<name>`;
// leaving it blank keeps the stored value. When a value is already stored, shows an
// "Encrypted in D1" chip and a "Remove" checkbox (`clear:<name>`) to delete it on
// save. The Settings page's section handlers process those fields. When the vault
// (SECRETS_KEK) isn't set, the input is replaced with a short note.
interface Props {
  name: string; // SecretName
  label: string;
  hint?: string;
  storedInD1: boolean;
  vault: boolean;
  required?: boolean;
  requiredWhen?: string;
}
const {
  name,
  label,
  hint,
  storedInD1,
  vault,
  required = false,
  requiredWhen,
} = Astro.props;
---

<div class="flex flex-col gap-1.5">
  <div class="flex items-center gap-2">
    <span class="text-xs font-medium text-muted">{label}</span>
    {
      storedInD1 && (
        <span class="gg-status-success rounded-full border px-2 py-0.5 text-[10px] font-bold">
          ذخیره‌شده با رمزنگاری در D1
        </span>
      )
    }
  </div>
  {
    vault ? (
      <div class="flex flex-wrap items-center gap-3">
        <input
          type="password"
          name={`secret:${name}`}
          autocomplete="off"
          placeholder={storedInD1 ? 'برای حفظ مقدار فعلی خالی بگذارید' : hint}
          required={required && !storedInD1}
          data-lightning-required-when={requiredWhen}
          data-secret-stored={storedInD1 ? '1' : '0'}
          class="gg-admin-input ltr-inline w-72 max-w-full font-mono text-xs"
        />
        {storedInD1 && (
          <label class="flex items-center gap-1.5 text-xs text-muted">
            <input type="checkbox" name={`clear:${name}`} value="1" class="size-3.5 accent-brand" />
            <span>حذف کلید ذخیره‌شده</span>
          </label>
        )}
      </div>
    ) : (
      <span class="text-xs text-amber">
        برای ثبت امن کلید، متغیر <code>SECRETS_KEK</code> را روی Worker تنظیم کنید.
      </span>
    )
  }
</div>
