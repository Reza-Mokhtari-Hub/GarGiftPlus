---
interface Props {
  title: string;
  description?: string;
  actionLabel?: string;
  actionHref?: string;
}

const { title, description, actionLabel, actionHref } = Astro.props;
---

<div class="gg-admin-card flex flex-col items-center justify-center gap-3 px-6 py-12 text-center">
  <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-soft text-brand-fg">
    <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0-3-3m3 3 3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
    </svg>
  </div>
  <div class="max-w-md space-y-1">
    <h2 class="text-base font-bold text-ink">{title}</h2>
    {description && <p class="text-xs leading-6 text-muted">{description}</p>}
  </div>
  {
    actionLabel && actionHref && (
      <a href={actionHref} class="gg-admin-btn-primary mt-1">
        {actionLabel}
      </a>
    )
  }
  <slot />
</div>
