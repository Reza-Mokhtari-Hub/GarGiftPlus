---
interface Props {
  label: string;
  value: string;
  hint?: string;
  href?: string;
  tone?: 'violet' | 'turquoise' | 'coral' | 'amber';
}

const { label, value, hint, href, tone = 'violet' } = Astro.props;

const toneClasses: Record<NonNullable<Props['tone']>, { iconBg: string; ring: string }> = {
  violet: {
    iconBg: 'bg-brand-soft text-brand-fg border-brand/20',
    ring: 'hover:border-brand/50',
  },
  turquoise: {
    iconBg: 'bg-emerald-500/12 text-accent border-accent/25',
    ring: 'hover:border-accent/50',
  },
  coral: {
    iconBg: 'bg-rose-500/12 text-coral border-coral/25',
    ring: 'hover:border-coral/50',
  },
  amber: {
    iconBg: 'bg-amber-500/14 text-amber border-amber/25',
    ring: 'hover:border-amber/50',
  },
};

const theme = toneClasses[tone];
const Wrapper = href ? 'a' : 'div';
---

<Wrapper
  href={href}
  class={`gg-admin-card flex items-start justify-between gap-3 p-4 transition-all ${href ? `${theme.ring} cursor-pointer hover:-translate-y-0.5` : ''}`}
>
  <div class="min-w-0 space-y-1">
    <p class="text-xs font-medium text-muted">{label}</p>
    <p class="text-xl font-extrabold tracking-tight text-ink sm:text-2xl">{value}</p>
    {hint && <p class="text-[11px] text-faint">{hint}</p>}
  </div>
  <div class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border ${theme.iconBg}`}>
    <slot name="icon">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
      </svg>
    </slot>
  </div>
</Wrapper>
