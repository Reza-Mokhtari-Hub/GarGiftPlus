---
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
}

const { title, subtitle, badge } = Astro.props;
---

<header class="mb-6 flex flex-col gap-4 border-b border-line pb-5 sm:flex-row sm:items-center sm:justify-between">
  <div class="min-w-0 space-y-1">
    <div class="flex flex-wrap items-center gap-2.5">
      <h1 class="text-2xl font-extrabold tracking-tight text-ink">{title}</h1>
      {
        badge && (
          <span class="rounded-full bg-brand-soft px-2.5 py-0.5 text-xs font-semibold text-brand-fg">
            {badge}
          </span>
        )
      }
    </div>
    {subtitle && <p class="text-sm text-muted">{subtitle}</p>}
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <slot name="actions" />
  </div>
</header>
