---
import type { CustomerAccount } from '../customers/accountsDb';
import { customerDisplayName, customerInitials } from '../customers/accountsDb';
import type { Wallet } from '../wallet/db';
import { formatMoney } from '../../money';
import { fa } from '../../i18n/fa';

interface Props {
  customer: CustomerAccount;
  wallet: Wallet;
  active: 'dashboard' | 'orders' | 'wallet' | 'transactions' | 'profile' | 'tickets';
  title: string;
  subtitle?: string;
}

const { customer, wallet, active, title, subtitle } = Astro.props;
const displayName = customerDisplayName(customer, customer.email);
const initials = customerInitials(customer, customer.email);
const formattedBalance = formatMoney(wallet.balance, wallet.currency);

const navItems = [
  { id: 'dashboard', label: fa.accountMenu.dashboard, href: '/account' },
  { id: 'orders', label: fa.accountMenu.orders, href: '/account/orders' },
  { id: 'wallet', label: fa.accountMenu.wallet, href: '/account/wallet' },
  { id: 'transactions', label: fa.accountMenu.transactions, href: '/account/transactions' },
  { id: 'tickets', label: 'پشتیبانی و تیکت‌ها', href: '/account/tickets' },
  { id: 'profile', label: fa.accountMenu.profile, href: '/account/profile' },
] as const;
---

<div class="mx-auto max-w-6xl space-y-6">
  {/* نوار هدر حساب کاربری */}
  <section class="rounded-xl border border-line bg-surface p-5 sm:p-6">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
      <div class="flex items-center gap-3.5">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand text-base font-extrabold text-on-brand shadow-sm"
        >
          {initials}
        </div>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="gg-h2 truncate text-ink">{title}</h1>
            <span class="rounded-md border border-brand/25 bg-brand/10 px-2 py-0.5 text-[11px] font-semibold text-brand-fg">
              {displayName}
            </span>
          </div>
          <p class="mt-0.5 text-xs text-muted">
            {subtitle ?? `ورود با ایمیل تاییدشده: ${customer.email}`}
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/account/wallet"
          class="flex items-center gap-2.5 rounded-xl border border-accent/35 bg-paper px-4 py-2.5 transition-colors hover:border-accent"
        >
          <div class="text-end">
            <span class="block text-[11px] text-muted">موجودی کیف پول</span>
            <span class="gg-numeric text-sm font-extrabold text-accent-fg">{formattedBalance}</span>
          </div>
          <span class="rounded-lg bg-accent/15 px-2.5 py-1 text-xs font-bold text-accent-fg">
            + شارژ
          </span>
        </a>

        <a
          href="/account/logout"
          class="inline-flex min-h-10 items-center justify-center rounded-xl border border-line bg-paper px-3.5 py-2 text-xs font-semibold text-danger transition-colors hover:border-danger hover:bg-danger/10"
        >
          {fa.accountMenu.logout}
        </a>
      </div>
    </div>

    {/* تب‌های ناوبری حساب کاربری */}
    <nav
      aria-label="منوی حساب کاربری"
      class="mt-5 flex flex-wrap items-center gap-1.5 border-t border-line pt-4"
    >
      {navItems.map((item) => {
        const isCurrent = item.id === active;
        return (
          <a
            href={item.href}
            aria-current={isCurrent ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3.5 py-2 text-xs font-semibold transition-colors',
              isCurrent
                ? 'bg-brand text-on-brand shadow-xs'
                : 'border border-transparent bg-paper text-muted hover:border-line hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </section>

  <div>
    <slot />
  </div>
</div>
