                  <ProductCard card={card} index={i} headingLevel="h3" />
                ))}
              </ul>
            </section>
          );

        case 'popular_products':
          if (data.popularProducts.length === 0) return null;
          return (
            <section data-homepage-section="popular_products">
              <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
