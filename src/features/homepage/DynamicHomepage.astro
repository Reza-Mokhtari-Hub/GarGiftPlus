          return (
            <section data-homepage-section="promotional_banners">
              <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
                <div>
                  {section.badge_text && (
                    <p class="text-xs font-bold text-brand-fg">{section.badge_text}</p>
