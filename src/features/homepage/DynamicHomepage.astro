                        <span aria-hidden="true" class="transition-transform group-hover:-translate-x-1">
                          &larr;
                        </span>
                      </div>
                    </a>
                  );
                })}
              </div>
            </section>
          );

        case 'featured_products':
          if (data.featuredProducts.length === 0) return null;
