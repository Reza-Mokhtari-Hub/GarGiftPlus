                </div>
                <a
                  href={section.cta_href || '/products'}
                  class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface px-3.5 py-2 text-xs font-bold text-ink transition-colors hover:border-brand hover:text-brand-fg"
