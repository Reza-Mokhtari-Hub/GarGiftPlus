                <a
                  href={section.cta_href || '/categories/game-topup'}
                  class="inline-flex items-center gap-1.5 rounded-xl bg-brand px-4 py-2.5 text-xs font-bold text-on-brand transition-colors hover:bg-brand-hover"
                >
                  <span>{section.cta_text || 'مشاهده محصولات گیمینگ'}</span>
                  <span aria-hidden="true">&larr;</span>
                </a>
              </div>

              {data.gamingProducts.length > 0 ? (
                <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                  {data.gamingProducts.map((card, i) => (
                    <ProductCard card={card} index={i} headingLevel="h3" />
