              </div>

              {data.giftCardProducts.length > 0 ? (
                <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                  {data.giftCardProducts.map((card, i) => (
                    <ProductCard card={card} index={i} headingLevel="h3" />
                  ))}
                </ul>
              ) : (
                <div class="rounded-2xl border border-dashed border-line bg-paper p-6 text-center text-xs text-muted">
