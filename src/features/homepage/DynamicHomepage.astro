                </div>
              )}
            </section>
          );

        case 'gift_cards':
          return (
            <section
              data-homepage-section="gift_cards"
              class="rounded-3xl border border-brand/30 bg-gradient-to-br from-brand-soft/60 via-surface to-surface-elevated p-6 sm:p-8"
            >
              <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
