                </div>
              </div>

              <div
                class={`grid grid-cols-1 gap-6 ${
                  data.promotionalBanners.length > 1 ? 'lg:grid-cols-2' : ''
                }`}
              >
                {data.promotionalBanners.map((banner) => {
                  const themeCls =
                    bannerThemeClasses[banner.accentTheme] ?? bannerThemeClasses.violet;
                  const badgeCls =
                    bannerBadgeClasses[banner.accentTheme] ?? bannerBadgeClasses.violet;
                  return (
                    <div
                      data-promo-banner={banner.publicId}
                      class={`group relative flex flex-col justify-between overflow-hidden rounded-3xl border p-6 shadow-sm transition-all hover:shadow-md sm:p-8 ${themeCls}`}
                    >
                      <div class="relative z-10 flex flex-col items-start">
                        {banner.badgeText && (
                          <span
                            class={`rounded-md px-2.5 py-1 text-[11px] font-bold ${badgeCls}`}
                          >
                            {banner.badgeText}
                          </span>
                        )}
                        <h3 class="mt-3 text-xl font-extrabold text-ink sm:text-2xl">
                          {banner.title}
                        </h3>
                        {banner.subtitle && (
                          <p class="mt-1 font-mono text-xs font-semibold text-brand-fg" dir="ltr">
                            {banner.subtitle}
                          </p>
                        )}
                        {banner.description && (
                          <p class="mt-2.5 max-w-xl text-xs leading-relaxed text-muted sm:text-sm">
                            {banner.description}
                          </p>
                        )}
                      </div>

                      {(banner.desktopImage || banner.mobileImage) && (
                        <div class="my-5 overflow-hidden rounded-2xl border border-line bg-surface">
                          {banner.desktopImage && banner.mobileImage ? (
                            <picture>
                              <source
                                media="(max-width: 767px)"
                                srcset={banner.mobileImage.srcset ?? banner.mobileImage.src}
                              />
                              <StoreImage
                                image={banner.desktopImage}
                                class="h-44 w-full object-cover sm:h-52"
                              />
                            </picture>
                          ) : (
                            <StoreImage
                              image={(banner.desktopImage ?? banner.mobileImage)!}
                              class="h-44 w-full object-cover sm:h-52"
                            />
                          )}
                        </div>
                      )}

                      <div class="relative z-10 mt-6">
                        <a
                          href={banner.ctaHref}
                          class="inline-flex items-center gap-2 rounded-xl bg-brand px-5 py-2.5 text-xs font-bold text-on-brand transition-colors hover:bg-brand-hover"
                        >
                          <span>{banner.ctaText}</span>
                          <span aria-hidden="true">&larr;</span>
                        </a>
                      </div>
                    </div>
                  );
                })}
              </div>
            </section>
          );

        case 'service_benefits':
          if (data.serviceBenefits.length === 0) return null;
          return (
            <section id="service-benefits" data-homepage-section="service_benefits">
              <div class="mb-6 text-center">
                {section.badge_text && (
                  <p class="text-xs font-bold text-accent-fg">{section.badge_text}</p>
                )}
                <h2 class="gg-h2 mt-1 text-ink">{section.title}</h2>
                {section.subtitle && (
                  <p class="mx-auto mt-1 max-w-2xl text-xs text-muted sm:text-sm">
                    {section.subtitle}
                  </p>
                )}
              </div>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
                {data.serviceBenefits.map((benefit) => (
                  <div class="flex flex-col rounded-3xl border border-[#e3e7f7] bg-white p-5 shadow-[0_10px_26px_-6px_rgba(91,99,254,0.08)] dark:rounded-2xl dark:border-[#192838] dark:bg-[#0b101b]/95 dark:shadow-[0_0_28px_rgba(53,217,204,0.04)]">
                    <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-[#eef0ff] text-[#5b63fe] dark:rounded-xl dark:border dark:border-[#35d9cc]/35 dark:bg-[#0b1f26] dark:text-[#35d9cc] dark:shadow-[0_0_16px_rgba(53,217,204,0.2)]">
                      {benefit.icon === 'shield' ? (
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        </svg>
                      ) : benefit.icon === 'delivery' ? (
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <polyline points="20 12 20 22 4 22 4 12" />
                          <rect x="2" y="7" width="20" height="5" />
                          <line x1="12" y1="22" x2="12" y2="7" />
                        </svg>
                      ) : benefit.icon === 'tracking' ? (
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <circle cx="12" cy="12" r="10" />
                          <polyline points="12 6 12 12 16 14" />
                        </svg>
                      ) : benefit.icon === 'history' ? (
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                          <polyline points="14 2 14 8 20 8" />
                        </svg>
                      ) : (
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                        </svg>
                      )}
                    </span>
                    <h3 class="mt-3.5 text-sm font-extrabold text-ink dark:text-white">{benefit.title}</h3>
                    <p class="mt-1.5 text-xs leading-relaxed text-muted">{benefit.description}</p>
                  </div>
                ))}
              </div>
            </section>
          );

        case 'testimonials':
          if (data.approvedReviews.length === 0 && data.hideTestimonialsWhenEmpty) {
            return null;
          }
          return (
            <section data-homepage-section="testimonials">
              <div class="mb-6">
                {section.badge_text && (
                  <p class="text-xs font-bold text-brand-fg">{section.badge_text}</p>
                )}
                <h2 class="gg-h2 mt-1 text-ink">{section.title}</h2>
                {section.subtitle && (
                  <p class="mt-1 text-xs text-muted sm:text-sm">{section.subtitle}</p>
                )}
              </div>

              {data.approvedReviews.length > 0 ? (
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {data.approvedReviews.map((rev) => (
                    <article class="flex flex-col justify-between rounded-2xl border border-line bg-surface p-5 shadow-2xs">
                      <div>
                        <div class="flex items-center justify-between gap-2">
                          <span class="text-xs font-bold text-ink">{rev.customer_name}</span>
                          <span class="gg-numeric rounded-md bg-amber/15 px-2 py-0.5 text-xs font-bold text-amber">
                            ★ {toPersianDigits(rev.rating)} از ۵
                          </span>
                        </div>
                        {rev.product_name && (
                          <p class="mt-1 text-[11px] font-medium text-brand-fg">
                            محصول: {rev.product_name}
                          </p>
                        )}
                        <p class="mt-3 text-xs leading-relaxed text-muted">{rev.comment}</p>
                      </div>
                    </article>
                  ))}
                </div>
              ) : (
                <div class="rounded-2xl border border-dashed border-line bg-surface p-6 text-center text-xs text-muted">
                  {data.testimonialsEmptyMessage}
                </div>
              )}
            </section>
          );

        case 'faq':
          if (data.faqs.length === 0) return null;
          return (
            <section id="faq" data-homepage-section="faq" class="rounded-3xl border border-line bg-surface p-6 sm:p-10">
              <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
                <div>
                  {section.badge_text && (
                    <p class="text-xs font-bold text-brand-fg">{section.badge_text}</p>
                  )}
                  <h2 class="gg-h2 mt-1 text-ink">{section.title}</h2>
                  {section.subtitle && (
                    <p class="mt-1 text-xs text-muted sm:text-sm">{section.subtitle}</p>
                  )}
                </div>
              </div>

              <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
                {data.faqs.map((item) => (
                  <details class="group rounded-2xl border border-line bg-paper px-5 py-4 transition-colors open:border-brand/40">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-bold text-ink">
                      <span>{item.question}</span>
                      <span
                        aria-hidden="true"
                        class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-surface text-xs text-brand-fg transition-transform group-open:rotate-180"
                      >
                        ▾
                      </span>
                    </summary>
                    <p class="mt-3 border-t border-line pt-3 text-xs leading-relaxed text-muted sm:text-sm">
                      {item.answer}
                    </p>
                  </details>
                ))}
              </div>
            </section>
          );

        case 'final_cta':
          return (
            <section
              data-homepage-section="final_cta"
              class="relative overflow-hidden rounded-3xl border border-brand/35 bg-gradient-to-l from-brand-soft via-surface to-surface-elevated p-8 text-center shadow-md sm:p-12"
            >
              <div class="mx-auto max-w-2xl">
                {section.badge_text && (
                  <span class="inline-block rounded-lg bg-brand/15 px-3 py-1 text-xs font-bold text-brand-fg">
                    {section.badge_text}
                  </span>
                )}
                <h2 class="mt-3 text-2xl font-extrabold text-ink sm:text-3xl">
                  {section.title}
                </h2>
                {section.subtitle && (
                  <p class="mt-3 text-xs leading-relaxed text-muted sm:text-sm">
                    {section.subtitle}
                  </p>
                )}

                <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
                  <a
                    href={section.cta_href || '/products'}
                    class="inline-flex items-center gap-2 rounded-xl bg-brand px-6 py-3.5 text-sm font-bold text-on-brand shadow-sm transition-colors hover:bg-brand-hover"
                  >
                    <span>{section.cta_text || 'همین حالا محصولات گرگیفت رو ببین'}</span>
                    <span aria-hidden="true">&larr;</span>
                  </a>
                  {section.secondary_cta_text && (
                    <a
                      href={section.secondary_cta_href || '/account'}
                      class="inline-flex items-center gap-2 rounded-xl border border-line bg-surface px-5 py-3.5 text-sm font-bold text-ink transition-colors hover:border-brand hover:text-brand-fg"
                    >
                      <span>{section.secondary_cta_text}</span>
                    </a>
                  )}
                </div>
              </div>
            </section>
          );

        default:
          return null;
      }
    })
  }
</div>
