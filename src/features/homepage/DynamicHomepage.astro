                    <span>{section.badge_text || 'گیمینگ و شارژ بازی'}</span>
                  </span>
                  <h2 class="gg-h2 mt-2 text-ink">{section.title}</h2>
                  {section.subtitle && (
                    <p class="mt-1 text-xs font-medium text-muted sm:text-sm">{section.subtitle}</p>
