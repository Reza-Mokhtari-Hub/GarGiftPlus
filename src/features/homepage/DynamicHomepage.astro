                  <span>{section.cta_text || 'مشاهده کاتالوگ کامل'}</span>
                  <span aria-hidden="true">&larr;</span>
                </a>
              </div>

              <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {data.popularProducts.map((card, i) => (
                  <ProductCard card={card} index={i} headingLevel="h3" />
                ))}
              </ul>
            </section>
          );

        case 'ai_products':
