---
import { getConfig, formatPrice } from '../../../config';
import type { PendingPayment } from '../lightning/pending';

// Simulated checkout view. Rendered by /pay/[publicId] for demo-backed payments.
// The form posts back to that same route, which calls settleDemoCheckout().
interface Props {
  pending: PendingPayment;
  declined?: string | null;
}
const { pending, declined = null } = Astro.props;

const OUTCOMES: Record<string, string> = {
  approve: 'تایید و تکمیل پرداخت',
  decline: 'رد پرداخت — تراکنش ناموفق',
  insufficient: 'رد پرداخت — موجودی ناکافی',
};
const { storeName } = getConfig();
const total = formatPrice(pending.amount_total_cents, pending.currency);
const shipping = pending.shipping_cents
  ? formatPrice(pending.shipping_cents, pending.currency)
  : null;

// Parse the cart snapshot for a line summary (same shape checkout stored).
type Snap = { id: number; q: number; n: string; p: number };
let items: Snap[] = [];
try {
  items = pending.items ? (JSON.parse(pending.items) as Snap[]) : [];
} catch {
  items = [];
}
---

<div class="mx-auto max-w-md">
  <div class="mb-6 rounded-xl border border-amber-400/50 bg-amber-50 px-4 py-4 text-center text-amber-900 dark:bg-amber-950/40 dark:text-amber-200">
    <p class="text-sm font-bold">پرداخت آزمایشی (دمو) — بدون کسر وجه واقعی</p>
    <p class="mt-1 text-xs leading-6">
      هیچ مبلغ واقعی از کارت یا حساب شما کسر نمی‌شود. با تایید این فرم یک سفارش آزمایشی با برچسب
      <code class="ltr-inline rounded bg-amber-100 px-1 dark:bg-amber-900/60">demo</code>
      ثبت می‌شود.
    </p>
  </div>

  <h1 class="gg-h2 mb-1 text-ink">تسویه حساب آزمایشی</h1>
  <p class="mb-6 text-sm text-muted">{storeName}</p>

  {/* Order summary */}
  <div class="mb-6 rounded-xl border border-line bg-surface p-4">
    <ul class="divide-y divide-line text-sm">
      {items.map((it) => (
        <li class="flex items-center justify-between gap-3 py-2">
          <span class="min-w-0 truncate text-ink">
            {it.n} <span class="text-faint">× {it.q}</span>
          </span>
          <span class="shrink-0 tabular-nums text-ink">{formatPrice(it.p * it.q, pending.currency)}</span>
        </li>
      ))}
    </ul>
    {shipping && (
      <div class="flex items-center justify-between border-t border-line pt-2 text-sm text-muted">
        <span>هزینه ارسال</span>
        <span class="tabular-nums">{shipping}</span>
      </div>
    )}
    <div class="mt-2 flex items-center justify-between border-t border-line pt-2 text-base font-semibold text-ink">
      <span>جمع کل</span>
      <span class="tabular-nums">{total}</span>
    </div>
  </div>

  {declined && (
    <p class="mb-4 rounded-xl border border-coral/30 bg-coral/10 px-3 py-2 text-sm text-coral">
      {declined}
    </p>
  )}

  <form method="POST" class="space-y-4">
    <div>
      <label class="mb-1 block text-xs font-medium text-muted" for="email">
        ایمیل دریافت تاییدیه و تحویل سفارش
      </label>
      <input
        id="email"
        name="email"
        type="email"
        dir="ltr"
        value={pending.email ?? ''}
        autocomplete="email"
        required
        class="w-full rounded-xl border border-line bg-surface px-3 py-2 text-sm text-ink focus:border-brand focus:outline-none"
      />
    </div>

    <fieldset class="rounded-xl border border-line p-3">
      <legend class="px-1 text-xs font-medium text-muted">اطلاعات کارت آزمایشی (صرفاً نمایشی)</legend>
      <input
        type="text"
        dir="ltr"
        value="4242 4242 4242 4242"
        inputmode="numeric"
        aria-label="شماره کارت آزمایشی"
        class="mb-2 w-full rounded-lg border border-line bg-paper px-3 py-2 font-mono text-sm text-muted"
      />
      <div class="flex gap-2">
        <input
          type="text"
          dir="ltr"
          value="12 / 34"
          aria-label="تاریخ انقضا"
          class="w-1/2 rounded-lg border border-line bg-paper px-3 py-2 font-mono text-sm text-muted"
        />
        <input
          type="text"
          dir="ltr"
          value="123"
          aria-label="CVV2"
          class="w-1/2 rounded-lg border border-line bg-paper px-3 py-2 font-mono text-sm text-muted"
        />
      </div>
    </fieldset>

    <div>
      <label class="mb-1 block text-xs font-medium text-muted" for="outcome">
        شبیه‌سازی نتیجه تراکنش
      </label>
      <select
        id="outcome"
        name="outcome"
        class="w-full rounded-xl border border-line bg-surface px-3 py-2 text-sm text-ink focus:border-brand focus:outline-none"
      >
        {Object.entries(OUTCOMES).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    </div>

    <button
      type="submit"
      class="w-full rounded-xl bg-brand px-5 py-3 text-sm font-semibold text-on-brand hover:bg-brand-hover"
    >
      پرداخت آزمایشی {total}
    </button>
    <a href="/cart" class="block text-center text-xs text-faint hover:text-brand-fg">
      انصراف و بازگشت به سبد خرید
    </a>
  </form>
</div>
