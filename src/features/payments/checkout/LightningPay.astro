---
import { renderSVG } from 'uqr';
import { formatPrice } from '../../../config';
import type { PendingPayment } from '../lightning/pending';

// Lightning QR view. Rendered by /pay/[publicId] for lnbits/phoenixd payments;
// that route polls the node on load and redirects to the order page once settled.
// When `expired`, it shows a terminal state with no reload loop.
interface Props {
  pending: PendingPayment;
  expired?: boolean;
}
const { pending, expired = false } = Astro.props;

const bolt11 = pending.bolt11 ?? '';
const lightningUri = `lightning:${bolt11}`;
// Server-rendered QR (static SVG — keeps the page near-zero-JS).
const qrSvg = bolt11 ? renderSVG(bolt11, { border: 2 }) : null;
const fiat = formatPrice(pending.amount_total_cents, pending.currency);
const sats = (pending.amount_sat ?? 0).toLocaleString('en-US');
const refreshSeconds = 4;
// Epoch ms the invoice lapses, so the reload loop can stop instead of polling
// the node forever on an abandoned tab.
const expiresAtMs = pending.expires_at ? Date.parse(pending.expires_at) : null;
---

{
  expired ? (
    <div class="mx-auto max-w-md rounded-2xl border border-line bg-surface p-6 text-center">
      <h1 class="gg-h2 mb-2 text-ink">مهلت فاکتور به پایان رسید</h1>
      <p class="mb-6 text-sm text-muted">
        این فاکتور Lightning دیگر قابل پرداخت نیست و وجهی از شما کسر نشده است. برای ثبت مجدد از سبد خرید اقدام کنید.
      </p>
      <a
        href="/cart"
        class="inline-block rounded-xl bg-brand px-5 py-2.5 text-sm font-semibold text-on-brand hover:bg-brand-hover"
      >
        بازگشت به سبد خرید
      </a>
    </div>
  ) : (
    <Fragment>
      <div class="mx-auto max-w-md text-center">
        <h1 class="gg-h2 mb-1 text-ink">پرداخت با شبکه Lightning</h1>
        <p class="mb-1 text-3xl font-bold tabular-nums text-ink" dir="ltr">{sats} sats</p>
        <p class="mb-6 text-sm text-muted">{fiat} · برای پرداخت کد را اسکن کنید</p>

        <a
          href={lightningUri}
          class="block rounded-xl border border-line bg-surface p-4"
          aria-label="باز کردن در کیف پول Lightning"
        >
          <div
            class="mx-auto aspect-square w-full max-w-[18rem] rounded-lg bg-surface p-2 [&>svg]:h-full [&>svg]:w-full"
            set:html={qrSvg}
          />
        </a>

        <div class="mt-4 text-start">
          <label class="mb-1 block text-xs font-medium text-muted" for="invoice">
            کد فاکتور (Lightning Invoice)
          </label>
          <div class="flex gap-2">
            <input
              id="invoice"
              dir="ltr"
              value={bolt11}
              readonly
              class="min-w-0 flex-1 truncate rounded-xl border border-line bg-surface px-3 py-2 font-mono text-xs text-ink"
            />
            <button
              type="button"
              data-copy
              data-invoice={bolt11}
              class="shrink-0 rounded-xl bg-brand px-4 py-2 text-xs font-semibold text-on-brand hover:bg-brand-hover"
            >
              کپی
            </button>
          </div>
        </div>

        <a href={lightningUri} class="mt-4 inline-block text-sm font-medium text-accent hover:underline">
          باز کردن در کیف پول ←
        </a>

        <p class="mt-6 text-xs text-faint" data-status>
          در انتظار تایید پرداخت… این صفحه به‌صورت خودکار به‌روزرسانی می‌شود.
        </p>
      </div>

      <script is:inline define:vars={{ refreshSeconds, expiresAtMs }}>
        const now = Date.now();
        if (!expiresAtMs || now < expiresAtMs) {
          const delay = expiresAtMs
            ? Math.min(refreshSeconds * 1000, expiresAtMs - now + 500)
            : refreshSeconds * 1000;
          setTimeout(() => location.reload(), Math.max(delay, 500));
        }

        document.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
          const btn = e.currentTarget;
          try {
            await navigator.clipboard.writeText(btn.dataset.invoice || '');
            const prev = btn.textContent;
            btn.textContent = 'کپی شد';
            setTimeout(() => (btn.textContent = prev), 1500);
          } catch {
            /* clipboard unavailable — the invoice is still selectable */
          }
        });
      </script>
    </Fragment>
  )
}
