---
import {
  formatPrice,
  toMajorUnits,
  currencyDecimals,
  minorUnitsPerMajor,
} from '../../config';
import type { Order } from '../orders/db';
import { listRefunds, reversedRefundIds, refundableCents } from './db';
import { env } from 'cloudflare:workers';
import { formatJalaliDateTime, toPersianDigits } from '../../lib/format';

interface Props {
  order: Order;
  timeZone: string;
}

const { order, timeZone } = Astro.props;

const history = await listRefunds(env.DB, order.id);
const reversed = reversedRefundIds(history);
const remaining = refundableCents(order);
const method = order.payment_method;

const canRefundViaProvider =
  (method === 'stripe' || method == null) &&
  !!order.provider_session_id &&
  remaining > 0 &&
  order.external_refunded_cents === 0;
const canSyncProvider = (method === 'stripe' || method == null) && remaining > 0;
const isDemo = method === 'demo';
const canRecord = remaining > 0;

const state =
  order.refunded_cents === 0
    ? 'none'
    : order.refunded_cents >= order.amount_total_cents
      ? 'full'
      : 'partial';

const reviewOpen = order.refund_review_reason !== null && order.refund_reviewed_at === null;
const REVIEW_COPY: Record<string, string> = {
  currency_mismatch:
    'اعلان بازگشت وجه با ارزی متفاوت از ارز سفارش دریافت شده است. مبالغ تغییر داده نشدند.',
  exceeds_order_total:
    'مجموع بازگشت وجه درگاه و بازگشت‌های ثبت‌شده دستی از مبلغ کل سفارش بیشتر شده است.',
};

const KIND_LABEL: Record<string, string> = {
  provider_api: 'بازگشت از طریق درگاه',
  provider_sync: 'همگام‌سازی درگاه',
  manual_external: 'ثبت دستی / واریز خارج از درگاه',
  manual_reversal: 'اصلاح / ابطال',
  demo: 'تنظیم آزمایشی',
  legacy: 'ثبت‌شده پیشین',
};

const decimals = currencyDecimals(order.currency);
const stepVal = String(1 / minorUnitsPerMajor(order.currency));
const majorInput = (minor: number) => toMajorUnits(minor, order.currency).toFixed(decimals);
---

<section class="gg-admin-card mb-6 overflow-hidden">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-3.5">
    <h2 class="text-sm font-bold text-ink">بازگشت وجه و تسویه مالی سفارش</h2>
    {
      state !== 'none' && (
        <span
          class:list={[
            'rounded-full px-3 py-1 text-xs font-bold',
            state === 'full' ? 'gg-status-error' : 'gg-status-warning',
          ]}
        >
          {state === 'full' ? 'مستردشده کامل' : 'استرداد جزئی'}
        </span>
      )
    }
  </div>

  {
    reviewOpen && (
      <div class="gg-status-warning border-b border-line px-5 py-4 text-xs">
        <p class="font-semibold">
          نیازمند بررسی مالی:{' '}
          {REVIEW_COPY[order.refund_review_reason!] ?? order.refund_review_reason}
        </p>
        <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="mt-3">
          <input type="hidden" name="_action" value="review_refund" />
          <button type="submit" class="gg-admin-btn-secondary py-1.5 text-xs">
            ثبت تایید بررسی مغایرت
          </button>
        </form>
      </div>
    )
  }

  <dl class="grid grid-cols-2 gap-x-6 gap-y-4 px-5 py-4 text-sm sm:grid-cols-3">
    <div>
      <dt class="text-[11px] font-medium text-faint">مبلغ کل سفارش</dt>
      <dd class="mt-1 font-bold text-ink tabular-nums">
        {formatPrice(order.amount_total_cents, order.currency)}
      </dd>
    </div>
    {
      order.provider_refunded_cents > 0 && (
        <div>
          <dt class="text-[11px] font-medium text-faint">مستردشده از درگاه</dt>
          <dd class="mt-1 font-semibold text-ink tabular-nums">
            {formatPrice(order.provider_refunded_cents, order.currency)}
          </dd>
        </div>
      )
    }
    {
      order.external_refunded_cents > 0 && (
        <div>
          <dt class="text-[11px] font-medium text-faint">ثبت‌شده دستی / کیف پول</dt>
          <dd class="mt-1 font-semibold text-ink tabular-nums">
            {formatPrice(order.external_refunded_cents, order.currency)}
          </dd>
        </div>
      )
    }
    <div>
      <dt class="text-[11px] font-medium text-faint">جمع کل مستردشده</dt>
      <dd class="mt-1 font-bold text-coral tabular-nums">
        {formatPrice(order.refunded_cents, order.currency)}
      </dd>
    </div>
    <div>
      <dt class="text-[11px] font-medium text-faint">مانده قابل استرداد</dt>
      <dd class="mt-1 font-semibold text-ink tabular-nums">
        {formatPrice(remaining, order.currency)}
      </dd>
    </div>
    <div>
      <dt class="text-[11px] font-medium text-faint">خالص دریافتی</dt>
      <dd class="mt-1 font-extrabold text-brand-fg tabular-nums">
        {formatPrice(order.amount_total_cents - order.refunded_cents, order.currency)}
      </dd>
    </div>
  </dl>

  {
    history.length > 0 && (
      <ul class="border-t border-line text-sm">
        {history.map((r) => (
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line px-5 py-3 last:border-b-0">
            <span
              class:list={[
                'font-bold tabular-nums',
                r.amount_cents < 0 ? 'text-muted' : 'text-ink',
                reversed.has(r.id) ? 'text-faint line-through' : '',
              ]}
            >
              {r.amount_cents < 0 ? '−' : ''}
              {formatPrice(Math.abs(r.amount_cents), order.currency)}
            </span>
            <span class="rounded-md bg-surface-2 px-2 py-0.5 text-[11px] font-medium text-muted">
              {KIND_LABEL[r.kind] ?? r.kind}
            </span>
            <span class="text-xs text-muted">
              {formatJalaliDateTime(r.created_at, { timeZone })}
            </span>
            {r.created_by && (
              <span class="ltr-inline font-mono text-xs text-muted">{r.created_by}</span>
            )}
            {r.provider_refund_id && (
              <span class="ltr-inline font-mono text-xs text-faint">{r.provider_refund_id}</span>
            )}
            {reversed.has(r.id) && (
              <span class="rounded bg-surface-2 px-2 py-0.5 text-[11px] text-faint">باطل‌شده</span>
            )}
            {(r.reason || r.note) && (
              <span class="w-full text-xs text-muted">
                {[r.reason, r.note].filter(Boolean).join(' — ')}
              </span>
            )}
            {(r.kind === 'manual_external' || r.kind === 'demo') &&
              r.status === 'succeeded' &&
              !reversed.has(r.id) && (
                <form
                  method="POST"
                  action={`/api/admin/orders/${order.public_id}`}
                  data-confirm-message="آیا از ابطال این رکورد بازگشت وجه مطمئن هستید؟ این کار فقط دفتر کل پنل را اصلاح می‌کند و تراکنش بانکی انجام نمی‌دهد."
                >
                  <input type="hidden" name="_action" value="void_refund" />
                  <input type="hidden" name="refund_id" value={r.public_id} />
                  <button
                    type="submit"
                    class="text-xs font-semibold text-coral hover:underline"
                  >
                    ابطال رکورد
                  </button>
                </form>
              )}
          </li>
        ))}
      </ul>
    )
  }

  {
    (canRefundViaProvider || canRecord || canSyncProvider) && (
      <div class="space-y-5 border-t border-line px-5 py-4">
        {canRefundViaProvider && (
          <form
            method="POST"
            action={`/api/admin/orders/${order.public_id}`}
            data-confirm-message={`مبلغ ${formatPrice(remaining, order.currency)} از طریق درگاه پرداخت به مشتری مسترد شود؟`}
          >
            <input type="hidden" name="_action" value="refund" />
            <button type="submit" class="gg-admin-btn-danger text-xs">
              استرداد {formatPrice(remaining, order.currency)} از طریق درگاه
            </button>
            <p class="mt-2 text-xs text-muted">
              مبلغ باقیمانده را از طریق درگاه پرداخت به خریدار بازمی‌گرداند.
            </p>
          </form>
        )}

        {canRecord && (
          <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="space-y-2">
            <input type="hidden" name="_action" value="record_refund" />
            <p class="text-xs font-bold text-ink">
              {isDemo
                ? 'ثبت استرداد آزمایشی (Demo)'
                : `ثبت دستی بازگشت وجه (${toPersianDigits(remaining)} واحد باقیمانده)`}
            </p>
            <div class="flex flex-wrap items-center gap-2">
              <input
                type="number"
                name="amount"
                step={stepVal}
                min={stepVal}
                max={majorInput(remaining)}
                value={majorInput(remaining)}
                required
                dir="ltr"
                aria-label="مبلغ بازگشت وجه"
                class="gg-admin-input w-36 font-mono text-left text-sm tabular-nums"
              />
              <input
                type="text"
                name="note"
                placeholder="توضیح نحوه واریز (مثال: شماره پیگیری شبا / کارت‌به‌کارت)"
                aria-label="توضیح داخلی"
                class="gg-admin-input min-w-52 flex-1 text-sm"
              />
              <button type="submit" class="gg-admin-btn-secondary text-xs">
                {isDemo ? 'ثبت استرداد آزمایشی' : 'ثبت بازگشت وجه دستی'}
              </button>
            </div>
            <p class="text-xs text-muted">
              {isDemo
                ? 'فقط وضعیت آمار سفارش آزمایشی را به‌روزرسانی می‌کند و انتقال وجه واقعی انجام نمی‌شود.'
                : 'این فرم فقط ثبت حسابداری بازگشت وجهی است که قبلاً خارج از سیستم (مثل کارت‌به‌کارت یا پنل درگاه) انجام داده‌اید. برای واریز مستقیم به کیف پول مشتری از بخش «بازگشت وجه به کیف پول» استفاده کنید.'}
            </p>
          </form>
        )}

        {canSyncProvider && (
          <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="space-y-2">
            <input type="hidden" name="_action" value="sync_refund" />
            <p class="text-xs font-bold text-ink">همگام‌سازی بازگشت وجه از درگاه</p>
            <div class="flex flex-wrap items-center gap-2">
              <input
                type="number"
                name="amount"
                step={stepVal}
                min="0"
                max={majorInput(order.amount_total_cents)}
                required
                dir="ltr"
                aria-label="مجموع مبلغ مستردشده در درگاه"
                placeholder={majorInput(order.amount_total_cents)}
                class="gg-admin-input w-36 font-mono text-left text-sm tabular-nums"
              />
              <input
                type="text"
                name="provider_refund_id"
                placeholder="شناسه مرجع استرداد درگاه (اختیاری)"
                aria-label="شناسه مرجع درگاه"
                class="gg-admin-input min-w-52 flex-1 text-sm"
              />
              <button type="submit" class="gg-admin-btn-secondary text-xs">
                همگام‌سازی مجموع
              </button>
            </div>
            <p class="text-xs text-muted">
              فقط زمانی استفاده کنید که استرداد در پنل درگاه انجام شده اما وب‌هوک آن ثبت نشده است؛ مجموع کل مبلغ مستردشده را وارد کنید.
            </p>
          </form>
        )}
      </div>
    )
  }
</section>
