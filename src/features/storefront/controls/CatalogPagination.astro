---
import type { StorefrontPaginationModel } from '../models';
import { fa } from '../../../i18n/fa';
import { toPersianDigits } from '../../../lib/format';

/**
 * Page links. Owns navigation landmark, `aria-current="page"`, and rel=prev/next.
 */
interface Props {
  model: StorefrontPaginationModel;
  class?: string;
}

const { model, class: className = 'mt-14 flex items-center justify-center gap-1.5' } = Astro.props;
const linkCls =
  'rounded-md px-3 py-1.5 text-xs font-medium text-muted transition-colors hover:bg-surface-elevated hover:text-brand-fg';
---

{
  model.totalPages > 1 && (
    <nav class={className} aria-label={fa.navigation.paginationAria}>
      {model.prevHref && (
        <a href={model.prevHref} class={linkCls} rel="prev">
          {fa.common.previous}
        </a>
      )}
      {model.items.map((item) =>
        item.page === null ? (
          <span class="px-2 text-xs text-faint">…</span>
        ) : (
          <a
            href={item.href}
            aria-current={item.current ? 'page' : undefined}
            class={`${linkCls} tabular-nums ${
              item.current ? 'bg-brand text-on-brand hover:bg-brand-hover hover:text-on-brand' : ''
            }`}
          >
            {toPersianDigits(item.page)}
          </a>
        ),
      )}
      {model.nextHref && (
        <a href={model.nextHref} class={linkCls} rel="next">
          {fa.common.next}
        </a>
      )}
    </nav>
  )
}

