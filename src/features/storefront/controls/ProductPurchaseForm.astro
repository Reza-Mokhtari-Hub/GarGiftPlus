---
import type { ProductPurchaseModel } from '../models';
import { fa } from '../../../i18n/fa';

/**
 * Purchase controls — owns form actions, hidden public IDs, variant_id,
 * extra add-ons, dynamic custom checkout fields, inline error feedback, and POST Buy Now.
 */
interface Props {
  model: ProductPurchaseModel;
}

const { model } = Astro.props;
const showAny = model.showAddToCart || model.showBuyNow;
const customFields = model.customFields ?? [];
---

{
  showAny &&
    (model.hasOptions ? (
      <form method="POST" action={model.cartAction} class="mt-8 max-w-lg" data-options-form>
        <input type="hidden" name="_action" value="add" />
        <input type="hidden" name="product_id" value={model.productId} />

        {model.variants.length > 0 && (
          <fieldset class="mb-6">
            <legend class="mb-2.5 text-xs font-semibold text-muted">
              {model.variantLabel || fa.product.selectOption}
            </legend>
            <div class="flex flex-col gap-2">
              {model.variants.map((variant) => (
                <label
                  class={`flex items-center justify-between gap-3 rounded-lg border px-4 py-3 text-sm transition-colors ${
                    variant.soldOut
                      ? 'cursor-not-allowed border-line bg-surface-secondary text-faint opacity-75'
                      : 'cursor-pointer border-line bg-surface text-ink hover:border-brand'
                  }`}
                >
                  <span class="flex items-start gap-3">
                    <input
                      type="radio"
                      name="variant_id"
                      value={variant.id}
                      required
                      disabled={variant.soldOut}
                      checked={variant.defaultSelected}
                      data-price={variant.priceCents}
                      data-compare={variant.comparePriceCents ?? 0}
                      data-image-id={variant.imageAnchor}
                      class="mt-1 accent-brand"
                    />
                    <span class="flex flex-col gap-0.5">
                      <span class="font-medium">
                        {variant.label}
                        {variant.soldOut && ` — ${fa.product.unavailable}`}
                      </span>
                      {(variant.region || variant.amountLabel || variant.durationLabel) && (
                        <span class="text-xs text-muted">
                          {[variant.region, variant.amountLabel, variant.durationLabel]
                            .filter(Boolean)
                            .join(' · ')}
                        </span>
                      )}
                    </span>
                  </span>
                  <span class="flex flex-col items-end gap-0.5">
                    <span class="gg-numeric font-semibold text-ink">{variant.formattedPrice}</span>
                    {variant.formattedComparePrice && (
                      <span class="gg-numeric text-xs text-faint line-through">
                        {variant.formattedComparePrice}
                      </span>
                    )}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        )}

        {model.extras.length > 0 && (
          <fieldset class="mb-6">
            <legend class="mb-2.5 text-xs font-semibold text-muted">{fa.product.addons}</legend>
            <div class="flex flex-col gap-2">
              {model.extras.map((extra) => (
                <label class="flex cursor-pointer items-center justify-between gap-3 rounded-lg border border-line bg-surface px-4 py-3 text-sm text-ink transition-colors hover:border-brand">
                  <span class="flex items-center gap-3">
                    <input
                      type="checkbox"
                      name="extra"
                      value={extra.id}
                      data-price={extra.priceDeltaCents}
                      class="accent-brand"
                    />
                    <span class="font-medium">{extra.label}</span>
                  </span>
                  <span class="gg-numeric font-medium text-muted">+{extra.formattedPriceDelta}</span>
                </label>
              ))}
            </div>
          </fieldset>
        )}

        {customFields.length > 0 && (
          <fieldset class="mb-6 rounded-xl border border-line bg-surface p-4">
            <legend class="px-1.5 text-xs font-semibold text-ink">
              {fa.product.customFieldsTitle}
            </legend>
            <p class="mb-3 rounded-md bg-surface-elevated px-3 py-2 text-xs text-muted">
              {fa.product.passwordWarning}
            </p>
            <div class="flex flex-col gap-4">
              {customFields.map((field) => {
                const inputId = `cf-${field.key}`;
                const inputName = `cf_${field.key}`;
                return (
                  <label for={inputId} class="flex flex-col gap-1.5 text-xs font-medium text-ink">
                    <span>
                      {field.label}
                      {field.required && <span class="ms-1 text-danger-fg">*</span>}
                    </span>

                    {field.type === 'textarea' ? (
                      <textarea
                        id={inputId}
                        name={inputName}
                        rows={3}
                        required={field.required}
                        minlength={field.minLength ?? undefined}
                        maxlength={field.maxLength ?? undefined}
                        placeholder={field.placeholder ?? undefined}
                        class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-sm text-ink transition-colors focus:border-brand focus:outline-none"
                      />
                    ) : field.type === 'select' ? (
                      <select
                        id={inputId}
                        name={inputName}
                        required={field.required}
                        class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-sm text-ink transition-colors focus:border-brand focus:outline-none"
                      >
                        <option value="" disabled={field.required} selected>
                          {fa.product.selectPlaceholder}
                        </option>
                        {field.options.map((opt) => (
                          <option value={opt}>{opt}</option>
                        ))}
                      </select>
                    ) : (
                      <input
                        id={inputId}
                        name={inputName}
                        type={field.type === 'email' ? 'email' : 'text'}
                        inputmode={field.type === 'number' ? 'decimal' : undefined}
                        dir={field.type === 'email' || field.type === 'number' ? 'ltr' : undefined}
                        required={field.required}
                        minlength={field.minLength ?? undefined}
                        maxlength={field.maxLength ?? undefined}
                        placeholder={field.placeholder ?? undefined}
                        class={`w-full rounded-lg border border-line bg-paper px-3 py-2 text-sm text-ink transition-colors focus:border-brand focus:outline-none${
                          field.type === 'email' || field.type === 'number' ? ' ltr-inline text-start' : ''
                        }`}
                      />
                    )}

                    {field.helpText && (
                      <span class="text-xs font-normal text-muted">{field.helpText}</span>
                    )}
                  </label>
                );
              })}
            </div>
          </fieldset>
        )}

        <p
          role="alert"
          data-cart-form-error
          class={
            model.error
              ? 'gg-status-warning mb-4 rounded-lg border px-3.5 py-2.5 text-xs font-medium'
              : 'gg-status-warning mb-4 hidden rounded-lg border px-3.5 py-2.5 text-xs font-medium'
          }
        >
          {model.error ?? ''}
        </p>

        {model.soldOut ? (
          <span class="gg-status-disabled inline-block cursor-not-allowed rounded-lg border px-8 py-3 text-sm font-semibold">
            {fa.product.unavailable}
          </span>
        ) : (
          <div class="flex flex-wrap gap-3">
            {model.showAddToCart && (
              <button
                type="submit"
                class="rounded-lg border border-line bg-surface px-7 py-3 text-sm font-semibold text-ink transition-colors hover:border-brand hover:text-brand-fg"
              >
                {fa.product.addToCart}
              </button>
            )}
            {model.showBuyNow && (
              <button
                type="submit"
                formaction={model.expressAction}
                formmethod="POST"
                data-fullpage
                class="rounded-lg bg-brand px-8 py-3 text-sm font-semibold text-on-brand transition-colors hover:bg-brand-hover"
              >
                {fa.product.buyNow}
              </button>
            )}
          </div>
        )}
      </form>
    ) : (
      <div class="mt-8 flex flex-wrap gap-3">
        {model.soldOut && (
          <span class="gg-status-disabled cursor-not-allowed rounded-lg border px-8 py-3 text-sm font-semibold">
            {fa.product.unavailable}
          </span>
        )}
        {!model.soldOut && model.showAddToCart && (
          <form method="POST" action={model.cartAction}>
            <input type="hidden" name="_action" value="add" />
            <input type="hidden" name="product_id" value={model.productId} />
            <button
              type="submit"
              class="rounded-lg border border-line bg-surface px-7 py-3 text-sm font-semibold text-ink transition-colors hover:border-brand hover:text-brand-fg"
            >
              {fa.product.addToCart}
            </button>
          </form>
        )}
        {!model.soldOut && model.showBuyNow && (
          <form method="POST" action={model.expressAction}>
            <input type="hidden" name="product_id" value={model.productId} />
            <button
              type="submit"
              class="rounded-lg bg-brand px-8 py-3 text-sm font-semibold text-on-brand transition-colors hover:bg-brand-hover"
            >
              {fa.product.buyNow}
            </button>
          </form>
        )}
      </div>
    ))
}
