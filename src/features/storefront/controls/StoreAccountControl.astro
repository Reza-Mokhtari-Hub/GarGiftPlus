---
import { fa } from '../../../i18n/fa';

/**
 * دکمه ورود / حساب کاربری در هدر فروشگاه GarGift+
 * در حالت مهمان «ورود / حساب کاربری» را نمایش می‌دهد و در صورت احراز هویت،
 * به‌صورت پیش‌رونده (Progressive Enhancement) بدون آلوده کردن کش عمومی CDN،
 * منوی کشویی مشتری را با نام، آواتار، موجودی کیف پول و لینک‌های کامل نمایش می‌دهد.
 */
interface Props {
  href: string;
  class?: string;
}

const {
  href,
  class: className =
    'inline-flex min-h-8 sm:min-h-9 items-center gap-1 sm:gap-1.5 whitespace-nowrap rounded-lg border border-brand/35 bg-brand/10 px-2 sm:px-3 py-1 sm:py-1.5 text-[11px] sm:text-xs font-semibold text-brand-fg transition-colors hover:border-brand hover:bg-brand hover:text-on-brand',
} = Astro.props;
---

<div class="relative inline-flex items-center" data-account-widget>
  <a href={href} data-account-guest-link class={className}>
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="shrink-0"
    >
      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
      <circle cx="12" cy="7" r="4" />
    </svg>
    <span>{fa.navigation.account}</span>
  </a>

  <details data-account-dropdown class="relative hidden">
    <summary
      class="inline-flex min-h-8 sm:min-h-9 cursor-pointer list-none items-center gap-1.5 sm:gap-2 rounded-lg border border-brand/35 bg-surface px-2 sm:px-2.5 py-1 text-xs font-semibold text-ink transition-colors hover:border-brand"
      aria-label={fa.navigation.account}
    >
      <span
        data-account-avatar
        class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand text-[11px] font-bold text-on-brand"
      >
        ک
      </span>
      <span data-account-display-name class="max-w-20 sm:max-w-32 truncate">حساب من</span>
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        class="text-muted"
      >
        <path d="m6 9 6 6 6-6" />
      </svg>
    </summary>

    <div
      class="fixed inset-x-3 top-16 z-50 rounded-xl border border-line bg-surface p-2 shadow-xl sm:absolute sm:inset-x-auto sm:end-0 sm:top-auto sm:mt-2 sm:w-64"
    >
      <div class="border-b border-line px-3 py-2.5">
        <p data-account-dropdown-name class="truncate text-xs font-bold text-ink">کاربر گرگیفت+</p>
        <p
          data-account-dropdown-email
          dir="ltr"
          class="mt-0.5 truncate text-end font-mono text-[11px] text-muted"
        ></p>
        <div class="mt-2 flex items-center justify-between rounded-lg bg-paper px-2.5 py-1.5 text-[11px]">
          <span class="text-muted">موجودی کیف پول:</span>
          <span data-account-wallet-balance class="gg-numeric font-bold text-accent-fg">۰ تومان</span>
        </div>
      </div>

      <div class="mt-1 flex flex-col gap-0.5 text-xs font-medium" role="menu">
        <a
          href="/account"
          role="menuitem"
          class="flex items-center justify-between rounded-lg px-3 py-2 text-ink transition-colors hover:bg-paper hover:text-brand-fg"
        >
          <span>{fa.accountMenu.dashboard}</span>
        </a>
        <a
          href="/account/orders"
          role="menuitem"
          class="flex items-center justify-between rounded-lg px-3 py-2 text-ink transition-colors hover:bg-paper hover:text-brand-fg"
        >
          <span>{fa.accountMenu.orders}</span>
        </a>
        <a
          href="/account/wallet"
          role="menuitem"
          class="flex items-center justify-between rounded-lg px-3 py-2 text-ink transition-colors hover:bg-paper hover:text-brand-fg"
        >
          <span>{fa.accountMenu.wallet}</span>
        </a>
        <a
          href="/account/transactions"
          role="menuitem"
          class="flex items-center justify-between rounded-lg px-3 py-2 text-ink transition-colors hover:bg-paper hover:text-brand-fg"
        >
          <span>{fa.accountMenu.transactions}</span>
        </a>
        <a
          href="/account/profile"
          role="menuitem"
          class="flex items-center justify-between rounded-lg px-3 py-2 text-ink transition-colors hover:bg-paper hover:text-brand-fg"
        >
          <span>{fa.accountMenu.profile}</span>
        </a>
        <div class="my-1 border-t border-line"></div>
        <a
          href="/account/logout"
          role="menuitem"
          class="flex items-center justify-between rounded-lg px-3 py-2 text-danger transition-colors hover:bg-danger/10"
        >
          <span>{fa.accountMenu.logout}</span>
        </a>
      </div>
    </div>
  </details>
</div>
