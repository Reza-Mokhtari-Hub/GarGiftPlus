---
import { fa } from '../../../i18n/fa';

/**
 * The storefront search form. Owns the GET method, the `q` field name, the
 * search landmark role, and the accessible label.
 */
interface Props {
  action: string;
  query: string;
  class?: string;
  inputClass?: string;
}

const DEFAULT_INPUT_CLASS =
  'w-48 lg:w-52 xl:w-64 rounded-lg border border-line bg-surface px-3 py-1.5 text-sm text-ink transition-all focus:w-56 xl:focus:w-72 focus:border-brand focus:outline-none';

const {
  action,
  query,
  class: className = '',
  inputClass = DEFAULT_INPUT_CLASS,
} = Astro.props;
---

<form method="GET" action={action} class={className} role="search">
  <input
    type="search"
    name="q"
    value={query}
    placeholder={fa.navigation.searchPlaceholder}
    aria-label={fa.navigation.searchAriaLabel}
    class={inputClass}
  />
</form>

