const visibleGroups = navGroups
  .map((g) => ({
    ...g,
    items: g.items.filter((item) => hasAnyAdminPermission(actor, item.permissions)),
  }))
  .filter((g) => g.items.length > 0);

const activeNav = active ?? 'dashboard';
const currentItem = navGroups.flatMap((g) => g.items).find((item) => item.key === activeNav);
const currentLabel =
  active === 'shipping' ? fa.admin.nav.shipping : (currentItem?.label ?? title ?? fa.admin.nav.dashboard);
const searchInitial = Astro.url.pathname === '/admin/search' ? (Astro.url.searchParams.get('q') ?? '') : '';
const roleDisplay = ADMIN_ROLE_LABELS[actor.role] ?? actor.role;

