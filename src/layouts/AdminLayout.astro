<!doctype html>
<html lang="fa" dir="rtl" data-theme="light" data-theme-mode="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeInitScript} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class="gg-admin-body min-h-screen overflow-x-clip bg-paper text-ink antialiased">
    <div
      data-admin-shell
      data-collapsed="false"
      class="gg-admin-shell flex min-h-screen flex-col overflow-x-clip lg:flex-row"
    >
      {/* Mobile drawer backdrop */}
      <div
        data-admin-backdrop
        class="fixed inset-0 z-40 hidden bg-black/50 backdrop-blur-xs lg:hidden"
        aria-hidden="true"
      />

      {/* Unified RTL Sidebar */}
      <aside
        data-admin-sidebar
        aria-label={fa.admin.panelLabel}
        class="gg-admin-sidebar fixed inset-y-0 start-0 z-50 flex w-72 max-w-[85vw] translate-x-full invisible pointer-events-none flex-col transition-all duration-200 lg:visible lg:pointer-events-auto lg:sticky lg:top-0 lg:z-20 lg:h-screen lg:w-64 lg:max-w-none lg:shrink-0 lg:translate-x-0"
      >
        {/* Brand Header */}
        <div class="flex h-16 shrink-0 items-center justify-between gap-2 border-b border-line px-4">
          <a href="/admin" class="flex min-w-0 items-center gap-2.5 rounded-xl hover:opacity-90">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand text-sm font-black text-on-brand shadow-xs">
              G+
            </span>
            <div class="gg-sidebar-brand-text min-w-0">
              <p dir="auto" class="truncate text-xs font-extrabold text-ink">{storeName}</p>
              <p class="truncate text-[11px] font-medium text-muted">مرکز کنترل مدیریت</p>
            </div>
          </a>

          <div class="flex items-center gap-1">
            <button
              type="button"
              data-admin-collapse-btn
              title="جمع/باز کردن منو"
              aria-label="جمع یا باز کردن منوی کناری"
              class="hidden h-8 w-8 items-center justify-center rounded-lg border border-line text-muted transition hover:border-brand hover:text-brand-fg lg:inline-flex"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h10.5m-10.5 5.25h16.5" />
              </svg>
            </button>
            <button
              type="button"
              data-admin-mobile-close
              aria-label="بستن منو"
              class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-line text-muted lg:hidden"
            >
              &times;
            </button>
          </div>
        </div>

        {/* Grouped Navigation */}
        <nav class="flex-1 space-y-5 overflow-y-auto px-3 py-4">
          {
            visibleGroups.map((group) => (
              <div class="space-y-1">
                <p class="gg-sidebar-group-title px-3 pb-1 text-[11px] font-bold tracking-wide text-faint">
                  {group.label}
                </p>
                {group.items.map((item) => {
                  const isActive =
                    activeNav === item.key ||
                    (activeNav === 'shipping' && item.key === 'settings');
                  const iconPath = ICON_PATHS[item.icon] ?? ICON_PATHS.dashboard;
                  return (
                    <a
                      href={item.href}
                      aria-current={isActive ? 'page' : undefined}
                      title={item.label}
                      class={`gg-sidebar-link flex items-center justify-between gap-2.5 rounded-xl px-3 py-2 text-xs font-medium transition-all ${
                        isActive
                          ? 'bg-brand text-on-brand shadow-xs font-semibold'
                          : 'text-muted hover:bg-surface-elevated hover:text-ink'
                      }`}
                    >
                      <span class="flex min-w-0 items-center gap-2.5">
                        <svg
                          class={`size-4 shrink-0 ${isActive ? 'text-on-brand' : 'text-brand-fg/80'}`}
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          aria-hidden="true"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d={iconPath} />
                        </svg>
                        <span class="gg-sidebar-label truncate">{item.label}</span>
                      </span>
                      {typeof item.badge === 'number' && item.badge > 0 && (
                        <span
                          class={`gg-sidebar-badge inline-flex min-w-[1.35rem] items-center justify-center rounded-full px-1.5 py-0.5 text-[10px] font-bold ${
                            isActive
                              ? 'bg-white/20 text-on-brand'
                              : 'bg-coral/15 text-coral'
                          }`}
                        >
                          {toPersianDigits(item.badge)}
                        </span>
                      )}
                    </a>
                  );
                })}
              </div>
            ))
          }
        </nav>

        {/* Bottom Storefront Link */}
        <div class="shrink-0 border-t border-line p-3">
          <div class="gg-sidebar-brand-text mb-2 hidden items-center justify-between gap-2 rounded-xl bg-surface-elevated px-3 py-2 text-[11px] lg:flex">
            <span class="inline-flex shrink-0 items-center gap-1.5 text-muted">
              <span class="h-2 w-2 rounded-full bg-accent"></span>
              <span>فروشگاه فعال</span>
            </span>
            <strong dir="auto" class="truncate font-bold text-ink">{storeName}</strong>
          </div>
          <div class="flex flex-col gap-1.5">
            <a
              href="/"
              target="_blank"
              rel="noopener noreferrer"
              class="gg-sidebar-link flex items-center justify-center gap-2 rounded-xl border border-line bg-paper px-3 py-2 text-xs font-medium text-ink transition hover:border-brand hover:text-brand-fg"
            >
              <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
              <span class="gg-sidebar-label">{fa.admin.viewStore}</span>
            </a>
          </div>
        </div>
      </aside>

      {/* Main Column */}
      <div class="flex min-w-0 flex-1 flex-col">
        {/* Top Utility Bar */}
        <header class="gg-admin-topbar sticky top-0 z-30 flex h-16 items-center justify-between gap-3 px-4 sm:px-6">
          <div class="flex min-w-0 items-center gap-3">
            <button
              type="button"
              data-admin-mobile-open
              aria-label={fa.navigation.openMenu}
              class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-line bg-surface text-ink lg:hidden"
            >
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
              </svg>
            </button>

            <nav aria-label="مسیر صفحه" class="flex min-w-0 items-center gap-1.5 text-xs">
              <a href="/admin" class="hidden text-muted hover:text-brand-fg sm:inline">
                {fa.admin.panelLabel}
              </a>
              <span class="hidden text-faint sm:inline">/</span>
              {
                breadcrumbs && breadcrumbs.length > 0 ? (
                  breadcrumbs.map((bc, idx) => (
                    <>
                      {bc.href ? (
                        <a href={bc.href} class="truncate text-muted hover:text-brand-fg">
                          {bc.label}
                        </a>
                      ) : (
                        <span class="truncate font-bold text-ink">{bc.label}</span>
                      )}
                      {idx !== breadcrumbs.length - 1 && <span class="text-faint">/</span>}
                    </>
                  ))
                ) : (
                  <span class="truncate font-bold text-ink">{currentLabel}</span>
                )
              }
            </nav>
          </div>

          <div class="flex items-center gap-2 sm:gap-3">
            {/* Global Admin Search */}
            <form action="/admin/search" method="GET" class="hidden md:block">
              <label class="relative block">
                <span class="sr-only">جستجو در پنل مدیریت</span>
                <input
                  type="search"
                  name="q"
                  value={searchInitial}
                  placeholder="جستجوی سفارش، مشتری، محصول..."
                  class="w-56 rounded-xl border border-line bg-paper py-1.5 ps-8 pe-3 text-xs text-ink placeholder:text-faint focus:border-brand focus:outline-none lg:w-64"
                />
                <svg
                  class="pointer-events-none absolute start-2.5 top-2 size-3.5 text-faint"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                </svg>
              </label>
            </form>

            {/* Operational Notifications Dropdown */}
            <details class="relative">
              <summary
                aria-label="اعلان‌های عملیاتی"
                class="relative flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-xl border border-line bg-surface text-ink transition hover:border-brand"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
                </svg>
                {alerts.totalAttention > 0 && (
                  <span class="absolute -top-1 -end-1 inline-flex h-4 min-w-[1rem] items-center justify-center rounded-full bg-coral px-1 text-[10px] font-bold text-white">
                    {alerts.totalAttention > 99 ? '۹۹+' : toPersianDigits(alerts.totalAttention)}
                  </span>
                )}
              </summary>
              <div class="gg-admin-card absolute end-0 mt-2 w-72 p-3 shadow-xl">
                <p class="mb-2 border-b border-line pb-2 text-xs font-bold text-ink">
                  صف‌های عملیاتی نیازمند توجه
                </p>
                <ul class="space-y-1.5 text-xs">
                  <li>
                    <a href="/admin/receipts?status=pending_review" class="flex items-center justify-between rounded-lg px-2.5 py-1.5 hover:bg-surface-elevated">
                      <span class="text-muted">فیش‌های بانکی در انتظار تایید</span>
                      <span class="font-bold text-amber">{toPersianDigits(alerts.pendingReceipts)}</span>
                    </a>
                  </li>
                  <li>
                    <a href="/admin/fulfillment" class="flex items-center justify-between rounded-lg px-2.5 py-1.5 hover:bg-surface-elevated">
                      <span class="text-muted">سفارش‌های منتظر تحویل</span>
                      <span class="font-bold text-brand-fg">{toPersianDigits(alerts.pendingFulfillment)}</span>
                    </a>
                  </li>
                  <li>
                    <a href="/admin/tickets?status=open" class="flex items-center justify-between rounded-lg px-2.5 py-1.5 hover:bg-surface-elevated">
                      <span class="text-muted">تیکت‌های پشتیبانی باز</span>
                      <span class="font-bold text-accent-fg">{toPersianDigits(alerts.openTickets)}</span>
                    </a>
                  </li>
                  <li>
                    <a href="/admin/emails?state=dead" class="flex items-center justify-between rounded-lg px-2.5 py-1.5 hover:bg-surface-elevated">
                      <span class="text-muted">ایمیل‌های ناموفق (Outbox)</span>
                      <span class="font-bold text-coral">{toPersianDigits(alerts.failedEmails)}</span>
                    </a>
                  </li>
                  <li>
                    <a href="/admin/orders#inventory-exceptions" class="flex items-center justify-between rounded-lg px-2.5 py-1.5 hover:bg-surface-elevated">
                      <span class="text-muted">خطای رزرو موجودی</span>
                      <span class="font-bold text-coral">{toPersianDigits(alerts.inventoryExceptions)}</span>
                    </a>
                  </li>
                </ul>
              </div>
            </details>

            <ThemeSwitcher scope="admin" compact />

            <div class="hidden items-center gap-2 rounded-xl border border-line bg-surface px-2.5 py-1 sm:flex">
              <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-brand-soft text-[11px] font-bold text-brand-fg">
                {(actor.displayName || 'م').slice(0, 1)}
              </span>
              <div class="leading-tight">
                <p class="max-w-[8rem] truncate text-[11px] font-bold text-ink">
                  {actor.displayName || actor.id}
                </p>
                <p class="max-w-[8rem] truncate text-[10px] text-faint">{roleDisplay}</p>
              </div>
            </div>

            {
              showLogout && (
                <a
                  href="/admin/logout"
                  title={fa.admin.logout}
                  class="inline-flex h-9 items-center gap-1 rounded-xl border border-line bg-surface px-2.5 text-xs font-medium text-muted transition hover:border-coral hover:text-coral"
                >
                  <span>خروج</span>
                </a>
              )
            }
          </div>
        </header>

        {/* Page Content */}
        <main class="mx-auto w-full max-w-[1440px] flex-1 px-4 py-6 sm:px-6 lg:px-8">
          {
            showSetupNudge && (
              <a
                href="/admin/setup"
                class="gg-status-info mb-5 flex items-center justify-between gap-3 rounded-xl border px-4 py-3 text-sm transition-opacity hover:opacity-90"
              >
                <span>
                  <strong class="font-semibold">{fa.admin.setupNudgeTitle}</strong> —{' '}
                  {fa.admin.setupNudgeDesc}
                </span>
                <span aria-hidden="true">&larr;</span>
              </a>
            )
          }
          {
            Astro.locals.settings && paymentsInDemoMode(Astro.locals.settings) && (
              <div class="gg-status-warning mb-5 rounded-xl border px-4 py-3 text-sm">
                <strong class="font-semibold">{fa.admin.demoModeTitle}</strong>{' '}
                {fa.admin.demoModeDesc}
              </div>
            )
          }
          {
            shippingIssue && (
              <a
                href="/admin/shipping"
                class="gg-status-error mb-5 flex items-center justify-between gap-3 rounded-xl border px-4 py-3 text-sm transition-opacity hover:opacity-90"
              >
                <span>
                  <strong class="font-semibold">{fa.admin.shippingIssueTitle}</strong>{' '}
                  {shippingIssue.reason}
                </span>
                <span aria-hidden="true">&larr;</span>
              </a>
            )
          }
          {
            alerts.inventoryExceptions > 0 && (
              <a
                href="/admin/orders#inventory-exceptions"
                class="gg-status-error mb-5 flex items-center justify-between gap-3 rounded-xl border px-4 py-3 text-sm transition-opacity hover:opacity-90"
              >
                <span>
                  <strong class="font-semibold">{fa.admin.inventoryAttentionTitle}</strong>{' '}
                  {alerts.inventoryExceptions === 1
                    ? fa.admin.inventoryAttentionSingular
                    : toPersianDigits(fa.admin.inventoryAttentionPlural(alerts.inventoryExceptions))}
                </span>
                <span aria-hidden="true">&larr;</span>
              </a>
            )
          }

          {
            hasAccess ? (
              <slot />
            ) : (
              <div class="gg-admin-card mx-auto my-12 max-w-lg p-8 text-center">
                <h1 class="text-xl font-bold text-ink">عدم دسترسی به این بخش</h1>
                <p class="mt-2 text-sm text-muted">
                  نقش کاربری شما ({roleDisplay}) مجوز مشاهده یا تغییر این ماژول را ندارد.
                </p>
                <a href="/admin" class="gg-admin-btn-primary mt-5">
                  بازگشت به داشبورد
                </a>
              </div>
            )
          }
        </main>
      </div>
    </div>

    <AdminConfirmDialog />

    <script is:inline>
      (() => {
        const shell = document.querySelector('[data-admin-shell]');
        const sidebar = document.querySelector('[data-admin-sidebar]');
        const backdrop = document.querySelector('[data-admin-backdrop]');
        const openBtn = document.querySelector('[data-admin-mobile-open]');
        const closeBtn = document.querySelector('[data-admin-mobile-close]');
        const collapseBtn = document.querySelector('[data-admin-collapse-btn]');
        const COLLAPSE_KEY = 'gg_admin_sidebar_collapsed';

        try {
          if (localStorage.getItem(COLLAPSE_KEY) === '1' && shell) {
            shell.setAttribute('data-collapsed', 'true');
          }
        } catch {}

        collapseBtn?.addEventListener('click', () => {
          if (!shell) return;
          const next = shell.getAttribute('data-collapsed') === 'true' ? 'false' : 'true';
          shell.setAttribute('data-collapsed', next);
          try {
            localStorage.setItem(COLLAPSE_KEY, next === 'true' ? '1' : '0');
          } catch {}
        });

        const openDrawer = () => {
          sidebar?.classList.remove('translate-x-full', 'invisible', 'pointer-events-none');
          backdrop?.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        };
        const closeDrawer = () => {
          sidebar?.classList.add('translate-x-full', 'invisible', 'pointer-events-none');
          backdrop?.classList.add('hidden');
          document.body.style.overflow = '';
        };

        openBtn?.addEventListener('click', openDrawer);
        closeBtn?.addEventListener('click', closeDrawer);
        backdrop?.addEventListener('click', closeDrawer);
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && backdrop && !backdrop.classList.contains('hidden')) {
            closeDrawer();
          }
        });
      })();
    </script>
  </body>
</html>
