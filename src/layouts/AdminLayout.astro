---
import '@fontsource/vazirmatn/arabic-400.css';
import '@fontsource/vazirmatn/latin-400.css';
import '@fontsource/vazirmatn/arabic-500.css';
import '@fontsource/vazirmatn/latin-500.css';
import '@fontsource/vazirmatn/arabic-600.css';
import '@fontsource/vazirmatn/latin-600.css';
import '@fontsource/vazirmatn/arabic-700.css';
import '@fontsource/vazirmatn/latin-700.css';
import '@fontsource/vazirmatn/arabic-800.css';
import '@fontsource/vazirmatn/latin-800.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import { getConfig } from '../config';
import { paymentsInDemoMode } from '../features/payments';
import { shippingFor } from '../features/shipping/effective';
import { env } from 'cloudflare:workers';
import { resolveAdminActor } from '../features/fulfillment/actor';
import {
  ADMIN_ROLE_LABELS,
  hasAnyAdminPermission,
  type AdminPermission,
} from '../features/fulfillment/permissions';
import { getTopbarAlertsSummary } from '../features/admin/dashboardDb';
import ThemeSwitcher from '../features/storefront/controls/ThemeSwitcher.astro';
import AdminConfirmDialog from '../components/admin/AdminConfirmDialog.astro';
import { fa } from '../i18n/fa';
import { toPersianDigits } from '../lib/format';
import { buildThemeInitScript } from '../lib/theme';
import '../styles/admin.css';

export type Section =
  | 'dashboard'
  | 'fulfillment'
  | 'homepage'
  | 'products'
  | 'orders'
  | 'receipts'
  | 'bankAccounts'
  | 'payments'
  | 'refunds'
  | 'customers'
  | 'wallets'
  | 'categories'
  | 'attributes'
  | 'media'
  | 'pages'
  | 'navigation'
  | 'shipping'
  | 'emails'
  | 'tickets'
  | 'theme'
  | 'settings'
  | 'admins'
  | 'auditLogs'
  | 'reports'
  | 'maintenance';

interface Props {
  title?: string;
  active?: Section;
  breadcrumbs?: Array<{ label: string; href?: string }>;
  requiredPermission?: AdminPermission;
}

const { title, active, breadcrumbs, requiredPermission } = Astro.props;
const config = getConfig();
const storeName = Astro.locals.settings?.storeName ?? config.storeName;
const showSetupNudge =
  !Astro.locals.settings?.setupComplete && Astro.url.pathname !== '/admin/setup';
const showLogout =
  Boolean(Astro.cookies.get('admin_session')?.value) ||
  Boolean(Astro.cookies.get('admin_actor')?.value);

const actor = await resolveAdminActor(env.DB, {
  locals: Astro.locals,
  cookies: Astro.cookies,
  request: Astro.request,
  signingSecret: env.AUTH_SECRET,
});
Astro.locals.adminActor = actor;

const hasAccess = requiredPermission ? actor.permissions.has(requiredPermission) : actor.role !== 'none';
if (!hasAccess) {
  Astro.response.status = 403;
}

const pageTitle = title
  ? `${title} — ${fa.admin.panelLabel} ${storeName}`
  : `${fa.admin.panelLabel} ${storeName}`;
const shippingIssue = shippingFor(Astro.locals.settings).issue;
const alerts = await getTopbarAlertsSummary(env.DB);
const themeInitScript = buildThemeInitScript('admin', 'system');

interface NavItem {
  key: Section;
  label: string;
  href: string;
  icon: string;
  permissions: readonly AdminPermission[];
  badge?: number;
}

interface NavGroup {
  id: string;
  label: string;
  items: NavItem[];
}

const navGroups: NavGroup[] = [
  {
    id: 'overview',
    label: fa.admin.groups.overview,
    items: [
      {
        key: 'dashboard',
        label: fa.admin.nav.dashboard,
