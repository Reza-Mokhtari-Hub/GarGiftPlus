---
import { env } from 'cloudflare:workers';
import '@fontsource/vazirmatn/arabic-400.css';
import '@fontsource/vazirmatn/latin-400.css';
import '@fontsource/vazirmatn/arabic-500.css';
import '@fontsource/vazirmatn/latin-500.css';
import '@fontsource/vazirmatn/arabic-600.css';
import '@fontsource/vazirmatn/latin-600.css';
import '@fontsource/vazirmatn/arabic-700.css';
import '@fontsource/vazirmatn/latin-700.css';
import '@fontsource/vazirmatn/arabic-800.css';
import '@fontsource/vazirmatn/latin-800.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import { getConfig } from '../config';
import { publicOrigin } from '../features/http/origin';
import { normalizeSearchQuery } from '../features/search/query';
import { EMPTY_MENUS, visibleItems } from '../features/navigation/db';
import { buildShellModel } from '../features/storefront/shell';
import type { StorefrontLink } from '../features/storefront/models';
import { getFooterConfig, getHomepageSectionByKey } from '../features/homepage/db';
import { isWithinScheduleWindow } from '../features/homepage/schema';
import { fa } from '../i18n/fa';
import { buildThemeInitScript } from '../lib/theme';
import {
  buildStorefrontAppearanceCss,
  parseThemeAppearanceConfig,
} from '../features/theme/appearance';
import { productImageUrl } from '../features/products/image';
import StoreHeader from '#theme/Header.astro';
import StoreFooter from '#theme/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Root-relative or absolute image for social cards (made absolute below). */
  image?: string;
  /** Override the canonical URL. Used where two routes render the same content
   *  — the catalog is at both / and /products — so only one is indexable. */
  canonical?: string;
  /** Optional JSON-LD structured data payload. */
  jsonLd?: string;
}

const { title, description, image, canonical: canonicalOverride, jsonLd } = Astro.props;
const config = getConfig();
const { features } = config;
const storeName = Astro.locals.settings?.storeName ?? config.storeName;
const logoImageKey = Astro.locals.settings?.logoImageKey ?? null;
const menus = Astro.locals.menus ?? EMPTY_MENUS;
const headerItems = visibleItems(menus.header);
const footerItems = visibleItems(menus.footer);
const cartEnabled = Astro.locals.settings?.cartEnabled ?? true;
const accountsFlag = Astro.locals.settings?.accountsEnabled ?? features.accounts;
const accountsOn = Boolean(accountsFlag && (env.AUTH_SECRET || import.meta.env.DEV));
let announcement = Astro.locals.settings?.announcement ?? '';
let announcementHref = Astro.locals.settings?.announcementHref ?? '';
let categoryLinks: StorefrontLink[] = [];
let footerInfo = null;

try {
  const [catResult, footerCfg, anncSection] = await Promise.all([
    env.DB.prepare(
      `SELECT name, slug FROM categories
        WHERE parent_id IS NULL AND COALESCE(is_featured, 1) = 1
        ORDER BY COALESCE(display_order, 0) ASC, name ASC
        LIMIT 8`,
    ).all<{ name: string; slug: string }>(),
    getFooterConfig(env.DB),
    getHomepageSectionByKey(env.DB, 'announcement'),
  ]);
  categoryLinks = (catResult.results ?? []).map((c) => ({
    text: c.name,
    href: `/categories/${c.slug}`,
  }));
  footerInfo = footerCfg;
  if (anncSection) {
    if (
      anncSection.is_enabled === 1 &&
      isWithinScheduleWindow(anncSection.start_at, anncSection.end_at)
    ) {
      if (!announcement) {
        announcement = anncSection.title;
        announcementHref = anncSection.cta_href ?? '';
      }
    } else if (anncSection.is_enabled === 0 && !Astro.locals.settings?.announcement) {
      announcement = '';
    }
  }
} catch {
  // Graceful fallback on minimal or pre-migration test fixtures
}

const customStoreTitle = Astro.locals.settings?.seoMetaTitle?.trim() || storeName;
const pageTitle = title ? `${title}${fa.SEO.titleSeparator}${storeName}` : customStoreTitle;
const query =
  Astro.url.pathname === '/search'
    ? normalizeSearchQuery(Astro.url.searchParams.get('q') ?? '')
    : '';

const desc = (
  description ??
  Astro.locals.settings?.seoMetaDescription ??
  fa.SEO.defaultDescription
).slice(0, 160);
const origin = publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN);
const canonical = canonicalOverride ?? new URL(Astro.url.pathname, origin).href;
const fallbackOgPath = Astro.locals.settings?.seoOgImageKey
  ? productImageUrl(Astro.locals.settings.seoOgImageKey, config.images.baseUrl)
  : null;
const effectiveImage = image || fallbackOgPath;
const ogImage = effectiveImage ? new URL(effectiveImage, origin).href : undefined;
const appearanceConfig = parseThemeAppearanceConfig(Astro.locals.settings?.themeAppearanceConfig);
const appearanceCss = Astro.locals.settings?.themeAppearanceConfig
  ? buildStorefrontAppearanceCss(appearanceConfig)
  : '';
const themeInitScript = buildThemeInitScript('storefront', appearanceConfig.defaultMode);

const shell = buildShellModel({
  storeName,
  logoImageKey,
  imageBaseUrl: config.images.baseUrl,
  announcement,
  announcementHref,
  headerItems,
  footerItems,
  categoryLinks: categoryLinks.length > 0 ? categoryLinks : undefined,
  footerInfo,
  searchQuery: query,
  cartEnabled,
  accountsEnabled: accountsOn,
});
---

<!doctype html>
<html lang="fa" dir="rtl" data-theme="light" data-theme-mode={appearanceConfig.defaultMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeInitScript} />
    {appearanceCss && <style is:inline set:html={appearanceCss} />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content={storeName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

    {/* Progressive image reveal, site-wide. */}
    <script is:inline>
      document.documentElement.classList.add('image-fade-enabled');
      const finishImageFade = (event) => {
        const image = event.target;
        if (image instanceof HTMLImageElement && image.hasAttribute('data-image-fade')) {
          image.setAttribute('data-image-loaded', '');
        }
      };
      document.addEventListener('load', finishImageFade, true);
      document.addEventListener('error', finishImageFade, true);
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:text-xs focus:font-semibold focus:text-on-brand"
    >
      {fa.common.skipToContent}
    </a>

    <StoreHeader model={shell} />

    <main class="page-shell">
      <div id="main-content" class="contents" tabindex="-1">
        <slot />
      </div>
    </main>

    <StoreFooter model={shell} />

    {/* Slide-out cart drawer (RTL inline-end side). */}
    <div
      data-cart-drawer
      class="invisible pointer-events-none fixed inset-0 z-40"
      role="dialog"
      aria-modal="true"
      aria-label={fa.cart.drawerAria}
    >
      <div
        data-cart-backdrop
        class="absolute inset-0 bg-black/45 opacity-0 transition-opacity duration-300"
      />
      <aside
        data-cart-panel
        class="absolute end-0 top-0 flex h-full w-full max-w-md -translate-x-full flex-col border-s border-line bg-paper shadow-xl transition-transform duration-300"
      >
        <div class="flex items-center justify-between border-b border-line px-6 py-4">
          <h2 class="gg-h2 text-ink">{fa.cart.title}</h2>
          <button
            type="button"
            data-cart-close
            aria-label={fa.cart.closeCart}
            class="-me-2 flex h-11 w-11 items-center justify-center rounded-lg text-2xl leading-none text-faint transition-colors hover:bg-surface hover:text-brand-fg"
          >
            &times;
          </button>
        </div>
        <div data-cart-body class="flex-1 overflow-y-auto px-6 py-5" />
      </aside>
    </div>

    <script>
      // @ts-nocheck -- plain-JS client script (annotations would ship to the browser)
      const hasSessionHint = /(?:^|;\s*)gg_has_session=1/.test(document.cookie);
      if (hasSessionHint || location.pathname.startsWith('/account')) {
        fetch('/partials/account-nav', { headers: { 'X-Partial': '1' } })
          .then((r) => (r.ok ? r.json() : null))
          .then((info) => {
            if (!info || !info.authenticated) return;
            for (const widget of document.querySelectorAll('[data-account-widget]')) {
              const guest = widget.querySelector('[data-account-guest-link]');
              const drop = widget.querySelector('[data-account-dropdown]');
              const av = widget.querySelector('[data-account-avatar]');
              const nm = widget.querySelector('[data-account-display-name]');
              const dnm = widget.querySelector('[data-account-dropdown-name]');
              const dem = widget.querySelector('[data-account-dropdown-email]');
              const wb = widget.querySelector('[data-account-wallet-balance]');
              if (guest) {
                guest.classList.add('hidden');
                guest.classList.remove('inline-flex', 'flex');
                guest.hidden = true;
              }
              if (drop) {
                drop.classList.remove('hidden');
                drop.hidden = false;
              }
              if (av && info.initials) av.textContent = info.initials;
              if (nm && info.displayName) nm.textContent = info.displayName;
              if (dnm && info.displayName) dnm.textContent = info.displayName;
              if (dem && info.email) dem.textContent = info.email;
              if (wb && info.walletBalanceFormatted) wb.textContent = info.walletBalanceFormatted;
            }
            const mobLabel = document.querySelector('[data-mobile-account-label]');
            const mobSubs = document.querySelector('[data-mobile-account-sublinks]');
            if (mobLabel && info.displayName) {
              mobLabel.textContent = `داشبورد من (${info.displayName})`;
            }
            if (mobSubs) {
              mobSubs.classList.remove('hidden');
              mobSubs.classList.add('flex');
            }
            const homeCta = document.querySelector('[data-home-account-cta] span');
            const homeSub = document.querySelector('[data-home-account-subtitle]');
            if (homeCta && info.displayName) {
              homeCta.textContent = `داشبورد من (${info.displayName})`;
            }
            if (homeSub && info.walletBalanceFormatted) {
              homeSub.textContent = `موجودی کیف پول شما: ${info.walletBalanceFormatted}`;
            }
          })
          .catch(() => {});
      }

      const drawer = document.querySelector('[data-cart-drawer]');
      if (drawer instanceof HTMLElement) {
        const panel = drawer.querySelector('[data-cart-panel]');
        const backdrop = drawer.querySelector('[data-cart-backdrop]');
        const body = drawer.querySelector('[data-cart-body]');
        const label = document.querySelector('[data-cart-count-label]');
        const cartCountKey = 'minshop_cart_count';
        const toFaDigits = (v) => String(v).replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[Number(d)]);

        const renderBadge = (n) => {
          const count = Math.max(0, Number(n) || 0);
          if (label) label.textContent = count > 0 ? ` (${count > 99 ? '۹۹+' : toFaDigits(count)})` : '';
          return count;
        };
        const countFromCookie = () => {
          const m = document.cookie.match(/(?:^|;\s*)cart_n=(\d+)/);
          return m ? Number(m[1]) : 0;
        };
        const setBadge = (n) => {
          const count = renderBadge(n);
          try {
            localStorage.setItem(cartCountKey, String(count));
          } catch {
            // Storage can be unavailable in restricted browsing modes.
          }
        };
        if (label) {
          renderBadge(countFromCookie());
          window.addEventListener('storage', (event) => {
            if (event.key === cartCountKey) renderBadge(countFromCookie());
          });
          window.addEventListener('pageshow', () => renderBadge(countFromCookie()));
        }
        const open = () => {
          document.querySelector('[data-nav-disclosure]')?.removeAttribute('open');
          drawer.classList.remove('invisible', 'pointer-events-none');
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              panel?.classList.remove('-translate-x-full');
              backdrop?.classList.remove('opacity-0');
            }),
          );
          document.body.style.overflow = 'hidden';
        };
        const close = () => {
          panel?.classList.add('-translate-x-full');
          backdrop?.classList.add('opacity-0');
          document.body.style.overflow = '';
          setTimeout(() => drawer.classList.add('invisible', 'pointer-events-none'), 300);
        };
        const refresh = async () => {
          const html = await fetch('/partials/cart', { headers: { 'X-Partial': '1' } }).then((r) =>
            r.text(),
          );
          if (body) body.innerHTML = html;
          const root = body?.querySelector('[data-cart-count]');
          setBadge(root ? Number(root.getAttribute('data-cart-count')) : 0);
        };

        for (const el of document.querySelectorAll('[data-cart-open]')) {
          el.addEventListener('click', async (e) => {
            e.preventDefault();
            await refresh();
            open();
          });
        }
        drawer.querySelector('[data-cart-close]')?.addEventListener('click', close);
        backdrop?.addEventListener('click', close);
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !drawer.classList.contains('invisible')) close();
        });

        document.addEventListener('submit', async (e) => {
          const form = e.target;
          if (!(form instanceof HTMLFormElement)) return;
          if ((form.getAttribute('action') || '') !== '/api/cart') return;
          if (form.hasAttribute('data-fullpage')) return;
          if (e.submitter instanceof HTMLElement && e.submitter.hasAttribute('data-fullpage'))
            return;
          if (location.pathname === '/cart') return;
          e.preventDefault();

          const errBanner = form.querySelector('[data-cart-form-error]');
          if (errBanner instanceof HTMLElement) {
            errBanner.textContent = '';
            errBanner.classList.add('hidden');
          }
          for (const inp of form.querySelectorAll('[aria-invalid="true"]')) {
            inp.removeAttribute('aria-invalid');
          }

          const res = await fetch('/api/cart', {
            method: 'POST',
            headers: { 'X-Partial': '1' },
            body: new URLSearchParams(new FormData(form)),
          });
          if (!res.ok) {
            const payload = await res.json().catch(() => null);
            const message =
              payload && typeof payload.error === 'string'
                ? payload.error
                : 'لطفاً فیلدهای الزامی محصول را تکمیل کنید.';
            if (errBanner instanceof HTMLElement) {
              errBanner.textContent = message;
              errBanner.classList.remove('hidden');
            }
            const fieldErrors = payload && payload.fieldErrors && typeof payload.fieldErrors === 'object' ? payload.fieldErrors : null;
            if (fieldErrors) {
              const firstKey = Object.keys(fieldErrors)[0];
              for (const k of Object.keys(fieldErrors)) {
                const el = form.querySelector(`[name="cf_${CSS.escape(k)}"]`);
                if (el instanceof HTMLElement) el.setAttribute('aria-invalid', 'true');
              }
              if (firstKey) {
                const firstEl = form.querySelector(`[name="cf_${CSS.escape(firstKey)}"]`);
                if (firstEl instanceof HTMLElement) firstEl.focus();
              }
            }
            return;
          }
          await refresh();
          open();
        });
      }
    </script>
  </body>
</html>

