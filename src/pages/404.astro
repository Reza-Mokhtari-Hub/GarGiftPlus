---
import Layout from '../layouts/Layout.astro';
import { catalogPath } from '../features/settings/home';

// Astro renders this for unmatched routes; set the status explicitly so SSR
// responses (and crawlers) get a real 404 rather than a 200.
Astro.response.status = 404;
// The catalog is at / until the home page is pointed elsewhere.
const shopHref = catalogPath(Astro.locals.settings?.homePage);
---

<Layout title="صفحه یافت نشد" description="صفحه‌ای که به دنبال آن هستید در فروشگاه موجود نیست.">
  <section class="reveal mx-auto max-w-xl py-16 text-center sm:py-24">
    <p class="text-xs font-semibold tracking-wider text-muted">خطای ۴۰۴</p>
    <h1 class="gg-h1 mt-3 text-ink">صفحه مورد نظر یافت نشد</h1>
    <p class="mx-auto mt-5 max-w-md text-sm leading-7 text-muted">
      صفحه‌ای که به دنبال آن هستید جابه‌جا شده، حذف گردیده یا آدرس آن به درستی وارد نشده است.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href={shopHref}
        class="rounded-xl bg-brand px-5 py-2.5 text-xs font-semibold text-on-brand transition hover:bg-brand-hover"
      >
        بازگشت به فروشگاه
      </a>
      <a
        href="/search"
        class="rounded-xl border border-line bg-surface px-5 py-2.5 text-xs font-semibold text-ink transition hover:border-brand hover:text-brand-fg"
      >
        جستجو در محصولات
      </a>
    </div>
  </section>
</Layout>
