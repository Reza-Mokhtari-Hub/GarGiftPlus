---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../../components/admin/AdminPageHeader.astro';
import CategoryForm from '../../../../features/categories/CategoryForm.astro';
import {
  getCategoryByPublicId,
  listCategories,
  buildTree,
  flattenTree,
  descendantIds,
  productCounts,
} from '../../../../features/categories/db';
import { parsePublicId } from '../../../../features/ids/publicId';
import { toPersianDigits } from '../../../../lib/format';

const publicId = parsePublicId(Astro.params.id, 'category');
const category = publicId ? await getCategoryByPublicId(env.DB, publicId) : null;

if (!category) {
  return new Response('Not found', { status: 404 });
}

const blocked = new Set(await descendantIds(env.DB, category.id));
const allFlattened = flattenTree(buildTree(await listCategories(env.DB)));
const parentOptions = allFlattened.filter((o) => !blocked.has(o.id));
const reassignOptions = allFlattened.filter((o) => o.id !== category.id);
const counts = await productCounts(env.DB);
const attachedCount = counts.get(category.id) ?? 0;
const error = Astro.url.searchParams.get('error');
---

<AdminLayout
  title={`ویرایش ${category.name}`}
  active="categories"
  requiredPermission="categories.manage"
  breadcrumbs={[
    { label: 'دسته‌بندی‌ها', href: '/admin/categories' },
    { label: category.name },
  ]}
>
  <AdminPageHeader
    title={`ویرایش دسته‌بندی: ${category.name}`}
    subtitle={`کد یکتا: ${category.public_id ?? ''} · تعداد محصولات متصل: ${toPersianDigits(attachedCount)}`}
  >
    <div slot="actions" class="flex items-center gap-2">
      <a href={`/categories/${category.slug}`} target="_blank" rel="noopener" class="gg-admin-btn-secondary text-xs">
        نمایش در فروشگاه ↗
      </a>
      <a href="/admin/categories" class="gg-admin-btn-secondary text-xs">
        ← بازگشت به لیست
      </a>
    </div>
  </AdminPageHeader>

  <div class="space-y-6">
    <CategoryForm
      action={`/api/admin/categories/${category.public_id}`}
      submitLabel="ذخیره تغییرات"
      category={category}
      parentOptions={parentOptions}
      error={error}
    />

    <section class="gg-admin-card max-w-3xl border-coral/40 p-6">
      <h2 class="text-sm font-bold text-coral">حذف دسته‌بندی با انتقال امن محصولات</h2>
      <p class="mt-1 text-xs leading-6 text-muted">
        در صورت حذف این دسته‌بندی، زیردسته‌های آن به دسته والد فعلی منتقل می‌شوند. می‌توانید پیش از حذف،
        {toPersianDigits(attachedCount)} محصول متصل به این دسته را به یک دسته دیگر منتقل کنید.
      </p>

      <form
        method="POST"
        action={`/api/admin/categories/${category.public_id}`}
        data-confirm-message={`آیا از حذف دسته‌بندی «${category.name}» اطمینان دارید؟`}
        class="mt-4 flex flex-wrap items-end gap-3"
      >
        <input type="hidden" name="_action" value="delete" />
        <div class="min-w-56 flex-1">
          <label class="mb-1 block text-xs font-semibold text-ink" for="reassign_to">
            انتقال محصولات به دسته جایگزین (اختیاری)
          </label>
          <select id="reassign_to" name="reassign_to" class="gg-admin-input">
            <option value="">بدون انتقال (فقط قطع اتصال از این دسته)</option>
            {
              reassignOptions.map((opt) => (
                <option value={opt.public_id ?? ''}>
                  {'— '.repeat(opt.depth) + opt.name}
                </option>
              ))
            }
          </select>
        </div>
        <button type="submit" class="gg-admin-btn-danger text-xs">
          حذف دسته‌بندی
        </button>
      </form>
    </section>
  </div>
</AdminLayout>
