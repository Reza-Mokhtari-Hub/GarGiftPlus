---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminEmptyState from '../../../components/admin/AdminEmptyState.astro';
import { menuReferencesFor } from '../../../features/navigation/admin';
import {
  listCategories,
  buildTree,
  flattenTree,
  productCounts,
} from '../../../features/categories/db';
import { toPersianDigits } from '../../../lib/format';

const allCats = await listCategories(env.DB);
const catById = new Map(allCats.map((c) => [c.id, c]));
const rows = flattenTree(buildTree(allCats));
const counts = await productCounts(env.DB);
const menuRefs = await menuReferencesFor(env.DB, 'category', rows.map((r) => r.id));

const saved = Astro.url.searchParams.get('saved') === '1';
const deleted = Astro.url.searchParams.get('deleted') === '1';
const error = Astro.url.searchParams.get('error');
---

<AdminLayout
  title="دسته‌بندی‌ها"
  active="categories"
  requiredPermission="categories.manage"
  breadcrumbs={[{ label: 'فروشگاه و کاتالوگ' }, { label: 'دسته‌بندی‌ها' }]}
>
  <AdminPageHeader
    title="مدیریت دسته‌بندی‌ها"
    subtitle="ساختار درختی، ترتیب نمایش، وضعیت انتشار و تنظیمات سئو دسته‌بندی‌های فروشگاه"
    badge={`${toPersianDigits(rows.length)} دسته`}
  >
    <div slot="actions" class="flex flex-wrap items-center gap-2">
      <a href="/admin/products" class="gg-admin-btn-secondary text-xs">
        محصولات
      </a>
      <a href="/admin/categories/new" class="gg-admin-btn-primary text-xs">
        + دسته‌بندی جدید
      </a>
    </div>
  </AdminPageHeader>

  {
    saved && (
      <div class="gg-status-success mb-5 rounded-xl border px-4 py-3 text-sm font-medium">
        تغییرات دسته‌بندی با موفقیت ذخیره شد و کش فروشگاه به‌روزرسانی گردید.
      </div>
    )
  }
  {
    deleted && (
      <div class="gg-status-info mb-5 rounded-xl border px-4 py-3 text-sm font-medium">
        دسته‌بندی حذف شد و ساختار زیردسته‌ها به‌صورت خودکار تنظیم گردید.
      </div>
    )
  }
  {
    error && (
      <div class="gg-status-error mb-5 rounded-xl border px-4 py-3 text-sm font-medium">
        {error}
      </div>
    )
  }

  {
    rows.length === 0 ? (
      <AdminEmptyState
        title="هنوز دسته‌بندی‌ای ثبت نشده است"
        description="برای دسته‌بندی بهتر گیفت‌کارت‌ها و اشتراک‌های دیجیتال اولین دسته‌بندی خود را بسازید."
        actionLabel="+ ایجاد اولین دسته‌بندی"
        actionHref="/admin/categories/new"
      />
    ) : (
      <div class="gg-admin-card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="gg-admin-table">
            <thead>
              <tr>
                <th>عنوان دسته‌بندی</th>
                <th>نامک (Slug)</th>
                <th>ترتیب</th>
                <th>تعداد محصول</th>
                <th>وضعیت</th>
                <th class="text-end">عملیات</th>
              </tr>
            </thead>
            <tbody>
              {
                rows.map((c) => {
                  const full = catById.get(c.id);
                  const productCount = counts.get(c.id) ?? 0;
                  const isActive = full ? full.is_active !== 0 : true;
                  const isFeatured = full ? full.is_featured !== 0 : true;
                  const confirmMsg = menuRefs.has(c.id)
                    ? `دسته «${c.name}» در منوی ناوبری فروشگاه استفاده شده است. با حذف آن، لینک منو مخفی می‌شود و زیردسته‌ها به دسته والد منتقل می‌گردند. ادامه می‌دهید؟`
                    : `آیا از حذف دسته‌بندی «${c.name}» اطمینان دارید؟ زیردسته‌های آن به والد منتقل می‌شوند.`;
                  return (
                    <tr>
                      <td>
                        <a
                          href={`/admin/categories/${c.public_id}/edit`}
                          class="inline-flex items-center gap-1.5 font-semibold text-ink hover:text-brand-fg"
                          style={`padding-inline-start: ${c.depth * 20}px`}
                        >
                          {c.depth > 0 && <span class="text-faint">↳</span>}
                          <span>{c.name}</span>
                          {isFeatured && (
                            <span class="rounded bg-brand-soft px-1.5 py-0.5 text-[10px] font-semibold text-brand-fg">
                              ویژه
                            </span>
                          )}
                        </a>
                      </td>
                      <td>
                        <span class="ltr-inline font-mono text-xs text-muted">{c.slug}</span>
                      </td>
                      <td class="text-muted">{toPersianDigits(full?.display_order ?? 0)}</td>
                      <td>
                        <span class="rounded-lg border border-line bg-paper px-2 py-0.5 text-xs font-semibold text-ink">
                          {toPersianDigits(productCount)}
                        </span>
                      </td>
                      <td>
                        <span class={`rounded-md px-2 py-0.5 text-[11px] font-semibold ${isActive ? 'gg-status-success' : 'gg-status-warning'}`}>
                          {isActive ? 'فعال' : 'غیرفعال'}
                        </span>
                      </td>
                      <td class="text-end">
                        <div class="flex flex-wrap items-center justify-end gap-3 text-xs font-semibold">
                          <a href={`/categories/${c.slug}`} target="_blank" rel="noopener" class="text-muted hover:text-brand-fg">
                            مشاهده ↗
                          </a>
                          <a href={`/admin/categories/${c.public_id}/edit`} class="text-brand-fg hover:underline">
                            ویرایش
                          </a>
                          <form
                            method="POST"
                            action={`/api/admin/categories/${c.public_id}`}
                            data-confirm-message={confirmMsg}
                          >
                            <input type="hidden" name="_action" value="delete" />
                            <button type="submit" class="text-coral hover:underline">
                              حذف
                            </button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
      </div>
    )
  }
</AdminLayout>
