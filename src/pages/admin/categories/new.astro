---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import CategoryForm from '../../../features/categories/CategoryForm.astro';
import { listCategories, buildTree, flattenTree } from '../../../features/categories/db';

const parentOptions = flattenTree(buildTree(await listCategories(env.DB)));
const error = Astro.url.searchParams.get('error');
---

<AdminLayout
  title="ایجاد دسته‌بندی جدید"
  active="categories"
  requiredPermission="categories.manage"
  breadcrumbs={[
    { label: 'دسته‌بندی‌ها', href: '/admin/categories' },
    { label: 'دسته‌بندی جدید' },
  ]}
>
  <AdminPageHeader
    title="ایجاد دسته‌بندی جدید"
    subtitle="افزودن دسته جدید به درخت کاتالوگ فروشگاه همراه با تنظیمات سئو و نمایش"
  >
    <a slot="actions" href="/admin/categories" class="gg-admin-btn-secondary text-xs">
      ← بازگشت به دسته‌بندی‌ها
    </a>
  </AdminPageHeader>

  <CategoryForm
    action="/api/admin/categories"
    submitLabel="ایجاد دسته‌بندی"
    parentOptions={parentOptions}
    error={error}
  />
</AdminLayout>
