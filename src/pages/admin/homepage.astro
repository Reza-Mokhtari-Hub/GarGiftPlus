            <input type="hidden" name="_action" value="create_faq" />
            <input type="hidden" name="_tab" value="faqs" />

            <div class="sm:col-span-2">
              <label class="mb-1 block text-xs font-bold text-ink">متن پرسش *</label>
              <input
                type="text"
                name="question"
                required
                class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
              />
            </div>

            <div class="sm:col-span-2">
              <label class="mb-1 block text-xs font-bold text-ink">متن پاسخ *</label>
              <textarea
                name="answer"
                rows={3}
                required
                class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
              />
            </div>

            <div>
              <label class="mb-1 block text-xs font-bold text-ink">دسته‌بندی موضوعی</label>
              <select
                name="category"
                class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
              >
                <option value="general">عمومی</option>
                <option value="delivery">تحویل سفارش</option>
                <option value="payment">پرداخت</option>
                <option value="security">امنیت حساب</option>
                <option value="tracking">پیگیری سفارش</option>
                <option value="wallet">کیف پول</option>
              </select>
            </div>

            <div>
              <label class="mb-1 block text-xs font-bold text-ink">ترتیب نمایش</label>
              <input
                type="number"
                name="sort_order"
                value={10}
                class="w-full rounded-lg border border-line bg-paper px-3 py-2 font-mono text-xs text-ink"
              />
            </div>

            <div class="flex items-center justify-between sm:col-span-2">
              <label class="inline-flex items-center gap-2 text-xs font-bold text-ink">
                <input
                  type="checkbox"
                  name="is_active"
                  value="1"
                  checked
                  class="h-4 w-4 rounded border-line text-brand"
                />
                <span>نمایش در صفحه اصلی</span>
              </label>

              <button
                type="submit"
                class="rounded-xl bg-brand px-5 py-2 text-xs font-bold text-on-brand hover:bg-brand-hover"
              >
                + افزودن پرسش متداول
              </button>
            </div>
          </form>
        </section>

        <section class="flex flex-col gap-4">
          <h2 class="text-base font-extrabold text-ink">پرسش‌های متداول ثبت‌شده</h2>
          {faqs.map((faq) => (
            <div class="rounded-2xl border border-line bg-surface p-5">
              <form method="POST" action="/api/admin/homepage" class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <input type="hidden" name="_action" value="update_faq" />
                <input type="hidden" name="_tab" value="faqs" />
                <input type="hidden" name="public_id" value={faq.public_id} />

                <div class="sm:col-span-2">
                  <label class="mb-1 block text-xs font-bold text-ink">پرسش</label>
                  <input
                    type="text"
                    name="question"
                    value={faq.question}
                    required
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label class="mb-1 block text-xs font-bold text-ink">پاسخ</label>
                  <textarea
                    name="answer"
                    rows={3}
                    required
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
                  >{faq.answer}</textarea>
                </div>

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">دسته‌بندی</label>
                  <select
                    name="category"
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
                  >
                    <option value="general" selected={faq.category === 'general'}>عمومی</option>
                    <option value="delivery" selected={faq.category === 'delivery'}>تحویل سفارش</option>
                    <option value="payment" selected={faq.category === 'payment'}>پرداخت</option>
                    <option value="security" selected={faq.category === 'security'}>امنیت حساب</option>
                    <option value="tracking" selected={faq.category === 'tracking'}>پیگیری سفارش</option>
                    <option value="wallet" selected={faq.category === 'wallet'}>کیف پول</option>
                  </select>
                </div>

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">ترتیب نمایش</label>
                  <input
                    type="number"
                    name="sort_order"
                    value={faq.sort_order}
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 font-mono text-xs text-ink"
                  />
                </div>

                <div class="flex items-center justify-between pt-2 sm:col-span-2">
                  <label class="inline-flex items-center gap-2 text-xs font-bold text-ink">
                    <input
                      type="checkbox"
                      name="is_active"
                      value="1"
                      checked={faq.is_active === 1}
                      class="h-4 w-4 rounded border-line text-brand"
                    />
                    <span>فعال</span>
                  </label>
                  <button
                    type="submit"
                    class="rounded-xl bg-brand px-4 py-2 text-xs font-bold text-on-brand hover:bg-brand-hover"
                  >
                    ذخیره پرسش
                  </button>
                </div>
              </form>

              <form
                method="POST"
                action="/api/admin/homepage"
                data-confirm-message="آیا از حذف این پرسش متداول مطمئن هستید؟"
                class="mt-2 flex justify-end border-t border-line pt-2"
              >
                <input type="hidden" name="_action" value="delete_faq" />
                <input type="hidden" name="_tab" value="faqs" />
                <input type="hidden" name="public_id" value={faq.public_id} />
                <button type="submit" class="text-xs font-semibold text-danger hover:underline">
                  حذف پرسش
                </button>
              </form>
            </div>
          ))}
        </section>
      </div>
    )
  }

  {
    activeTab === 'reviews' && (
      <section class="rounded-2xl border border-line bg-surface p-6">
        <h2 class="text-base font-extrabold text-ink">مدیریت و تایید دیدگاه‌های مشتریان واقعی</h2>
        <p class="mt-1 text-xs text-muted">
          گرگیفت+ هرگز دیدگاه جعلی نمایش نمی‌دهد. فقط دیدگاه‌های واقعی ثبت‌شده توسط مشتریان که توسط مدیر تایید شوند در صفحه اصلی نمایش داده می‌شوند.
        </p>

        {reviews.length === 0 ? (
          <div class="mt-6 rounded-xl border border-dashed border-line bg-paper p-8 text-center text-xs text-muted">
            هنوز دیدگاهی توسط مشتریان ثبت نشده است. در صورت عدم وجود دیدگاه تاییدشده، بخش دیدگاه‌ها در صفحه اصلی به‌صورت خودکار پنهان می‌شود.
          </div>
        ) : (
          <div class="mt-5 flex flex-col gap-3">
            {reviews.map((rev) => (
              <div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-line bg-paper p-4">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-ink">{rev.customer_name}</span>
                    <span class="gg-numeric rounded bg-amber/15 px-2 py-0.5 text-[11px] font-bold text-amber">
                      ★ {toPersianDigits(rev.rating)}
                    </span>
                    <span
                      class={`rounded px-2 py-0.5 text-[11px] font-bold ${
                        rev.is_approved === 1
                          ? 'bg-brand-soft text-brand-fg'
                          : 'bg-surface-elevated text-faint'
                      }`}
                    >
                      {rev.is_approved === 1 ? 'تاییدشده' : 'در انتظار بررسی'}
                    </span>
                  </div>
                  <p class="mt-2 text-xs text-muted">{rev.comment}</p>
                </div>

                <div class="flex items-center gap-2">
                  <form method="POST" action="/api/admin/homepage">
                    <input type="hidden" name="_action" value="moderate_review" />
                    <input type="hidden" name="_tab" value="reviews" />
                    <input type="hidden" name="public_id" value={rev.public_id} />
                    <input
                      type="hidden"
                      name="operation"
                      value={rev.is_approved === 1 ? 'unapprove' : 'approve'}
                    />
                    <button
                      type="submit"
                      class="rounded-lg bg-brand px-3 py-1.5 text-xs font-bold text-on-brand"
                    >
                      {rev.is_approved === 1 ? 'لغو انتشار' : 'تایید و انتشار'}
                    </button>
                  </form>

                  <form
                    method="POST"
                    action="/api/admin/homepage"
                    data-confirm-message={`دیدگاه «${rev.customer_name}» حذف شود؟`}
                  >
                    <input type="hidden" name="_action" value="moderate_review" />
                    <input type="hidden" name="_tab" value="reviews" />
                    <input type="hidden" name="public_id" value={rev.public_id} />
                    <input type="hidden" name="operation" value="delete" />
                    <button
                      type="submit"
                      class="rounded-lg border border-line px-3 py-1.5 text-xs font-semibold text-danger"
                    >
                      حذف
                    </button>
                  </form>
                </div>
              </div>
            ))}
          </div>
        )}
      </section>
    )
  }

  {
    activeTab === 'footer' && (
      <section class="rounded-2xl border border-line bg-surface p-6">
        <h2 class="text-base font-extrabold text-ink">تنظیمات فوتر، اطلاعات تماس و پشتیبانی</h2>
        <form method="POST" action="/api/admin/homepage" class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <input type="hidden" name="_action" value="update_footer" />
          <input type="hidden" name="_tab" value="footer" />

          <div class="sm:col-span-2">
            <label class="mb-1 block text-xs font-bold text-ink">توضیحات معرفی برند در فوتر</label>
            <textarea
              name="description"
              rows={3}
              class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
            >{footerConfig.description}</textarea>
          </div>

          <div class="sm:col-span-2">
            <label class="mb-1 block text-xs font-bold text-ink">یادداشت شفافیت تحویل و اعتماد</label>
            <textarea
              name="trustNote"
              rows={2}
              class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
            >{footerConfig.trustNote}</textarea>
          </div>

          <div>
            <label class="mb-1 block text-xs font-bold text-ink">ساعات پاسخگویی پشتیبانی</label>
            <input
              type="text"
              name="supportHours"
              value={footerConfig.supportHours}
              class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
            />
          </div>

          <div>
            <label class="mb-1 block text-xs font-bold text-ink">تلفن پشتیبانی</label>
            <input
              type="text"
              name="supportPhone"
              value={footerConfig.supportPhone}
              class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
            />
          </div>

          <div>
            <label class="mb-1 block text-xs font-bold text-ink">ایمیل پشتیبانی</label>
            <input
              type="text"
              name="supportEmail"
              dir="ltr"
              value={footerConfig.supportEmail}
              class="w-full rounded-lg border border-line bg-paper px-3 py-2 font-mono text-xs text-ink"
            />
          </div>

          <div>
            <label class="mb-1 block text-xs font-bold text-ink">متن کپی‌رایت</label>
            <input
              type="text"
              name="copyrightText"
              value={footerConfig.copyrightText}
              class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
            />
          </div>

          <div class="flex justify-end pt-2 sm:col-span-2">
            <button
              type="submit"
              class="rounded-xl bg-brand px-6 py-2.5 text-xs font-bold text-on-brand transition-colors hover:bg-brand-hover"
            >
              ذخیره اطلاعات فوتر
            </button>
          </div>
        </form>
      </section>
    )
