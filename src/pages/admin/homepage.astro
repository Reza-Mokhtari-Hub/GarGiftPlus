            <div class="flex items-center justify-between pt-2 sm:col-span-2">
              <label class="inline-flex items-center gap-2 text-xs font-bold text-ink">
                <input
                  type="checkbox"
                  name="is_active"
                  value="1"
                  checked
                  class="h-4 w-4 rounded border-line text-brand"
                />
                <span>بنر بلافاصله فعال باشد</span>
              </label>

              <button
                type="submit"
                class="rounded-xl bg-brand px-5 py-2.5 text-xs font-bold text-on-brand transition-colors hover:bg-brand-hover"
              >
                + ایجاد بنر تبلیغاتی
              </button>
            </div>
          </form>

          {recentMedia.length > 0 && (
            <div class="mt-6 border-t border-line pt-4">
              <p class="mb-2 text-xs font-bold text-muted">
                کلید تصاویر اخیر در کتابخانه رسانه (برای کپی سریع):
              </p>
              <div class="flex flex-wrap gap-2">
                {recentMedia.slice(0, 8).map((m) => (
                  <div class="flex items-center gap-2 rounded-lg border border-line bg-paper px-2.5 py-1 text-[11px]">
                    <img
                      src={mediaUrl(m.image_key, imageBaseUrl)}
                      alt={m.original_name}
                      class="h-6 w-6 rounded object-cover"
                    />
                    <code dir="ltr" class="font-mono text-ink">{m.image_key}</code>
                  </div>
                ))}
              </div>
            </div>
          )}
        </section>

        <!-- فهرست بنرهای موجود -->
        <section class="flex flex-col gap-4">
          <h2 class="text-base font-extrabold text-ink">بنرهای ثبت‌شده ({toPersianDigits(banners.length)})</h2>
          {banners.map((b) => (
            <div class="rounded-2xl border border-line bg-surface p-5">
              <form
                method="POST"
                action="/api/admin/homepage"
                enctype="multipart/form-data"
                class="grid grid-cols-1 gap-4 sm:grid-cols-2"
              >
                <input type="hidden" name="_action" value="update_banner" />
                <input type="hidden" name="_tab" value="banners" />
                <input type="hidden" name="public_id" value={b.public_id} />

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">عنوان بنر *</label>
                  <input
                    type="text"
                    name="title"
                    value={b.title}
                    required
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">زیرعنوان</label>
                  <input
                    type="text"
                    name="subtitle"
                    value={b.subtitle ?? ''}
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label class="mb-1 block text-xs font-bold text-ink">توضیحات</label>
                  <textarea
                    name="description"
                    rows={2}
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
                  >{b.description ?? ''}</textarea>
                </div>

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">نشان (Badge)</label>
                  <input
                    type="text"
                    name="badge_text"
                    value={b.badge_text ?? ''}
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">تم رنگی</label>
                  <select
                    name="accent_theme"
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
                  >
                    <option value="violet" selected={b.accent_theme === 'violet'}>بنفش الکتریک (Violet)</option>
                    <option value="turquoise" selected={b.accent_theme === 'turquoise'}>فیروزه‌ای (Turquoise)</option>
                    <option value="coral" selected={b.accent_theme === 'coral'}>مرجانی (Coral Pink)</option>
                    <option value="amber" selected={b.accent_theme === 'amber'}>کهربایی (Warm Amber)</option>
                    <option value="navy" selected={b.accent_theme === 'navy'}>سرمه‌ای تیره (Deep Navy)</option>
                  </select>
                </div>

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">متن دکمه</label>
                  <input
                    type="text"
                    name="cta_text"
                    value={b.cta_text ?? ''}
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">لینک مقصد *</label>
                  <input
                    type="text"
                    name="cta_href"
                    dir="ltr"
                    value={b.cta_href}
                    required
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 font-mono text-xs text-ink"
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">کلید یا فایل تصویر دسکتاپ</label>
                  <input
                    type="file"
                    name="desktop_image_file"
                    accept="image/jpeg,image/png,image/webp,image/gif"
                    class="mb-1.5 block w-full text-xs text-muted"
                  />
                  <input
                    type="text"
                    name="desktop_image_key"
                    dir="ltr"
                    value={b.desktop_image_key ?? ''}
                    class="w-full rounded-lg border border-line bg-paper px-3 py-1.5 font-mono text-xs text-ink"
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">کلید یا فایل تصویر موبایل</label>
                  <input
                    type="file"
                    name="mobile_image_file"
                    accept="image/jpeg,image/png,image/webp,image/gif"
                    class="mb-1.5 block w-full text-xs text-muted"
                  />
                  <input
                    type="text"
                    name="mobile_image_key"
                    dir="ltr"
                    value={b.mobile_image_key ?? ''}
                    class="w-full rounded-lg border border-line bg-paper px-3 py-1.5 font-mono text-xs text-ink"
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">زمان شروع (ISO)</label>
                  <input
                    type="text"
                    name="start_at"
                    dir="ltr"
                    value={b.start_at ?? ''}
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 font-mono text-xs text-ink"
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">زمان پایان (ISO)</label>
                  <input
                    type="text"
                    name="end_at"
                    dir="ltr"
                    value={b.end_at ?? ''}
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 font-mono text-xs text-ink"
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">متن جایگزین (Alt Text)</label>
                  <input
                    type="text"
                    name="alt_text"
                    value={b.alt_text}
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 text-xs text-ink"
                  />
                </div>

                <div>
                  <label class="mb-1 block text-xs font-bold text-ink">ترتیب نمایش</label>
                  <input
                    type="number"
                    name="sort_order"
                    value={b.sort_order}
                    class="w-full rounded-lg border border-line bg-paper px-3 py-2 font-mono text-xs text-ink"
                  />
                </div>

                <div class="flex flex-wrap items-center justify-between gap-3 pt-2 sm:col-span-2">
                  <label class="inline-flex items-center gap-2 text-xs font-bold text-ink">
                    <input
                      type="checkbox"
                      name="is_active"
                      value="1"
                      checked={b.is_active === 1}
                      class="h-4 w-4 rounded border-line text-brand"
                    />
                    <span>بنر فعال باشد</span>
                  </label>

                  <button
                    type="submit"
                    class="rounded-xl bg-brand px-4 py-2 text-xs font-bold text-on-brand transition-colors hover:bg-brand-hover"
                  >
                    ذخیره تغییرات بنر
                  </button>
                </div>
              </form>

              <form
                method="POST"
                action="/api/admin/homepage"
                data-confirm-message={`آیا از حذف بنر «${b.title}» مطمئن هستید؟`}
                class="mt-3 flex justify-end border-t border-line pt-3"
              >
                <input type="hidden" name="_action" value="delete_banner" />
                <input type="hidden" name="_tab" value="banners" />
                <input type="hidden" name="public_id" value={b.public_id} />
                <button
                  type="submit"
                  class="rounded-lg border border-line px-3 py-1.5 text-xs font-semibold text-danger hover:bg-danger/10"
                >
                  حذف این بنر
                </button>
              </form>
            </div>
          ))}
        </section>
      </div>
    )
  }

  {
    activeTab === 'faqs' && (
