---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { verifyConfiguredTurnstile, TURNSTILE_FIELD } from '../../features/auth/turnstile';
import { signSession, verifySession } from '../../features/auth/session';
import { adminCredential } from '../../features/auth/admin';
import {
  ADMIN_ACTOR_COOKIE,
  findAdminUserByIdentifier,
  signAdminActorCookie,
  touchAdminUserLogin,
  verifyAdminActorCookie,
  verifyAdminUserPassword,
} from '../../features/auth/rbac';
import { recordAdminAuditLog } from '../../features/audit/db';
import { getSecret } from '../../features/secrets/store';
import Turnstile from '../../features/auth/Turnstile.astro';

const cred = await adminCredential(env.DB);
if (!cred.enabled && !import.meta.env.DEV) {
  return Astro.redirect('/admin/setup', 303);
}

const signingKey = env.AUTH_SECRET || cred.tagSource || 'dev-fallback';
const now = Date.now() / 1000;

const existingActor = await verifyAdminActorCookie(
  env.DB,
  Astro.cookies.get(ADMIN_ACTOR_COOKIE)?.value ?? null,
  signingKey,
  now,
);
const existingPrimary =
  cred.enabled &&
  (await verifySession(
    Astro.cookies.get('admin_session')?.value ?? null,
    signingKey,
    cred.tagSource,
    now,
  ));

if (existingActor || existingPrimary) {
  return Astro.redirect('/admin', 303);
}

const ttlHours = Astro.locals.settings?.adminSessionTtlHours ?? 168;
const SESSION_TTL = Math.max(3600, ttlHours * 3600);
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const identifier = form.get('identifier')?.toString().trim() ?? '';
  const password = form.get('password')?.toString() ?? '';

  const turnstileEnabled = Astro.locals.settings?.turnstileEnabled === true;
  const tsSecret = turnstileEnabled
    ? await getSecret(env.DB, 'turnstile_secret_key')
    : null;
  const tsOk = await verifyConfiguredTurnstile(
    turnstileEnabled,
    form.get(TURNSTILE_FIELD)?.toString(),
    tsSecret,
    Astro.request.headers.get('CF-Connecting-IP'),
  );

  if (!tsOk) {
    error = 'تاییدیه امنیتی معتبر نیست — لطفاً دوباره تلاش کنید.';
  } else if (identifier) {
    const adminUser = await findAdminUserByIdentifier(env.DB, identifier);
    if (!adminUser || adminUser.is_active !== 1 || !(await verifyAdminUserPassword(adminUser, password))) {
      error = 'نام کاربری/ایمیل یا گذرواژه نادرست است یا حساب غیرفعال شده است.';
    } else {
      const actorToken = await signAdminActorCookie(signingKey, adminUser, SESSION_TTL, now);
      Astro.cookies.delete('admin_session', { path: '/' });
      Astro.cookies.set(ADMIN_ACTOR_COOKIE, actorToken, {
        httpOnly: true,
        secure: Astro.url.protocol === 'https:',
        sameSite: 'lax',
        path: '/',
        maxAge: SESSION_TTL,
      });
      await touchAdminUserLogin(env.DB, adminUser.public_id);
      await recordAdminAuditLog(env.DB, {
        action: 'admin.login',
        module: 'auth',
        targetType: 'admin_user',
        targetId: adminUser.public_id,
        actor: adminUser.email,
        details: { role: adminUser.role },
      });
      return Astro.redirect('/admin', 303);
    }
  } else {
    const pwOk = cred.enabled ? await cred.verify(password) : false;
    if (!pwOk) {
      error = 'گذرواژه واردشده نادرست است.';
    } else {
      const token = await signSession(signingKey, cred.tagSource, SESSION_TTL, now);
      Astro.cookies.delete(ADMIN_ACTOR_COOKIE, { path: '/' });
      Astro.cookies.set('admin_session', token, {
        httpOnly: true,
        secure: Astro.url.protocol === 'https:',
        sameSite: 'lax',
        path: '/',
        maxAge: SESSION_TTL,
      });
      await recordAdminAuditLog(env.DB, {
        action: 'admin.login',
        module: 'auth',
        targetType: 'admin_session',
        targetId: 'primary_owner',
        actor: 'admin',
      });
      return Astro.redirect('/admin', 303);
    }
  }
}
---

<Layout title="ورود به پنل مدیریت">
  <div class="mx-auto max-w-md py-12">
    <div class="rounded-2xl border border-line bg-surface/80 p-6 shadow-sm sm:p-8">
      <div class="mb-6 flex items-center gap-3">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand text-base font-extrabold text-on-brand">
          G+
        </span>
        <div>
          <h1 class="text-xl font-bold text-ink">ورود به پنل مدیریت GarGift+</h1>
          <p class="text-xs text-muted">ورود با حساب اپراتور یا گذرواژه مدیر سیستم</p>
        </div>
      </div>

      {
        error && (
          <p class="mb-4 rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-2.5 text-sm text-rose-700 dark:text-rose-200">
            {error}
          </p>
        )
      }

      <form method="POST" action="/admin/login" class="space-y-4">
        <label class="block text-sm">
          <span class="mb-1.5 block font-medium text-ink">
            ایمیل یا نام کاربری اپراتور
            <span class="text-xs font-normal text-muted">(برای مدیر اصلی خالی بگذارید)</span>
          </span>
          <input
            type="text"
            name="identifier"
            dir="ltr"
            autocomplete="username"
            placeholder="operator@gargift.ir"
            class="w-full rounded-xl border border-line bg-paper px-3.5 py-2.5 text-sm text-ink"
          />
        </label>

        <label class="block text-sm">
          <span class="mb-1.5 block font-medium text-ink">گذرواژه</span>
          <input
            type="password"
            name="password"
            required
            autofocus
            autocomplete="current-password"
            class="w-full rounded-xl border border-line bg-paper px-3.5 py-2.5 text-sm text-ink"
          />
        </label>

        <div class="flex justify-center">
          <Turnstile />
        </div>

        <button
          type="submit"
          class="w-full rounded-xl bg-brand px-4 py-2.5 text-sm font-semibold text-on-brand transition hover:bg-brand-hover"
        >
          ورود به داشبورد
        </button>
      </form>
    </div>
  </div>
</Layout>
