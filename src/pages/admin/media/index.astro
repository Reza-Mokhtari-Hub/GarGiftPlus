---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminEmptyState from '../../../components/admin/AdminEmptyState.astro';
import Pagination from '../../../components/Pagination.astro';
import { MEDIA_PAGE_SIZE, countMediaFiltered } from '../../../features/media/db';
import { isUnused, usageLinks } from '../../../features/media/usage';
import { mediaUrl } from '../../../features/media/url';
import { loadMediaPage } from '../../api/admin/media';
import { paginate, queryHref } from '../../../pagination';
import { formatJalaliDate, toPersianDigits } from '../../../lib/format';
import { resolveAdminActor } from '../../../features/fulfillment/actor';
import { hasAdminPermission } from '../../../features/fulfillment/permissions';

const actor = await resolveAdminActor(env.DB, Astro);
const canManage = hasAdminPermission(actor, 'media.manage');

const error = Astro.url.searchParams.get('error');
const uploaded = Astro.url.searchParams.get('uploaded') === '1';
const deleted = Astro.url.searchParams.get('deleted') === '1';
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const unusedOnly = Astro.url.searchParams.get('unused') === '1';

const total = await countMediaFiltered(env.DB, { q, unusedOnly });
const { page, offset, totalPages } = paginate(Astro.url.searchParams, total, MEDIA_PAGE_SIZE);
const { items, usage, baseUrl } = await loadMediaPage(MEDIA_PAGE_SIZE, offset, { q, unusedOnly });
const hrefFor = (p: number) =>
  queryHref('/admin/media', {
    q: q || undefined,
    unused: unusedOnly ? '1' : undefined,
    page: p > 1 ? p : undefined,
  });

function formatSize(bytes: number | null): string | null {
  if (bytes == null) return null;
  if (bytes < 1024) return `${toPersianDigits(bytes)} بایت`;
  if (bytes < 1024 * 1024) return `${toPersianDigits(Math.round(bytes / 1024))} کیلوبایت`;
  return `${toPersianDigits((bytes / (1024 * 1024)).toFixed(1))} مگابایت`;
}
---

<AdminLayout
  title="کتابخانه رسانه"
  active="media"
  requiredPermission="media.manage"
  breadcrumbs={[{ label: 'فروشگاه و کاتالوگ' }, { label: 'کتابخانه رسانه' }]}
>
  <AdminPageHeader
    title="کتابخانه رسانه (Media & R2)"
    subtitle="مدیریت متمرکز تصاویر محصولات، دسته‌بندی‌ها، بنرهای صفحه اصلی و لوگو فروشگاه"
    badge={`${toPersianDigits(total)} فایل`}
  />

  {
    error && (
      <div class="gg-status-error mb-5 rounded-xl border px-4 py-3 text-sm font-medium">
        {error}
      </div>
    )
  }
  {
    uploaded && (
      <div class="gg-status-success mb-5 rounded-xl border px-4 py-3 text-sm font-medium">
        تصاویر با موفقیت در R2 ذخیره و به کتابخانه رسانه اضافه شدند.
      </div>
    )
  }
  {
    deleted && (
      <div class="gg-status-info mb-5 rounded-xl border px-4 py-3 text-sm font-medium">
        فایل رسانه از دیتابیس و فضای ذخیره‌سازی R2 حذف شد.
      </div>
    )
  }

  <div class="mb-6 grid gap-4 lg:grid-cols-12">
    {
      canManage && (
        <form
          method="post"
          action="/api/admin/media"
          enctype="multipart/form-data"
          class="gg-admin-card flex flex-wrap items-center gap-3 p-4 lg:col-span-7"
        >
          <input
            type="file"
            name="files"
            accept="image/jpeg,image/png,image/webp,image/gif"
            multiple
            required
            class="block w-full text-xs text-muted file:me-3 file:cursor-pointer file:rounded-xl file:border-0 file:bg-brand file:px-4 file:py-2 file:text-xs file:font-bold file:text-on-brand hover:file:bg-brand-hover sm:w-auto"
          />
          <button type="submit" class="gg-admin-btn-primary text-xs">
            آپلود تصویر جدید
          </button>
          <span class="text-[11px] text-faint">فرمت‌های مجاز: JPEG، PNG، WebP، GIF (حداکثر ۵ مگابایت)</span>
        </form>
      )
    }

    <form
      method="GET"
      action="/admin/media"
      class={`gg-admin-card flex flex-wrap items-center gap-3 p-4 ${canManage ? 'lg:col-span-5' : 'lg:col-span-12'}`}
    >
      <input
        type="search"
        name="q"
        value={q}
        placeholder="جستجوی نام فایل یا کلید R2..."
        class="gg-admin-input flex-1 py-2 text-xs"
      />
      <label class="inline-flex cursor-pointer items-center gap-2 text-xs font-medium text-ink">
        <input type="checkbox" name="unused" value="1" checked={unusedOnly} class="size-4 accent-brand" />
        فقط بدون استفاده
      </label>
      <button type="submit" class="gg-admin-btn-secondary py-2 text-xs">
        فیلتر
      </button>
      {(q || unusedOnly) && (
        <a href="/admin/media" class="text-xs text-muted hover:text-coral">پاک کردن</a>
      )}
    </form>
  </div>

  {
    items.length === 0 ? (
      <AdminEmptyState
        title="فایلی با این مشخصات یافت نشد"
        description="می‌توانید تصویر جدیدی از فرم بالا آپلود کنید یا فیلتر جستجو را تغییر دهید."
      />
    ) : (
      <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
        {
          items.map((m) => {
            const entry = usage.get(m.id);
            const unused = !!entry && isUnused(entry);
            const size = formatSize(m.size_bytes);
            const dimensions = m.width && m.height ? `${toPersianDigits(m.width)} × ${toPersianDigits(m.height)}` : null;
            const url = mediaUrl(m.image_key, baseUrl);
            const links = unused ? [] : usageLinks(entry!);
            return (
              <li class="gg-admin-card flex flex-col gap-2.5 p-3">
                <button
                  type="button"
                  data-media-preview={url}
                  data-media-title={m.original_name}
                  data-media-key={m.image_key}
                  class="group relative aspect-square overflow-hidden rounded-xl border border-line bg-paper"
                >
                  <img
                    src={url}
                    alt={m.original_name}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain transition duration-200 group-hover:scale-105"
                  />
                </button>

                <p class="truncate text-xs font-bold text-ink" title={m.original_name}>
                  {m.original_name}
                </p>

                <p class="text-[11px] text-faint">
                  {formatJalaliDate(m.created_at)}
                  {dimensions ? ` · ${dimensions}` : ''}
                  {size ? ` · ${size}` : ''}
                </p>

                <div class="text-[11px]">
                  {unused ? (
                    <span class="gg-status-warning inline-block rounded-md px-2 py-0.5 font-semibold">
                      بدون استفاده (قابل حذف)
                    </span>
                  ) : (
                    <div class="space-y-1">
                      <span class="gg-status-success inline-block rounded-md px-2 py-0.5 font-semibold">
                        در حال استفاده
                      </span>
                      <p class="truncate text-muted">
                        {links.map((link, index) => (
                          <Fragment>
                            {index > 0 && '، '}
                            <a href={link.href} title={link.title} class="underline hover:text-brand-fg">
                              {link.label}
                            </a>
                          </Fragment>
                        ))}
                      </p>
                    </div>
                  )}
                </div>

                <div class="mt-auto flex flex-wrap items-center justify-between gap-2 border-t border-line pt-2 text-[11px]">
                  <button
                    type="button"
                    data-copy-url={url}
                    class="font-semibold text-brand-fg hover:underline"
                  >
                    کپی لینک
                  </button>
                  {unused && canManage && m.public_id && (
                    <form
                      method="post"
                      action={`/api/admin/media/${m.public_id}`}
                      data-confirm-message={`فایل «${m.original_name}» برای همیشه از R2 و کتابخانه رسانه حذف شود؟`}
                    >
                      <input type="hidden" name="_action" value="delete" />
                      <button type="submit" class="font-semibold text-coral hover:underline">
                        حذف فایل
                      </button>
                    </form>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    )
  }

  <div class="mt-6">
    <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
  </div>

  {/* مودال پیش‌نمایش تصویر */}
  <dialog
    id="gg-media-preview-modal"
    class="m-auto w-[min(92vw,36rem)] rounded-2xl border border-line bg-surface p-0 text-ink shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-xs"
  >
    <div class="flex items-center justify-between border-b border-line px-5 py-3">
      <p id="gg-media-preview-title" class="truncate text-sm font-bold text-ink" />
      <button
        type="button"
        id="gg-media-preview-close"
        aria-label="بستن پیش‌نمایش"
        class="rounded-lg border border-line px-2.5 py-1 text-xs text-muted hover:text-ink"
      >
        بستن
      </button>
    </div>
    <div class="p-5">
      <div class="mb-3 flex max-h-96 items-center justify-center overflow-hidden rounded-xl border border-line bg-paper p-2">
        <img id="gg-media-preview-img" src="" alt="" class="max-h-88 w-auto object-contain" />
      </div>
      <p class="text-[11px] text-muted">
        کلید فایل در R2: <code id="gg-media-preview-key" class="ltr-inline font-mono text-ink" />
      </p>
    </div>
  </dialog>
</AdminLayout>

<script is:inline>
  (() => {
    document.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const copyBtn = target.closest('[data-copy-url]');
      if (copyBtn instanceof HTMLElement) {
        const rawUrl = copyBtn.getAttribute('data-copy-url');
        if (!rawUrl) return;
        const fullUrl = new URL(rawUrl, location.origin).href;
        try {
          await navigator.clipboard.writeText(fullUrl);
          const original = copyBtn.textContent;
          copyBtn.textContent = 'کپی شد ✓';
          setTimeout(() => {
            copyBtn.textContent = original;
          }, 1200);
        } catch {}
        return;
      }

      const previewBtn = target.closest('[data-media-preview]');
      if (previewBtn instanceof HTMLElement) {
        const dialog = document.getElementById('gg-media-preview-modal');
        const img = document.getElementById('gg-media-preview-img');
        const titleEl = document.getElementById('gg-media-preview-title');
        const keyEl = document.getElementById('gg-media-preview-key');
        if (dialog instanceof HTMLDialogElement && img instanceof HTMLImageElement) {
          img.src = previewBtn.getAttribute('data-media-preview') || '';
          img.alt = previewBtn.getAttribute('data-media-title') || '';
          if (titleEl) titleEl.textContent = previewBtn.getAttribute('data-media-title') || '';
          if (keyEl) keyEl.textContent = previewBtn.getAttribute('data-media-key') || '';
          dialog.showModal();
        }
      }
    });

    const dialog = document.getElementById('gg-media-preview-modal');
    const closeBtn = document.getElementById('gg-media-preview-close');
    closeBtn?.addEventListener('click', () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
    });
  })();
</script>
