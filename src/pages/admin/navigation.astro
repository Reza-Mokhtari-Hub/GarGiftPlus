---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import {
  getMenus,
  MENU_CAPS,
  MAX_MENU_LABEL,
  isMenuTargetType,
  type MenuLocation,
  type MenuTargetType,
} from '../../features/navigation/db';
import {
  targetChoices,
  unavailableReason,
  PICKER_LIMIT,
} from '../../features/navigation/admin';
import { toPersianDigits } from '../../lib/format';

const TYPE_FA_LABELS: Record<MenuTargetType, string> = {
  home: 'صفحه اصلی',
  catalog: 'کاتالوگ محصولات',
  page: 'صفحه محتوایی',
  product: 'محصول',
  category: 'دسته‌بندی',
};

const url = Astro.url;
const error = url.searchParams.get('error');
const saved = url.searchParams.get('saved');

const rawType = url.searchParams.get('target_type');
const pickerType: MenuTargetType = isMenuTargetType(rawType) ? rawType : 'page';
const pickerLocation: MenuLocation = url.searchParams.get('location') === 'footer' ? 'footer' : 'header';
const pickerQuery = url.searchParams.get('q') ?? '';

const homePage = Astro.locals.settings?.homePage ?? null;
const menus = await getMenus(env.DB, homePage);

const OBJECT_TYPES = ['page', 'product', 'category'] as const satisfies readonly MenuTargetType[];
const choiceList = await Promise.all(
  OBJECT_TYPES.map((t) => targetChoices(env.DB, t, t === pickerType ? pickerQuery : '')),
);
const choices = Object.fromEntries(
  OBJECT_TYPES.map((t, i) => [t, choiceList[i]]),
) as Record<(typeof OBJECT_TYPES)[number], (typeof choiceList)[number]>;
const truncated = OBJECT_TYPES.filter((t) => choices[t].remaining > 0);

const isSingletonType = pickerType === 'home' || pickerType === 'catalog';
const searchAllNeeded = !isSingletonType && choices[pickerType].remaining > 0;
const nothingToAdd = !isSingletonType && choices[pickerType].options.length === 0;

const initialDefaultLabel = isSingletonType
  ? TYPE_FA_LABELS[pickerType]
  : (choices[pickerType].options[0]?.name ?? '');

const bothRootLinks = (loc: MenuLocation) =>
  !homePage &&
  menus[loc].some((i) => i.targetType === 'home') &&
  menus[loc].some((i) => i.targetType === 'catalog');

const locations: { key: MenuLocation; title: string; note: string }[] = [
  {
    key: 'header',
    title: 'منوی سربرگ (Header)',
    note: `حداکثر ${toPersianDigits(MENU_CAPS.header)} آیتم — لوگوی فروشگاه، جستجو و سبد خرید نیز در سربرگ قرار دارند.`,
  },
  {
    key: 'footer',
    title: 'منوی پاورقی (Footer)',
    note: `حداکثر ${toPersianDigits(MENU_CAPS.footer)} آیتم قابل افزودن به ستون لینک‌های پاورقی.`,
  },
];
---

<AdminLayout
  title="منوها و ناوبری"
  active="navigation"
  requiredPermission="content.manage"
  breadcrumbs={[{ label: 'محتوا و فروشگاه' }, { label: 'منوها و ناوبری' }]}
>
  <AdminPageHeader
    title="مدیریت منوهای ناوبری (سربرگ و پاورقی)"
    subtitle="انتخاب، نام‌گذاری و مرتب‌سازی لینک‌های نمایش‌داده‌شده در هدر و فوتر فروشگاه"
  />

  {error && <div class="gg-status-error mb-6 rounded-xl px-4 py-3 text-sm">{error}</div>}
  {saved && !error && (
    <div class="gg-status-success mb-6 rounded-xl px-4 py-3 text-sm">
      ساختار منوها با موفقیت به‌روزرسانی شد.
    </div>
  )}

  <section class="gg-admin-card mb-8 p-5">
    <h2 class="mb-4 text-base font-bold text-ink">افزودن آیتم جدید به منو</h2>

    <form method="POST" action="/api/admin/navigation" data-add-item class="flex flex-col gap-4">
      <div class="flex min-h-[3.65rem] flex-wrap items-end gap-3">
        <label class="text-xs font-semibold text-muted">
          نوع مقصد
          <select name="target_type" class="gg-admin-input mt-1 block py-2 text-xs">
            {
              (Object.keys(TYPE_FA_LABELS) as MenuTargetType[]).map((t) => (
                <option value={t} selected={t === pickerType}>
                  {TYPE_FA_LABELS[t]}
                </option>
              ))
            }
          </select>
        </label>

        <div data-target-search class="flex-col text-xs font-semibold text-muted">
          <label for="nav-target-search">جستجوی سریع</label>
          <div class="mt-1 flex gap-2">
            <input
              id="nav-target-search"
              type="search"
              name="q"
              value={pickerQuery}
              placeholder="فیلتر بر اساس نام..."
              class="gg-admin-input block w-44 py-2 text-xs"
            />
            <button
              type="submit"
              formmethod="get"
              formaction="/admin/navigation"
              hidden={!searchAllNeeded}
              class="gg-admin-btn-secondary py-2 text-xs"
            >
              جستجوی کل
            </button>
          </div>
        </div>

        {
          OBJECT_TYPES.map((t) => (
            <label
              data-target-picker={t}
              data-truncated={choices[t].remaining > 0 ? '1' : '0'}
              class="flex-col text-xs font-semibold text-muted"
            >
              انتخاب {TYPE_FA_LABELS[t]}
              <select
                name={`target_id_${t}`}
                class="gg-admin-input mt-1 block w-56 py-2 text-xs"
              >
                {choices[t].options.length === 0 && (
                  <option value="">
                    {pickerQuery ? 'موردی یافت نشد' : 'موردی موجود نیست'}
                  </option>
                )}
                {choices[t].options.map((o) => (
                  <option value={o.public_id}>{o.name}</option>
                ))}
              </select>
            </label>
          ))
        }
      </div>

      <div class="flex flex-wrap items-end gap-3">
        <label class="text-xs font-semibold text-muted">
          عنوان نمایشی در منو (اختیاری)
          <input
            type="text"
            name="label"
            maxlength={MAX_MENU_LABEL}
            data-label-input
            placeholder={
              initialDefaultLabel ? `پیش‌فرض: «${initialDefaultLabel}»` : 'عنوان لینک'
            }
            class="gg-admin-input mt-1 block py-2 text-xs"
          />
        </label>

        <label class="text-xs font-semibold text-muted">
          محل نمایش
          <select name="location" class="gg-admin-input mt-1 block py-2 text-xs">
            <option value="header" selected={pickerLocation === 'header'}>سربرگ (Header)</option>
            <option value="footer" selected={pickerLocation === 'footer'}>پاورقی (Footer)</option>
          </select>
        </label>

        <button
          type="submit"
          name="_action"
          value="add"
          data-add-button
          disabled={nothingToAdd}
          class="gg-admin-btn-primary py-2 text-xs disabled:cursor-not-allowed disabled:opacity-40"
        >
          + افزودن به منو
        </button>
      </div>
    </form>

    {
      truncated.length > 0 && (
        <p class="mt-3 text-xs text-muted">
          {truncated
            .map((t) => `${TYPE_FA_LABELS[t]}: نمایش ${toPersianDigits(PICKER_LIMIT)} از ${toPersianDigits(choices[t].options.length + choices[t].remaining)}`)
            .join(' · ')}
          . برای یافتن موارد بیشتر نام را تایپ کرده و «جستجوی کل» را بزنید.
        </p>
      )
    }
  </section>

  <div class="grid gap-6 lg:grid-cols-2">
    {
      locations.map((loc) => (
        <section class="gg-admin-card min-w-0 p-5">
          <div class="mb-1 flex items-baseline justify-between">
            <h2 class="text-base font-bold text-ink">{loc.title}</h2>
            <span class="text-xs font-semibold text-muted">
              {toPersianDigits(menus[loc.key].length)} / {toPersianDigits(MENU_CAPS[loc.key])}
            </span>
          </div>
          <p class="mb-4 text-xs text-muted">{loc.note}</p>

          {bothRootLinks(loc.key) && (
            <p class="gg-status-warning mb-4 rounded-xl px-3 py-2 text-xs">
              صفحه اصلی و کاتالوگ در حال حاضر هر دو به <code>/</code> اشاره می‌کنند.
            </p>
          )}

          {menus[loc.key].length === 0 ? (
            <p class="rounded-xl border border-dashed border-line py-8 text-center text-xs text-muted">
              هنوز آیتمی در این منو ثبت نشده است.
            </p>
          ) : (
            <ul data-menu-list={loc.key} class="divide-y divide-line border-y border-line">
              {menus[loc.key].map((item, index) => {
                const reason = unavailableReason(item);
                return (
                  <li data-menu-item={item.publicId} class="flex min-w-0 items-start gap-3 py-3">
                    <span
                      data-handle
                      aria-hidden="true"
                      class="mt-1 hidden shrink-0 cursor-grab text-faint hover:text-muted sm:block"
                    >
                      ⋮⋮
                    </span>
                    <div class="min-w-0 flex-1">
                      <div class="flex min-w-0 flex-wrap items-center gap-2">
                        <span class="truncate text-sm font-semibold text-ink">
                          {item.text || 'بدون عنوان'}
                        </span>
                        <span class="rounded bg-surface-2 px-1.5 py-0.5 text-[10px] font-semibold text-muted">
                          {TYPE_FA_LABELS[item.targetType] ?? item.targetType}
                        </span>
                      </div>
                      {reason ? (
                        <p class="mt-1 text-xs text-amber">{reason}</p>
                      ) : (
                        <p class="mt-1 truncate ltr-inline font-mono text-xs text-faint">{item.href}</p>
                      )}

                      <details class="admin-rename mt-1.5">
                        <summary class="inline-flex cursor-pointer list-none text-xs text-brand-fg hover:underline">
                          ویرایش عنوان لینک
                        </summary>
                        <form
                          method="POST"
                          action="/api/admin/navigation"
                          class="mt-2 rounded-xl border border-line bg-surface-2 p-2.5"
                        >
                          <input type="hidden" name="_action" value="label" />
                          <input type="hidden" name="id" value={item.publicId} />
                          <label
                            for={`label-${item.publicId}`}
                            class="block text-[11px] font-semibold text-muted"
                          >
                            متن جدید لینک
                          </label>
                          <div class="mt-1 flex gap-2">
                            <input
                              id={`label-${item.publicId}`}
                              type="text"
                              name="label"
                              value={item.label ?? ''}
                              maxlength={MAX_MENU_LABEL}
                              placeholder={item.targetName ?? 'متن لینک'}
                              class="gg-admin-input min-w-0 flex-1 py-1 text-xs"
                            />
                            <button type="submit" class="gg-admin-btn-primary py-1 text-xs">
                              ذخیره
                            </button>
                          </div>
                        </form>
                      </details>
                    </div>

                    <div class="flex flex-none items-center gap-1">
                      <form method="POST" action="/api/admin/navigation">
                        <input type="hidden" name="_action" value="move" />
                        <input type="hidden" name="id" value={item.publicId} />
                        <input type="hidden" name="direction" value="up" />
                        <button
                          type="submit"
                          aria-label="Move up"
                          disabled={index === 0}
                          class="px-1.5 text-sm text-muted hover:text-brand-fg disabled:invisible"
                        >
                          ↑
                        </button>
                      </form>
                      <form method="POST" action="/api/admin/navigation">
                        <input type="hidden" name="_action" value="move" />
                        <input type="hidden" name="id" value={item.publicId} />
                        <input type="hidden" name="direction" value="down" />
                        <button
                          type="submit"
                          aria-label="Move down"
                          disabled={index === menus[loc.key].length - 1}
                          class="px-1.5 text-sm text-muted hover:text-brand-fg disabled:invisible"
                        >
                          ↓
                        </button>
                      </form>
                      <form
                        method="POST"
                        action="/api/admin/navigation"
                        data-confirm-message={`آیتم «${item.text || 'انتخابی'}» از ${loc.title} حذف شود؟`}
                      >
                        <input type="hidden" name="_action" value="remove" />
                        <input type="hidden" name="id" value={item.publicId} />
                        <button
                          type="submit"
                          aria-label={`حذف ${item.text || 'آیتم'}`}
                          class="px-1.5 text-base font-bold text-coral hover:opacity-80"
                        >
                          ×
                        </button>
                      </form>
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      ))
    }
  </div>

<script>
  const form = document.querySelector('[data-add-item]') as HTMLFormElement | null;
  const typeSel = form?.querySelector('select[name="target_type"]') as HTMLSelectElement | null;
  const search = form?.querySelector('input[name="q"]') as HTMLInputElement | null;
  const searchAll = form?.querySelector('button[formmethod="get"]') as HTMLButtonElement | null;
  const labelInput = form?.querySelector('[data-label-input]') as HTMLInputElement | null;
  const addButton = form?.querySelector('[data-add-button]') as HTMLButtonElement | null;

  if (form && typeSel && search && searchAll) {
    type Picker = {
      select: HTMLSelectElement;
      truncated: boolean;
      all: { value: string; text: string }[];
    };
    const pickers = new Map<string, Picker>();

    for (const node of form.querySelectorAll('[data-target-picker]')) {
      const el = node as HTMLElement;
      const select = el.querySelector('select') as HTMLSelectElement | null;
      const key = el.getAttribute('data-target-picker');
      if (!select || !key) continue;
      pickers.set(key, {
        select,
        truncated: el.getAttribute('data-truncated') === '1',
        all: Array.from(select.options)
          .filter((o) => o.value !== '')
          .map((o) => ({ value: o.value, text: o.textContent ?? '' })),
      });
    }

    const singletonLabels: Record<string, string> = { home: 'صفحه اصلی', catalog: 'کاتالوگ محصولات' };

    const syncPlaceholder = () => {
      if (!labelInput) return;
      const picker = pickers.get(typeSel.value);
      const name = picker
        ? (picker.select.selectedOptions[0]?.value === ''
            ? ''
            : (picker.select.selectedOptions[0]?.textContent ?? ''))
        : (singletonLabels[typeSel.value] ?? '');
      labelInput.placeholder = name ? `پیش‌فرض: «${name}»` : 'عنوان لینک';
    };

    const setAddEnabled = (enabled: boolean) => {
      if (!addButton) return;
      addButton.disabled = !enabled;
    };

    const apply = () => {
      const picker = pickers.get(typeSel.value);
      if (!picker) {
        setAddEnabled(true);
        syncPlaceholder();
        return;
      }
      const q = search.value.trim().toLowerCase();
      const matches = q ? picker.all.filter((o) => o.text.toLowerCase().includes(q)) : picker.all;
      const empty = picker.truncated ? 'نتیجه‌ای یافت نشد — جستجوی کل را بزنید' : 'موردی یافت نشد';
      picker.select.replaceChildren(
        ...(matches.length === 0
          ? [new Option(empty, '')]
          : matches.map((o) => new Option(o.text, o.value))),
      );
      searchAll.hidden = !picker.truncated;
      setAddEnabled(matches.length > 0);
      syncPlaceholder();
    };

    typeSel.addEventListener('change', () => {
      search.value = '';
      apply();
    });
    search.addEventListener('input', apply);
    for (const picker of pickers.values()) {
      picker.select.addEventListener('change', syncPlaceholder);
    }
    search.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key === 'Enter') event.preventDefault();
    });
    apply();
  }

  const refreshEnds = (list: HTMLElement) => {
    const rows = [...list.children];
    rows.forEach((row, i) => {
      const up = row.querySelector('button[aria-label="Move up"]') as HTMLButtonElement | null;
      const down = row.querySelector('button[aria-label="Move down"]') as HTMLButtonElement | null;
      if (up) up.disabled = i === 0;
      if (down) down.disabled = i === rows.length - 1;
    });
  };

  for (const node of document.querySelectorAll('[data-menu-list]')) {
    const list = node as HTMLElement;
    const menuLocation = list.getAttribute('data-menu-list') ?? '';
    const rows = () => [...list.children] as HTMLElement[];

    const reloadPage = () => window.location.reload();
    const persistOrder = async () => {
      const body = new URLSearchParams();
      body.set('_action', 'reorder');
      body.set('location', menuLocation);
      for (const row of rows()) body.append('order', row.getAttribute('data-menu-item') ?? '');
      try {
        const response = await fetch('/api/admin/navigation', {
          method: 'POST',
          body,
          headers: { 'x-partial': '1' },
        });
        if (!response.ok) reloadPage();
      } catch {
        reloadPage();
      }
    };

    let dragging: HTMLElement | null = null;
    for (const row of rows()) {
      row.setAttribute('draggable', 'true');
      row.addEventListener('dragstart', () => {
        dragging = row;
        row.classList.add('dragging');
      });
      row.addEventListener('dragend', async () => {
        row.classList.remove('dragging');
        dragging = null;
        refreshEnds(list);
        await persistOrder();
      });
    }
    list.addEventListener('dragover', (event) => {
      event.preventDefault();
      if (!dragging) return;
      const after = rows().find((el) => {
        if (el === dragging) return false;
        const r = el.getBoundingClientRect();
        return r.top + r.height / 2 >= (event as DragEvent).clientY;
      });
      list.insertBefore(dragging, after ?? null);
    });

    list.addEventListener('submit', async (event) => {
      const rowForm = event.target as HTMLFormElement;
      const actionInput = rowForm.querySelector('input[name="_action"]') as HTMLInputElement | null;
      if (actionInput?.value !== 'move') return;

      const row = rowForm.closest('li');
      const direction = (rowForm.querySelector('input[name="direction"]') as HTMLInputElement | null)?.value;
      const sibling =
        direction === 'up' ? row?.previousElementSibling : row?.nextElementSibling;
      if (!row || !sibling) return;

      event.preventDefault();
      let response: Response;
      try {
        response = await fetch(rowForm.action, {
          method: 'POST',
          body: new URLSearchParams(new FormData(rowForm) as unknown as Record<string, string>),
          headers: { 'x-partial': '1' },
        });
      } catch {
        rowForm.submit();
        return;
      }
      if (!response.ok) {
        rowForm.submit();
        return;
      }

      if (direction === 'up') list.insertBefore(row, sibling);
      else list.insertBefore(sibling, row);
      refreshEnds(list);
    });
  }
</script>
</AdminLayout>
