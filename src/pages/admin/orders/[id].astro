---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import { formatPrice, getConfig } from '../../../config';
import { getOrderByPublicId, listOrderItemsWithImages, listOrderInventoryExceptions } from '../../../features/orders/db';
import { orderReference } from '../../../features/orders/number';
import { CARRIERS, carrierName, trackingUrl } from '../../../features/orders/tracking';
import { getSecret } from '../../../features/secrets/store';
import { getEmailProvider } from '../../../features/email';
import { getStoreSettings, getSetting } from '../../../features/settings/db';
import { formatWeightValue, formatWeight } from '../../../features/shipping/weight';
import {
  distanceUnitFor,
  getShipmentRates,
  type LabelRate,
  type ShipFrom,
} from '../../../features/shipping/labels.ts';
import {
  getLabelRecord,
  isPurchaseStale,
  listLabelAttempts,
} from '../../../features/shipping/labelStore';
import { shouldSendCustomerOrderEmail } from '../../../features/email/orderPolicy';
import RefundPanel from '../../../features/refunds/RefundPanel.astro';
import { parseOrderOrLegacyPublicId } from '../../../features/ids/publicId';
import { parseStoredCustomerInputs } from '../../../features/products/customFields';
import { fa } from '../../../i18n/fa';
import { resolveAdminActor } from '../../../features/fulfillment/actor';
import { hasAdminPermission } from '../../../features/fulfillment/permissions';
import {
  listDeliveriesForOrder,
  listDeliveryAttachmentsForOrder,
  listDeliveryNotificationEvents,
  listDeliveryVersionsForOrder,
  listOrderStatusHistory,
  recordAdminViewedSensitiveDelivery,
} from '../../../features/fulfillment/db';
import { listOrderFulfillmentAuditLogs } from '../../../features/audit/db';
import { getLatestPaymentTxForTarget } from '../../../features/payments/transactionsDb';
import AdminOrderFulfillmentWorkspace from '../../../features/fulfillment/AdminOrderFulfillmentWorkspace.astro';
import { formatJalaliDateTime, toPersianDigits } from '../../../lib/format';

const publicId = parseOrderOrLegacyPublicId(Astro.params.id, 'order');
const order = publicId ? await getOrderByPublicId(env.DB, publicId) : null;

if (!order) {
  return new Response('Not found', { status: 404 });
}

const adminActor = await resolveAdminActor(env.DB, Astro);
const canRefund = hasAdminPermission(adminActor, 'orders.refund');
const canFulfill = hasAdminPermission(adminActor, 'orders.fulfill');

const [
  deliveries,
  deliveryVersions,
  deliveryAttachments,
  orderStatusHistory,
  notificationEvents,
  latestPaymentTx,
] = await Promise.all([
  listDeliveriesForOrder(env.DB, order.id),
  listDeliveryVersionsForOrder(env.DB, order.id),
  listDeliveryAttachmentsForOrder(env.DB, order.id),
  listOrderStatusHistory(env.DB, order.id),
  listDeliveryNotificationEvents(env.DB, order.id),
  order.public_id ? getLatestPaymentTxForTarget(env.DB, 'order', order.public_id) : Promise.resolve(null),
]);

if (deliveries.length > 0) {
  await recordAdminViewedSensitiveDelivery(env.DB, adminActor, order);
}
const orderAuditLogs = await listOrderFulfillmentAuditLogs(
  env.DB,
  order.id,
  order.public_id,
  15,
);

const num = orderReference(order.public_id, order.id, getConfig().orderNumber);
const PAYMENT_LABELS: Record<string, string> = {
  wallet: 'کیف پول GarGift+ (Wallet)',
  bank_transfer: 'کارت‌به‌کارت و واریز بانکی',
  zarinpal: 'درگاه پرداخت زرین‌پال',
  zibal: 'درگاه پرداخت زیبال',
  stripe: 'کارت بین‌المللی (Stripe)',
  lightning: 'لابتنینگ (Lightning)',
  opennode: 'بیت‌کوین (OpenNode)',
  demo: 'تستی (Demo)',
};
const paymentLabel = order.payment_method
  ? (PAYMENT_LABELS[order.payment_method] ?? order.payment_method)
  : '—';
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;
const items = await listOrderItemsWithImages(env.DB, order.id);
const inventoryExceptions = await listOrderInventoryExceptions(env.DB, order.id);
const fulfilled = order.fulfillment_status === 'fulfilled';
const weightUnit = Astro.locals.settings?.weightUnit ?? 'g';

const shippoToken = await getSecret(env.DB, 'shippo_api_key');
const labelRecord = await getLabelRecord(env.DB, order.id);
const labelAttempts = await listLabelAttempts(env.DB, order.id);
const canLabel =
  !!shippoToken &&
  !!order.ship_address &&
  !fulfilled &&
  order.status === 'paid' &&
  order.delivery_method === 'shipping';
let labelRates: LabelRate[] = [];
let labelRatesError: string | null = null;
if (canLabel && labelRecord?.status === 'quoted' && shippoToken) {
  const rates = await getShipmentRates(shippoToken, labelRecord.shipment_id);
  if (rates.ok) labelRates = rates.value;
  else labelRatesError = rates.error;
}
const labelInFlight = labelRecord?.status === 'purchasing' && !isPurchaseStale(labelRecord);
const labelUnreconciled =
  labelRecord?.status === 'purchased' &&
  (order.tracking_number !== labelRecord.tracking_number || order.label_url !== labelRecord.label_url);
const labelUncertain =
  labelRecord?.status === 'uncertain' ||
  (labelRecord?.status === 'purchasing' && isPurchaseStale(labelRecord));
let shipFrom: Partial<ShipFrom> = {};
let parcelDefault: Partial<{ length: number; width: number; height: number }> = {};
if (canLabel) {
  try {
    shipFrom = JSON.parse((await getSetting(env.DB, 'ship_from')) ?? '{}');
  } catch {}
  try {
    parcelDefault = JSON.parse((await getSetting(env.DB, 'parcel_default')) ?? '{}');
  } catch {}
}
const dimUnit = distanceUnitFor(weightUnit);
const parcelWeightValue =
  order.shipping_weight_grams != null ? formatWeightValue(order.shipping_weight_grams, weightUnit) : '';

const trackUrl = trackingUrl(order.tracking_carrier, order.tracking_number);
const error = Astro.url.searchParams.get('error');
const noticeMsg = Astro.url.searchParams.get('notice');
const canReissue =
  !!order.email &&
  !!order.public_id?.startsWith('ord_') &&
  shouldSendCustomerOrderEmail(order.payment_method);
const itemsTotalCents = items.reduce((sum, it) => sum + it.price_cents * it.quantity, 0);
const mismatch =
  items.length > 0 &&
  itemsTotalCents + order.shipping_cents - order.discount_cents + order.tax_cents !==
    order.amount_total_cents;

const ship = order.ship_address
  ? (JSON.parse(order.ship_address) as {
      name: string | null;
      line1: string | null;
      line2: string | null;
      city: string | null;
      state: string | null;
      postal: string | null;
      country: string | null;
    })
  : null;
const labelInternational =
  !!shipFrom.country && !!ship?.country && shipFrom.country.toUpperCase() !== ship.country.toUpperCase();
const willEmailCustomer =
  !!order.email &&
  order.payment_method !== 'demo' &&
  !!(await getEmailProvider(Astro.locals.settings ?? (await getStoreSettings(env.DB))));

const ORDER_STATUS_FA: Record<string, string> = {
  paid: 'پرداخت‌شده',
  pending: 'در انتظار پرداخت',
  refunded: 'مستردشده',
};
---

<AdminLayout
  title={`سفارش #${num}`}
  active="orders"
  requiredPermission="orders.view"
  breadcrumbs={[
    { label: 'سفارش‌ها', href: '/admin/orders' },
    { label: `#${num}` },
  ]}
>
  <AdminPageHeader
    title={`جزئیات سفارش #${num}`}
    subtitle={`تاریخ ثبت: ${formatJalaliDateTime(order.created_at, { timeZone })} · ${paymentLabel}`}
    badge={ORDER_STATUS_FA[order.status] ?? order.status}
  >
    <div slot="actions" class="flex flex-wrap items-center gap-2">
      {
        order.email && (
          <a href={`/admin/customers/${encodeURIComponent(order.email)}`} class="gg-admin-btn-secondary text-xs">
            پروفایل مشتری
          </a>
        )
      }
      <a href="/admin/orders" class="gg-admin-btn-secondary text-xs">
        ← بازگشت به سفارش‌ها
      </a>
    </div>
  </AdminPageHeader>

  {
    error && (
      <div class="gg-status-error mb-5 rounded-xl border px-4 py-3 text-sm font-medium">
        {error}
      </div>
    )
  }
  {
    noticeMsg && !error && (
      <div class="gg-status-success mb-5 rounded-xl border px-4 py-3 text-sm font-medium">
        {noticeMsg}
      </div>
    )
  }

  {
    inventoryExceptions.some((entry) => !entry.resolved_at) && (
      <section class="gg-status-error mb-6 rounded-2xl border p-5 text-sm">
        <h2 class="font-bold">تطبیق کسری موجودی مورد نیاز است</h2>
        <p class="mt-1 text-xs">
          پرداخت پس از پایان مهلت رزرو سبد خرید انجام شده و بخشی از موجودی به‌صورت خودکار کسر نشده است.
        </p>
        <div class="mt-3 space-y-2">
          {inventoryExceptions.filter((entry) => !entry.resolved_at).map((entry) => (
            <form method="post" action={`/api/admin/orders/${publicId}`} class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-surface p-3 text-xs text-ink">
              <span>
                <strong>{items.find((item) => item.product_id === entry.product_id && item.variant_id === entry.variant_id)?.name ?? 'آیتم سفارش'}</strong>:
                درخواست {toPersianDigits(entry.requested_qty)} · موجود {toPersianDigits(entry.consumed_qty)} ({toPersianDigits(entry.shortfall_qty)} کسری)
              </span>
              <input type="hidden" name="_action" value="resolve_inventory_exception" />
              <input type="hidden" name="exception_id" value={entry.public_id} />
              <button class="gg-admin-btn-secondary py-1 text-xs">تایید تطبیق</button>
            </form>
          ))}
        </div>
      </section>
    )
  }

  {/* خلاصه مالی و اطلاعات خریدار */}
  <div class="mb-6 grid gap-6 lg:grid-cols-12">
    <section class="gg-admin-card p-5 lg:col-span-7">
      <h2 class="mb-4 text-sm font-bold text-ink">مشخصات سفارش و پرداخت</h2>
      <dl class="grid grid-cols-2 gap-4 text-sm sm:grid-cols-3">
        <div>
          <dt class="text-[11px] font-medium text-faint">وضعیت پرداخت</dt>
          <dd class="mt-1 font-bold text-ink">{ORDER_STATUS_FA[order.status] ?? order.status}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-medium text-faint">تاریخ ثبت</dt>
          <dd class="mt-1 text-xs font-medium text-ink">{formatJalaliDateTime(order.created_at, { timeZone })}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-medium text-faint">مبلغ نهایی</dt>
          <dd class="mt-1 font-extrabold text-brand-fg">{formatPrice(order.amount_total_cents, order.currency)}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-medium text-faint">ایمیل خریدار</dt>
          <dd class="mt-1 truncate text-xs">
            {order.email ? (
              <a href={`/admin/customers/${encodeURIComponent(order.email)}`} class="ltr-inline font-mono text-brand-fg hover:underline">
                {order.email}
              </a>
            ) : '—'}
          </dd>
        </div>
        <div>
          <dt class="text-[11px] font-medium text-faint">روش پرداخت</dt>
          <dd class="mt-1 text-xs font-medium text-ink">{paymentLabel}</dd>
        </div>
        <div>
          <dt class="text-[11px] font-medium text-faint">هزینه ارسال</dt>
          <dd class="mt-1 text-xs text-ink">
            {formatPrice(order.shipping_cents, order.currency)}
            {order.shipping_label && <span class="text-muted"> · {order.shipping_label}</span>}
            {order.shipping_weight_grams != null && (
              <span class="text-muted"> · {formatWeight(order.shipping_weight_grams, weightUnit)}</span>
            )}
          </dd>
        </div>
        {order.discount_cents > 0 && (
          <div>
            <dt class="text-[11px] font-medium text-faint">تخفیف</dt>
            <dd class="mt-1 text-xs font-semibold text-accent">{formatPrice(order.discount_cents, order.currency)}</dd>
          </div>
        )}
        {order.tax_cents > 0 && (
          <div>
            <dt class="text-[11px] font-medium text-faint">مالیات</dt>
            <dd class="mt-1 text-xs text-ink">{formatPrice(order.tax_cents, order.currency)}</dd>
          </div>
        )}
        <div class="col-span-2 sm:col-span-3">
          <dt class="text-[11px] font-medium text-faint">شناسه مرجع پرداخت (Payment Ref)</dt>
          <dd class="ltr-inline mt-1 break-all font-mono text-xs text-muted">{order.provider_session_id ?? '—'}</dd>
        </div>
        {ship && (
          <div class="col-span-2 sm:col-span-3">
            <dt class="text-[11px] font-medium text-faint">نشانی ثبت‌شده</dt>
            <dd class="mt-1 whitespace-pre-line text-xs text-ink">
              {[ship.name, ship.line1, ship.line2, [ship.city, ship.state, ship.postal].filter(Boolean).join('، '), ship.country]
                .filter(Boolean)
                .join('\n')}
            </dd>
          </div>
        )}
      </dl>
    </section>

    {/* یادداشت داخلی مدیر */}
    <section class="gg-admin-card flex flex-col justify-between p-5 lg:col-span-5">
      <div>
        <h2 class="text-sm font-bold text-ink">یادداشت داخلی مدیران</h2>
        <p class="mt-1 text-xs text-muted">
          این یادداشت فقط در پنل مدیریت نمایش داده می‌شود و به مشتری ارسال نمی‌گردد.
        </p>
        <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="mt-3 space-y-3">
          <input type="hidden" name="_action" value="update_internal_notes" />
          <textarea
            name="internal_notes"
            rows="4"
            maxlength="2000"
            disabled={!canFulfill}
            placeholder="توضیحات پشتیبانی، وضعیت پیگیری یا نکات ویژه این سفارش..."
            class="gg-admin-input text-xs"
          >{order.internal_notes ?? ''}</textarea>
          {
            canFulfill && (
              <button type="submit" class="gg-admin-btn-primary text-xs">
                ذخیره یادداشت داخلی
              </button>
            )
          }
        </form>
      </div>
    </section>
  </div>

  {canRefund && <RefundPanel order={order} timeZone={timeZone} />}

  <AdminOrderFulfillmentWorkspace
    order={order}
    items={items}
    deliveries={deliveries}
    versions={deliveryVersions}
    attachments={deliveryAttachments}
    statusHistory={orderStatusHistory}
    notificationEvents={notificationEvents}
    auditLogs={orderAuditLogs}
    actor={adminActor}
    timeZone={timeZone}
    latestPaymentTx={latestPaymentTx}
  />

  {/* بخش وضعیت کلی تحویل و ارسال */}
  <div class="gg-admin-card mb-6 p-5">
    <h2 class="mb-3 text-sm font-bold text-ink">وضعیت نهایی ارسال / تحویل سفارش</h2>
    {
      labelUnreconciled && labelRecord && (
        <div class="gg-status-warning mb-4 rounded-xl border p-4 text-xs">
          <p class="mb-1 font-bold">برچسب پستی خریداری‌شده روی این سفارش اعمال نشده است</p>
          <p>
            {labelRecord.provider} {labelRecord.service} · کد رهگیری <span class="ltr-inline font-mono">{labelRecord.tracking_number}</span>
          </p>
          {labelRecord.label_url && (
            <a href={labelRecord.label_url} target="_blank" rel="noopener" class="mt-1 inline-block font-semibold underline">
              دریافت PDF برچسب
            </a>
          )}
        </div>
      )
    }
    {
      !canLabel && labelUncertain && labelRecord && (
        <div class="gg-status-warning mb-4 space-y-3 rounded-xl border p-4 text-xs">
          <p>تراکنش صدور برچسب Shippo در وضعیت نامشخص است ({labelRecord.error ?? 'Timeout'}).</p>
          <form method="POST" action={`/api/admin/orders/${order.public_id}`}>
            <input type="hidden" name="_action" value="label_reconcile" />
            <button type="submit" class="gg-admin-btn-primary text-xs">استعلام و تطبیق از Shippo</button>
          </form>
        </div>
      )
    }
    {
      fulfilled ? (
        <div class="space-y-3 text-sm">
          <p class="flex items-center gap-2">
            <span class="gg-status-success rounded-md px-2.5 py-0.5 text-xs font-bold">تکمیل و تحویل‌شده</span>
            {order.fulfilled_at && <span class="text-xs text-muted">{formatJalaliDateTime(order.fulfilled_at, { timeZone })}</span>}
          </p>
          {order.tracking_number && (
            <p class="text-xs text-muted">
              {carrierName(order.tracking_carrier)} ·{' '}
              {trackUrl ? (
                <a href={trackUrl} target="_blank" rel="noopener" class="ltr-inline font-mono text-brand-fg hover:underline">
                  {order.tracking_number}
                </a>
              ) : (
                <span class="ltr-inline font-mono">{order.tracking_number}</span>
              )}
            </p>
          )}
          {canFulfill && (
            <form method="POST" action={`/api/admin/orders/${order.public_id}`}>
              <input type="hidden" name="_action" value="unfulfill" />
              <button type="submit" class="text-xs font-semibold text-coral hover:underline">
                بازگرداندن به وضعیت در انتظار تحویل
              </button>
            </form>
          )}
        </div>
      ) : (
        <div class="space-y-5">
          {canLabel && canFulfill && (
            <div class="rounded-xl border border-line bg-paper/60 p-4 text-xs">
              <p class="mb-3 font-bold text-ink">صدور برچسب پستی (Shippo)</p>
              {labelInFlight ? (
                <p class="text-muted">خرید برچسب در حال انجام است. چند لحظه دیگر صفحه را تازه‌سازی کنید.</p>
              ) : labelUncertain ? (
                <div class="space-y-3">
                  <p class="text-amber">نتیجه صدور برچسب نامشخص است؛ استعلام مجدد انجام دهید.</p>
                  <form method="POST" action={`/api/admin/orders/${order.public_id}`}>
                    <input type="hidden" name="_action" value="label_reconcile" />
                    <button type="submit" class="gg-admin-btn-primary text-xs">استعلام از Shippo</button>
                  </form>
                </div>
              ) : labelInternational && labelRates.length === 0 ? (
                <p class="text-muted">ارسال بین‌المللی مستقیم پشتیبانی نمی‌شود؛ کد رهگیری را به‌صورت دستی ثبت کنید.</p>
              ) : labelRates.length > 0 ? (
                <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="space-y-2">
                  <input type="hidden" name="_action" value="buy_label" />
                  {labelRates.map((r, i) => (
                    <label class="flex items-center gap-3 rounded-lg border border-line bg-surface p-2.5">
                      <input type="radio" name="rate" value={r.rateId} checked={i === 0} class="size-4 accent-brand" />
                      <span class="flex-1">{r.provider} {r.service}</span>
                      <span class="font-bold">{formatPrice(r.amountCents, r.currency)}</span>
                    </label>
                  ))}
                  <div class="flex items-center gap-3 pt-2">
                    <button type="submit" class="gg-admin-btn-primary text-xs">خرید برچسب</button>
                    <button type="submit" form="label-discard" class="gg-admin-btn-secondary text-xs">شروع مجدد</button>
                  </div>
                </form>
              ) : (
                <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="space-y-3">
                  <input type="hidden" name="_action" value="label_rates" />
                  <div class="grid gap-3 sm:grid-cols-3">
                    <input name="from_name" value={shipFrom.name ?? ''} required placeholder="نام فرستنده" class="gg-admin-input text-xs sm:col-span-3" />
                    <input name="from_street1" value={shipFrom.street1 ?? ''} required placeholder="آدرس فرستنده" class="gg-admin-input text-xs sm:col-span-3" />
                    <input name="from_city" value={shipFrom.city ?? ''} required placeholder="شهر" class="gg-admin-input text-xs" />
                    <input name="from_state" value={shipFrom.state ?? ''} placeholder="استان/ایالت" class="gg-admin-input text-xs" />
                    <input name="from_zip" value={shipFrom.zip ?? ''} required placeholder="کد پستی" class="gg-admin-input text-xs" />
                    <input name="from_country" value={shipFrom.country ?? 'US'} required maxlength="2" placeholder="کد کشور" class="gg-admin-input text-xs uppercase" />
                    <input name="parcel_length" value={parcelDefault.length ?? ''} required inputmode="decimal" placeholder={`طول (${dimUnit})`} class="gg-admin-input text-xs" />
                    <input name="parcel_width" value={parcelDefault.width ?? ''} required inputmode="decimal" placeholder={`عرض (${dimUnit})`} class="gg-admin-input text-xs" />
                    <input name="parcel_height" value={parcelDefault.height ?? ''} required inputmode="decimal" placeholder={`ارتفاع (${dimUnit})`} class="gg-admin-input text-xs" />
                    <input name="parcel_weight" value={parcelWeightValue} required inputmode="decimal" placeholder={`وزن (${weightUnit})`} class="gg-admin-input text-xs" />
                  </div>
                  <button type="submit" class="gg-admin-btn-primary text-xs">دریافت تعرفه پستی</button>
                </form>
              )}
              <form method="POST" action={`/api/admin/orders/${order.public_id}`} id="label-discard">
                <input type="hidden" name="_action" value="label_discard" />
              </form>
            </div>
          )}

          {canFulfill && (
            <form method="POST" action={`/api/admin/orders/${order.public_id}`} class="flex flex-wrap items-end gap-3 text-sm">
              <input type="hidden" name="_action" value="fulfill" />
              <div>
                <label class="mb-1 block text-xs font-semibold text-ink">روش / سرویس ارسال</label>
                <select name="carrier" class="gg-admin-input py-2 text-xs">
                  {CARRIERS.map((c) => (
                    <option value={c.code}>{c.name}</option>
                  ))}
                </select>
              </div>
              <div>
                <label class="mb-1 block text-xs font-semibold text-ink">کد رهگیری / مرجع تحویل</label>
                <input name="tracking_number" type="text" class="gg-admin-input ltr-inline py-2 font-mono text-xs" />
              </div>
              <button type="submit" class="gg-admin-btn-primary py-2 text-xs">
                ثبت نهایی به‌عنوان تحویل‌شده
              </button>
            </form>
          )}
        </div>
      )
    }

    {
      labelAttempts.length > 0 && (
        <details class="mt-4 border-t border-line pt-3 text-xs">
          <summary class="cursor-pointer font-semibold text-muted">
            تاریخچه تلاش‌های صدور برچسب ({toPersianDigits(labelAttempts.length)})
          </summary>
          <ul class="mt-2 space-y-2">
            {labelAttempts.map((attempt) => (
              <li class="rounded-xl border border-line bg-paper/60 px-3 py-2 text-muted">
                {attempt.outcome} · {formatJalaliDateTime(attempt.settled_at, { timeZone })}
                {attempt.tracking_number && ` · کد رهگیری: ${attempt.tracking_number}`}
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </div>

  {
    canReissue && canFulfill && (
      <div class="gg-admin-card mb-6 p-5">
        <h2 class="text-sm font-bold text-ink">ارسال لینک دسترسی جدید به خریدار</h2>
        <p class="mt-1 text-xs text-muted">
          در صورتی که لینک قبلی سفارش لو رفته یا برای مشتری ایمیل نشده باشد، با صدور لینک جدید تمام لینک‌های قبلی بلافاصله باطل می‌شوند.
        </p>
        <form
          method="POST"
          action={`/api/admin/orders/${order.public_id}`}
          data-confirm-message={`لینک دسترسی جدید به ایمیل ${order.email} ارسال شود؟ لینک‌های قبلی این سفارش بلافاصله از کار می‌افتند.`}
          class="mt-3"
        >
          <input type="hidden" name="_action" value="reissue_link" />
          <button type="submit" class="gg-admin-btn-secondary text-xs">
            صدور و ایمیل لینک جدید به مشتری
          </button>
        </form>
      </div>
    )
  }

  {
    order.email && order.status !== 'refunded' && canRefund && (
      <div class="gg-admin-card mb-6 p-5">
        <h2 class="text-sm font-bold text-ink">بازگشت وجه به کیف پول مشتری</h2>
        <p class="mt-1 text-xs text-muted">
          استرداد مستقیم مبلغ سفارش به کیف پول حساب کاربری <strong class="ltr-inline font-mono text-ink">{order.email}</strong> همراه با ثبت در دفتر کل کیف پول و گزارش حسابرسی:
        </p>
        <form
          method="POST"
          action={`/api/admin/orders/${order.public_id}`}
          class="mt-3 flex flex-wrap items-end gap-3"
        >
          <input type="hidden" name="_action" value="refund_to_wallet" />
          <div>
            <label class="mb-1 block text-xs font-semibold text-ink">
              مبلغ بازگشتی ({order.currency.toLowerCase() === 'irt' ? 'تومان' : order.currency.toLowerCase() === 'irr' ? 'ریال' : order.currency.toUpperCase()})
            </label>
            <input
              type="number"
              name="wallet_amount"
              value={order.amount_total_cents - order.refunded_cents}
              min="1"
              max={order.amount_total_cents - order.refunded_cents}
              required
              class="gg-admin-input ltr-inline w-40 font-mono text-xs"
            />
          </div>
          <div class="min-w-56 flex-1">
            <label class="mb-1 block text-xs font-semibold text-ink">علت بازگشت وجه</label>
            <input
              type="text"
              name="reason"
              required
              placeholder="مثال: عدم امکان تحویل سرویس در ریجن انتخاب‌شده"
              class="gg-admin-input text-xs"
            />
          </div>
          <button type="submit" class="gg-admin-btn-primary text-xs">
            واریز استرداد به کیف پول مشتری
          </button>
        </form>
      </div>
    )
  }

  {/* جدول اقلام سفارش */}
  <section class="gg-admin-card overflow-hidden p-5">
    <h2 class="mb-4 text-sm font-bold text-ink">اقلام ثبت‌شده در سفارش</h2>
    <div class="overflow-x-auto">
      <table class="gg-admin-table">
        <thead>
          <tr>
            <th>محصول / سرویس</th>
            <th>قیمت واحد</th>
            <th>تعداد</th>
            <th class="text-end">جمع ردیف</th>
          </tr>
        </thead>
        <tbody>
          {
            items.map((it) => {
              const customerInputs = parseStoredCustomerInputs(it.customer_inputs_json);
              return (
                <tr>
                  <td>
                    {it.product_public_id ? (
                      <a href={`/admin/products/${it.product_public_id}/edit`} class="font-semibold text-brand-fg hover:underline">
                        {it.name}
                      </a>
                    ) : (
                      <span class="font-semibold text-ink">{it.name}</span>
                    )}
                    {customerInputs.length > 0 && (
                      <dl class="mt-2 space-y-1 rounded-xl border border-line bg-paper/70 px-3 py-2 text-xs">
                        <dt class="text-[11px] font-bold text-muted">{fa.orders.customerInputsLabel}</dt>
                        {customerInputs.map((ci) => (
                          <div class="flex flex-wrap items-baseline justify-between gap-3">
                            <dt class="text-muted">{ci.label}:</dt>
                            <dd class={ci.type === 'email' || ci.type === 'number' ? 'ltr-inline font-mono font-semibold text-ink' : 'font-semibold text-ink'}>
                              {ci.value}
                            </dd>
                          </div>
                        ))}
                      </dl>
                    )}
                  </td>
                  <td class="text-muted">{formatPrice(it.price_cents, order.currency)}</td>
                  <td class="font-semibold text-ink">{toPersianDigits(it.quantity)}</td>
                  <td class="text-end font-bold text-ink">
                    {formatPrice(it.price_cents * it.quantity, order.currency)}
                  </td>
                </tr>
              );
            })
          }
          {
            items.length === 0 && (
              <tr>
                <td colspan="4" class="py-8 text-center text-xs text-muted">
                  ردیفی برای این سفارش ثبت نشده است.
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>
    {
      mismatch && (
        <p class="gg-status-warning mt-4 rounded-xl border px-3 py-2 text-xs font-medium">
          توجه: مجموع اقلام ({formatPrice(itemsTotalCents, order.currency)}) با مبلغ نهایی سفارش تطابق کامل ندارد — درگاه پرداخت را بررسی کنید.
        </p>
      )
    }
  </section>
</AdminLayout>
