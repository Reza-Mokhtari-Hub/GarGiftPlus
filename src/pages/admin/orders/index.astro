---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminEmptyState from '../../../components/admin/AdminEmptyState.astro';
import { formatPrice, getConfig } from '../../../config';
import {
  countOrders,
  listOrders,
  getOrder,
  getOrderByPublicId,
  findOrderPublicIdByReference,
  listUnresolvedInventoryExceptions,
} from '../../../features/orders/db';
import { orderByClause } from '../../../features/orders/sort';
import { orderReference } from '../../../features/orders/number';
import { paginate, queryHref } from '../../../pagination';
import Pagination from '../../../components/Pagination.astro';
import {
  parseOrderFilters,
  parseOrderAdvancedFilters,
  combineOrderFilterClauses,
  orderFilterParams,
  orderAdvancedFilterParams,
  hasOrderFilters,
  hasOrderAdvancedFilters,
  ORDER_STATUS_OPTIONS,
  ORDER_FULFILLMENT_OPTIONS,
  ORDER_METHOD_OPTIONS,
} from '../../../features/orders/filter';
import { listUnmatchedRefundEvents } from '../../../features/refunds/db';
import {
  parseOrderOrLegacyPublicId,
  parsePublicId,
  truncatePublicId,
  PUBLIC_ID_TOKEN_LENGTH,
} from '../../../features/ids/publicId';
import { formatJalaliDateTime, toPersianDigits } from '../../../lib/format';
import { resolveAdminActor } from '../../../features/fulfillment/actor';
import { hasAdminPermission } from '../../../features/fulfillment/permissions';

const actor = await resolveAdminActor(env.DB, Astro);
const canExport = hasAdminPermission(actor, 'orders.export');

const rawQuery = Astro.url.searchParams.get('q');
let lookupError: string | null = null;
if (rawQuery !== null) {
  const query = rawQuery.trim().replace(/^#/, '');
  if (query !== '') {
    const bareToken = parsePublicId(`ord_${query.toLowerCase()}`, 'order');
    const candidates = [
      parseOrderOrLegacyPublicId(query, 'order'),
      query.length === PUBLIC_ID_TOKEN_LENGTH ? bareToken : null,
      await findOrderPublicIdByReference(env.DB, query),
    ].filter((c): c is string => c !== null);
    for (const candidate of candidates) {
      const found = await getOrderByPublicId(env.DB, candidate);
      if (found) return Astro.redirect(`/admin/orders/${found.public_id}`, 302);
    }
    lookupError = `سفارشی با شناسه یا شماره «${query}» یافت نشد.`;
  }
}

const sort = Astro.url.searchParams.get('sort');
const dir = Astro.url.searchParams.get('dir');
const filters = parseOrderFilters(Astro.url.searchParams);
const advFilters = parseOrderAdvancedFilters(Astro.url.searchParams);
const filterClause = combineOrderFilterClauses(filters, advFilters);
const filtered = hasOrderFilters(filters) || hasOrderAdvancedFilters(advFilters);
const filterQuery = {
  ...orderFilterParams(filters),
  ...orderAdvancedFilterParams(advFilters),
};

const PAGE_SIZE = 50;
const matchCount = await countOrders(env.DB, filterClause);
const { page, offset, totalPages } = paginate(Astro.url.searchParams, matchCount, PAGE_SIZE);
const orders = await listOrders(
  env.DB,
  PAGE_SIZE,
  orderByClause(sort, dir),
  offset,
  filterClause,
);

const hrefFor = (p: number) =>
  queryHref('/admin/orders', { ...filterQuery, sort, dir, page: p > 1 ? p : undefined });
const onCfg = getConfig().orderNumber;
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;

const sortHref = (col: string) =>
  queryHref('/admin/orders', {
    ...filterQuery,
    sort: col,
    dir: sort === col && dir === 'desc' ? 'asc' : 'desc',
  });
const arrow = (col: string) => (sort === col ? (dir === 'asc' ? ' ↑' : ' ↓') : '');

const unmatched = await listUnmatchedRefundEvents(env.DB);
const inventoryExceptions = await listUnresolvedInventoryExceptions(env.DB);
const conflictOrders = new Map(
  await Promise.all(
    unmatched
      .filter((e) => e.order_id != null)
      .map(async (e) => [e.order_id!, await getOrder(env.DB, e.order_id!)] as const),
  ),
);
const listError = Astro.url.searchParams.get('error');

const METHOD_LABELS: Record<string, string> = {
  wallet: 'کیف پول',
  bank_transfer: 'کارت‌به‌کارت',
  zarinpal: 'زرین‌پال',
  zibal: 'زیبال',
  stripe: 'Stripe',
  lightning: 'Lightning',
  opennode: 'OpenNode',
  demo: 'تستی',
};

const STATUS_BADGE: Record<string, { label: string; cls: string }> = {
  paid: { label: 'پرداخت‌شده', cls: 'gg-status-success' },
  pending: { label: 'در انتظار پرداخت', cls: 'gg-status-warning' },
  refunded: { label: 'مستردشده', cls: 'gg-status-error' },
};

const FULFILL_BADGE: Record<string, { label: string; cls: string }> = {
  fulfilled: { label: 'تحویل‌شده', cls: 'gg-status-success' },
  partially_fulfilled: { label: 'تحویل ناقص', cls: 'gg-status-info' },
  ready_for_delivery: { label: 'آماده تحویل', cls: 'gg-status-info' },
  processing: { label: 'در حال آماده‌سازی', cls: 'gg-status-warning' },
  unfulfilled: { label: 'در انتظار تحویل', cls: 'gg-status-warning' },
  cancelled: { label: 'لغوشده', cls: 'gg-status-error' },
};
---

<AdminLayout
  title="مدیریت سفارش‌ها"
  active="orders"
  requiredPermission="orders.view"
  breadcrumbs={[{ label: 'فروش و عملیات' }, { label: 'سفارش‌ها' }]}
>
  <AdminPageHeader
    title="سفارش‌های فروشگاه"
    subtitle="مشاهده وضعیت پرداخت، تحویل دستی محصولات دیجیتال، تاریخچه تراکنش‌ها و خروجی حسابداری"
    badge={`${toPersianDigits(matchCount)} سفارش`}
  >
    <div slot="actions" class="flex flex-wrap items-center gap-2">
      <a href="/admin/fulfillment" class="gg-admin-btn-primary text-xs">
        میز کار تحویل سفارش‌ها
      </a>
      {
        canExport && (
          <a href={queryHref('/admin/orders/export.csv', filterQuery)} class="gg-admin-btn-secondary text-xs">
            {filtered ? 'خروجی CSV نتایج فیلتر' : 'خروجی کامل CSV'}
          </a>
        )
      }
    </div>
  </AdminPageHeader>

  {
    inventoryExceptions.length > 0 && (
      <section id="inventory-exceptions" class="gg-status-error mb-6 rounded-2xl border p-5">
        <h2 class="text-sm font-bold">
          {toPersianDigits(inventoryExceptions.length)} مغایرت رزرو موجودی نیازمند بررسی
        </h2>
        <p class="mt-1 text-xs">
          پرداخت این سفارش‌ها پس از اتمام زمان نگهداری موجودی ثبت شده است. برای تطبیق موجودی هر سفارش را باز کنید.
        </p>
        <ul class="mt-3 space-y-1.5 text-xs">
          {inventoryExceptions.map((entry) => (
            <li>
              <a class="font-bold underline" href={`/admin/orders/${entry.order_public_id}`}>
                سفارش #{orderReference(entry.order_public_id, entry.order_id, onCfg)}
              </a>{' '}
              — کسری {toPersianDigits(entry.shortfall_qty)} عدد
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    listError && (
      <div class="gg-status-warning mb-5 rounded-xl border px-4 py-3 text-sm font-medium">
        {listError}
      </div>
    )
  }

  {
    unmatched.length > 0 && (
      <section class="gg-status-warning mb-6 rounded-2xl border p-5">
        <h2 class="text-sm font-bold">
          {toPersianDigits(unmatched.length)} رویداد بازگشت وجه تطبیق‌نیافته
        </h2>
        <p class="mt-1 text-xs">
          درگاه پرداخت بازگشت وجه را گزارش کرده اما تطبیق روی سفارش هنوز تکمیل نشده است.
        </p>
        <ul class="mt-3 space-y-2 text-xs">
          {unmatched.map((e) => (
            <li class="flex flex-wrap items-center gap-3">
              <span class="ltr-inline font-mono">{e.provider_payment_id ?? '—'}</span>
              <span class="font-bold">
                {formatPrice(e.cumulative_refunded_cents, e.currency ?? undefined)}
              </span>
              <span>{formatJalaliDateTime(e.created_at, { timeZone })}</span>
              {e.order_id && conflictOrders.get(e.order_id) ? (
                <Fragment>
                  <a
                    href={`/admin/orders/${conflictOrders.get(e.order_id)!.public_id}`}
                    class="font-semibold underline"
                  >
                    سفارش #{orderReference(conflictOrders.get(e.order_id)!.public_id, e.order_id, onCfg)}
                  </a>
                  <form method="POST" action="/api/admin/refunds">
                    <input type="hidden" name="_action" value="dismiss_refund_event" />
                    <input type="hidden" name="event_id" value={e.provider_event_id} />
                    <button type="submit" class="gg-admin-btn-secondary py-1 text-[11px]">
                      بستن هشدار
                    </button>
                  </form>
                </Fragment>
              ) : (
                <form method="POST" action="/api/admin/refunds">
                  <input type="hidden" name="_action" value="retry_refund_event" />
                  <input type="hidden" name="event_id" value={e.provider_event_id} />
                  <button type="submit" class="gg-admin-btn-secondary py-1 text-[11px]">
                    تلاش مجدد تطبیق
                  </button>
                </form>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* جستجوی مستقیم + فیلترهای پیشرفته */}
  <div class="gg-admin-card mb-6 space-y-4 p-4">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-4">
      <form method="GET" action="/admin/orders" class="flex flex-1 flex-wrap items-center gap-2">
        <input
          type="search"
          name="q"
          value={rawQuery ?? ''}
          placeholder="جستجوی مستقیم با شماره سفارش یا کد ord_..."
          aria-label="یافتن سفارش"
          class="gg-admin-input max-w-sm py-2 text-xs"
        />
        <button type="submit" class="gg-admin-btn-primary py-2 text-xs">
          یافتن سفارش
        </button>
      </form>
      {
        lookupError && (
          <p class="text-xs font-semibold text-coral">{lookupError}</p>
        )
      }
    </div>

    <form method="GET" action="/admin/orders" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-6">
      {sort && <input type="hidden" name="sort" value={sort} />}
      {dir && <input type="hidden" name="dir" value={dir} />}

      <div>
        <label class="mb-1 block text-[11px] font-semibold text-muted" for="ord-status">وضعیت پرداخت</label>
        <select id="ord-status" name="status" class="gg-admin-input py-2 text-xs">
          <option value="">همه وضعیت‌ها</option>
          {ORDER_STATUS_OPTIONS.map((o) => (
            <option value={o.value} selected={filters.status === o.value}>{o.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label class="mb-1 block text-[11px] font-semibold text-muted" for="ord-fulfill">وضعیت تحویل</label>
        <select id="ord-fulfill" name="fulfillment" class="gg-admin-input py-2 text-xs">
          <option value="">همه وضعیت‌های تحویل</option>
          {ORDER_FULFILLMENT_OPTIONS.map((o) => (
            <option value={o.value} selected={filters.fulfillment === o.value}>{o.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label class="mb-1 block text-[11px] font-semibold text-muted" for="ord-method">روش پرداخت</label>
        <select id="ord-method" name="method" class="gg-admin-input py-2 text-xs">
          <option value="">همه روش‌ها</option>
          {ORDER_METHOD_OPTIONS.map((o) => (
            <option value={o.value} selected={filters.method === o.value}>{o.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label class="mb-1 block text-[11px] font-semibold text-muted" for="ord-from">از تاریخ (میلادی)</label>
        <input id="ord-from" type="date" name="from" value={advFilters.dateFrom ?? ''} class="gg-admin-input py-2 text-xs" />
      </div>

      <div>
        <label class="mb-1 block text-[11px] font-semibold text-muted" for="ord-to">تا تاریخ (میلادی)</label>
        <input id="ord-to" type="date" name="to" value={advFilters.dateTo ?? ''} class="gg-admin-input py-2 text-xs" />
      </div>

      <div class="flex items-end gap-2">
        <button type="submit" class="gg-admin-btn-primary flex-1 justify-center py-2 text-xs">
          اعمال فیلتر
        </button>
        {filtered && (
          <a href="/admin/orders" class="gg-admin-btn-secondary py-2 text-xs">
            پاک
          </a>
        )}
      </div>
    </form>
  </div>

  {
    orders.length === 0 ? (
      <AdminEmptyState
        title={filtered ? 'سفارشی با این فیلترها پیدا نشد' : 'هنوز سفارشی ثبت نشده است'}
        description="با ثبت اولین خرید موفق یا تغییر فیلترهای جستجو، فهرست سفارش‌ها در اینجا نمایش داده می‌شود."
      />
    ) : (
      <div class="gg-admin-card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="gg-admin-table">
            <thead>
              <tr>
                <th>
                  <a href={sortHref('order')} class="hover:text-brand-fg">شماره{arrow('order')}</a>
                </th>
                <th>شناسه یکتا</th>
                <th>
                  <a href={sortHref('email')} class="hover:text-brand-fg">مشتری{arrow('email')}</a>
                </th>
                <th>روش پرداخت</th>
                <th>
                  <a href={sortHref('total')} class="hover:text-brand-fg">مبلغ کل{arrow('total')}</a>
                </th>
                <th>
                  <a href={sortHref('status')} class="hover:text-brand-fg">وضعیت پرداخت{arrow('status')}</a>
                </th>
                <th>
                  <a href={sortHref('fulfillment')} class="hover:text-brand-fg">تحویل{arrow('fulfillment')}</a>
                </th>
                <th>
                  <a href={sortHref('when')} class="hover:text-brand-fg">تاریخ ثبت{arrow('when')}</a>
                </th>
              </tr>
            </thead>
            <tbody>
              {
                orders.map((o) => {
                  const st = STATUS_BADGE[o.status] ?? { label: o.status, cls: 'gg-status-info' };
                  const ful = FULFILL_BADGE[o.fulfillment_status] ?? { label: o.fulfillment_status, cls: 'gg-status-warning' };
                  return (
                    <tr>
                      <td>
                        <a href={`/admin/orders/${o.public_id}`} class="ltr-inline font-mono text-xs font-bold text-brand-fg hover:underline">
                          #{o.id}
                        </a>
                      </td>
                      <td>
                        <a
                          href={`/admin/orders/${o.public_id}`}
                          title={o.public_id ?? undefined}
                          class="ltr-inline font-mono text-xs text-ink hover:text-brand-fg hover:underline"
                        >
                          {o.public_id ? truncatePublicId(o.public_id, 'order') : '—'}
                        </a>
                      </td>
                      <td class="max-w-[12rem] truncate text-xs">
                        {o.email ? (
                          <a
                            href={`/admin/customers/${encodeURIComponent(o.email)}`}
                            title={o.email}
                            class="ltr-inline text-muted hover:text-brand-fg hover:underline"
                          >
                            {o.email}
                          </a>
                        ) : (
                          '—'
                        )}
                      </td>
                      <td class="text-xs text-muted">
                        {o.payment_method ? (METHOD_LABELS[o.payment_method] ?? o.payment_method) : '—'}
                      </td>
                      <td class="font-bold text-ink">
                        {formatPrice(o.amount_total_cents, o.currency)}
                      </td>
                      <td>
                        <span class={`rounded-md px-2 py-0.5 text-[11px] font-semibold ${st.cls}`}>
                          {st.label}
                        </span>
                      </td>
                      <td>
                        <span class={`rounded-md px-2 py-0.5 text-[11px] font-semibold ${ful.cls}`}>
                          {ful.label}
                        </span>
                      </td>
                      <td class="whitespace-nowrap text-xs text-muted">
                        {formatJalaliDateTime(o.created_at, { timeZone })}
                      </td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
        </div>
      </div>
    )
  }

  <div class="mt-6">
    <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
  </div>
</AdminLayout>
