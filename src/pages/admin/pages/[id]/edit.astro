---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../../components/admin/AdminPageHeader.astro';
import MediaPicker from '../../../../features/media/MediaPicker.astro';
import { getPageByPublicId } from '../../../../features/pages/db';
import {
  PAGE_LAYOUT_OPTIONS,
  normalizePageLayout,
} from '../../../../features/pages/layouts';
import { parsePublicId } from '../../../../features/ids/publicId';

const publicId = parsePublicId(Astro.params.id, 'page');
const page = publicId ? await getPageByPublicId(env.DB, publicId) : null;
if (!page) return new Response('صفحه یافت نشد', { status: 404 });

const error = Astro.url.searchParams.get('error');
const warning = Astro.url.searchParams.get('warning');
const saved = Astro.url.searchParams.has('saved');
const currentLayout = normalizePageLayout(page.layout);

const PLACEHOLDER = `## عنوان بخش

متن صفحه را با سینتکس Markdown بنویسید.

**متن پررنگ**  _متن کج_  \`کد\`

- مورد اول فهرست
- مورد دوم فهرست

> نقل‌قول یا نکته مهم

[متن لینک](https://example.com)`;

const tools = [
  { action: 'prefix', value: '## ', label: 'H2', title: 'تیتر بخش' },
  { action: 'wrap', value: '**', label: 'B', title: 'ضخیم' },
  { action: 'wrap', value: '_', label: 'I', title: 'کج' },
  { action: 'link', value: '', label: 'لینک', title: 'درج پیوند' },
  { action: 'prefix', value: '- ', label: 'فهرست', title: 'فهرست نقطه‌ای' },
  { action: 'prefix', value: '1. ', label: '۱.', title: 'فهرست شماره‌دار' },
  { action: 'prefix', value: '> ', label: 'نقل‌قول', title: 'نقل‌قول' },
  { action: 'wrap', value: '`', label: 'کد', title: 'کد درون‌خطی' },
];
---

<AdminLayout
  title={`ویرایش صفحه — ${page.title}`}
  active="pages"
  requiredPermission="content.manage"
  breadcrumbs={[
    { label: 'محتوا و فروشگاه' },
    { label: 'صفحات محتوایی', href: '/admin/pages' },
    { label: page.title },
  ]}
>
  <AdminPageHeader title={`ویرایش: ${page.title}`} subtitle={`نشانی صفحه: /pages/${page.slug}`}>
    <div slot="actions" class="flex flex-wrap items-center gap-2">
      {
        page.published !== 0 && (
          <a
            href={`/pages/${page.slug}`}
            target="_blank"
            rel="noopener"
            class="gg-admin-btn-secondary text-xs"
          >
            مشاهده در فروشگاه ↗
          </a>
        )
      }
      <a href="/admin/pages" class="gg-admin-btn-secondary text-xs">
        بازگشت به صفحات ←
      </a>
    </div>
  </AdminPageHeader>

  {error && <div class="gg-status-error mb-6 rounded-xl px-4 py-3 text-sm">{error}</div>}
  {warning && <div class="gg-status-warning mb-6 rounded-xl px-4 py-3 text-sm">{warning}</div>}
  {saved && !warning && (
    <div class="gg-status-success mb-6 rounded-xl px-4 py-3 text-sm">
      تغییرات صفحه با موفقیت ذخیره شد.
    </div>
  )}

  <form method="POST" action={`/api/admin/pages/${page.public_id}`} data-page-form class="space-y-6">
    <div class="gg-admin-card grid gap-4 p-5 sm:grid-cols-2">
      <div>
        <label for="edit-page-title" class="mb-1 block text-xs font-semibold text-muted">
          عنوان صفحه *
        </label>
        <input
          id="edit-page-title"
          type="text"
          name="title"
          value={page.title}
          required
          maxlength="120"
          class="gg-admin-input py-2 text-sm"
        />
      </div>
      <div>
        <label for="edit-page-slug" class="mb-1 block text-xs font-semibold text-muted">
          نامک نشانی (Slug)
        </label>
        <input
          id="edit-page-slug"
          type="text"
          name="slug"
          dir="ltr"
          value={page.slug}
          class="gg-admin-input ltr-inline py-2 font-mono text-sm"
        />
      </div>
    </div>

    <div class="gg-admin-card overflow-hidden">
      <div
        data-modes
        hidden
        role="group"
        aria-label="نمای ویرایشگر"
        class="flex items-center gap-1 border-b border-line px-3 py-2"
      >
        <button
          type="button"
          data-mode="write"
          class="rounded-lg px-3 py-1.5 text-xs font-semibold text-muted"
          aria-pressed="false"
        >
          ویرایشگر Markdown
        </button>
        <button
          type="button"
          data-mode="split"
          class="rounded-lg px-3 py-1.5 text-xs font-semibold text-muted"
          aria-pressed="false"
        >
          نمای دوتایی (همزمان)
        </button>
        <button
          type="button"
          data-mode="preview"
          class="rounded-lg px-3 py-1.5 text-xs font-semibold text-muted"
          aria-pressed="false"
        >
          پیش‌نمایش
        </button>
      </div>

      <div data-panes class="lg:divide-x lg:divide-line lg:divide-x-reverse">
        <div data-pane="write" class="flex min-w-0 flex-col">
          <div
            data-toolbar
            class="flex min-h-11 flex-wrap items-center gap-1 border-b border-line px-2 py-1"
          >
            {
              tools.map((tool) => (
                <button
                  type="button"
                  data-tool={tool.action}
                  data-value={tool.value}
                  title={tool.title}
                  class="rounded px-2.5 py-1 text-xs font-semibold text-muted hover:bg-surface-2 hover:text-brand-fg"
                >
                  {tool.label}
                </button>
              ))
            }
            <MediaPicker
              id="page-body"
              label="درج تصویر"
              buttonClass="rounded px-2.5 py-1 text-xs font-semibold text-muted hover:bg-surface-2 hover:text-brand-fg"
            />
          </div>

          <textarea
            name="body_markdown"
            data-editor
            rows="22"
            spellcheck="true"
            placeholder={PLACEHOLDER}
            class="block w-full flex-1 resize-none overflow-hidden border-0 bg-transparent px-4 py-3 text-sm leading-relaxed text-ink focus:outline-none"
          >{page.body_markdown}</textarea>
        </div>

        <div data-pane="preview" hidden class="min-w-0 border-t border-line lg:border-t-0">
          <div class="flex h-11 items-center justify-between border-b border-line px-4 text-xs text-muted">
            <span>پیش‌نمایش سمت سرور (بدون اجرای HTML خام)</span>
            <span data-preview-status class="text-faint"></span>
          </div>
          <div data-preview class="overflow-x-auto px-4 py-4"></div>
        </div>
      </div>
    </div>

    <div class="gg-admin-card grid gap-4 p-5 sm:grid-cols-2 sm:items-end">
      <div>
        <label for="layout-select" class="mb-1 block text-xs font-semibold text-muted">
          چیدمان نمایش صفحه (Layout)
        </label>
        <select id="layout-select" name="layout" data-layout-select class="gg-admin-input py-2 text-sm">
          {
            PAGE_LAYOUT_OPTIONS.map((option) => (
              <option
                value={option.key}
                data-hint={option.hint}
                selected={option.key === currentLayout}
              >
                {option.label}
              </option>
            ))
          }
        </select>
        <p data-layout-hint class="mt-1 text-[11px] text-faint">
          {PAGE_LAYOUT_OPTIONS.find((o) => o.key === currentLayout)?.hint}
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4">
        <label class="inline-flex items-center gap-2 text-xs font-semibold text-ink">
          <input type="checkbox" name="published" checked={page.published !== 0} class="h-4 w-4 rounded border-line text-brand" />
          انتشار در فروشگاه و نقشه سایت
        </label>

        <button type="submit" class="gg-admin-btn-primary text-xs">
          ذخیره تغییرات صفحه
        </button>
      </div>
    </div>
  </form>

  {/* دیالوگ درج توضیح تصویر به جای window.prompt */}
  <dialog
    data-alt-dialog
    class="rounded-2xl border border-line bg-surface p-0 text-ink shadow-xl backdrop:bg-black/55"
  >
    <div class="w-[min(90vw,26rem)] space-y-4 p-5">
      <h3 class="text-sm font-bold text-ink">توضیح جایگزین تصویر (Alt Text)</h3>
      <p class="text-xs text-muted">یک عبارت کوتاه برای سئو و دسترس‌پذیری تصویر وارد کنید:</p>
      <input
        type="text"
        data-alt-input
        placeholder="مثال: راهنمای فعال‌سازی گیفت‌کارت"
        class="gg-admin-input py-2 text-xs"
      />
      <div class="flex items-center justify-end gap-2">
        <button type="button" data-alt-cancel class="gg-admin-btn-secondary py-1.5 text-xs">انصراف</button>
        <button type="button" data-alt-confirm class="gg-admin-btn-primary py-1.5 text-xs">درج تصویر</button>
      </div>
    </div>
  </dialog>
</AdminLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-page-form]');
  const editor = form?.querySelector<HTMLTextAreaElement>('[data-editor]');
  const preview = form?.querySelector<HTMLElement>('[data-preview]');
  const altDialog = document.querySelector<HTMLDialogElement>('[data-alt-dialog]');
  const altInput = altDialog?.querySelector<HTMLInputElement>('[data-alt-input]');
  const altCancel = altDialog?.querySelector<HTMLButtonElement>('[data-alt-cancel]');
  const altConfirm = altDialog?.querySelector<HTMLButtonElement>('[data-alt-confirm]');

  if (form && editor && preview) {
    const replaceSelection = (text: string, selectFrom: number, selectTo: number) => {
      const { selectionStart: start, selectionEnd: end } = editor;
      editor.setRangeText(text, start, end, 'preserve');
      editor.focus();
      editor.setSelectionRange(start + selectFrom, start + selectTo);
      editor.dispatchEvent(new Event('input', { bubbles: true }));
    };

    const selected = () => editor.value.slice(editor.selectionStart, editor.selectionEnd);

    form.querySelector('[data-toolbar]')?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-tool]');
      if (!button) return;
      const kind = button.dataset.tool;
      const value = button.dataset.value ?? '';
      const text = selected();

      if (kind === 'wrap') {
        replaceSelection(`${value}${text}${value}`, value.length, value.length + text.length);
      } else if (kind === 'prefix') {
        const body = (text || '').split('\n').map((line) => `${value}${line}`).join('\n');
        replaceSelection(body, 0, body.length);
      } else if (kind === 'link') {
        const label = text || 'متن لینک';
        const md = `[${label}](https://)`;
        replaceSelection(md, md.length - 1, md.length - 1);
      }
    });

    let pendingImageKey: string | null = null;
    const insertImageWithAlt = (imageKey: string, rawAlt: string) => {
      const alt = rawAlt.replace(/([\\[\]])/g, '\\$1');
      const md = `![${alt}](/images/${imageKey})`;
      replaceSelection(md, 2, 2 + alt.length);
    };

    document.addEventListener('media:selected', (event) => {
      const detail = (event as CustomEvent).detail as { imageKey: string; url: string };
      if (altDialog && typeof altDialog.showModal === 'function' && altInput) {
        pendingImageKey = detail.imageKey;
        altInput.value = '';
        altDialog.showModal();
        altInput.focus();
      } else {
        insertImageWithAlt(detail.imageKey, '');
      }
    });

    altCancel?.addEventListener('click', () => {
      pendingImageKey = null;
      altDialog?.close();
    });
    altConfirm?.addEventListener('click', () => {
      if (pendingImageKey) {
        insertImageWithAlt(pendingImageKey, altInput?.value ?? '');
      }
      pendingImageKey = null;
      altDialog?.close();
    });

    const status = form.querySelector<HTMLElement>('[data-preview-status]');
    const previewPane = form.querySelector<HTMLElement>('[data-pane="preview"]');
    const writePane = form.querySelector<HTMLElement>('[data-pane="write"]');
    const layoutSelect = form.querySelector('[data-layout-select]') as HTMLSelectElement | null;
    const panes = form.querySelector<HTMLElement>('[data-panes]');
    const modeBar = form.querySelector<HTMLElement>('[data-modes]');
    const MODE_KEY = 'minshop:page-editor-mode';

    let inFlight: AbortController | null = null;
    let lastRendered: string | null = null;
    let timer: number | undefined;

    const previewVisible = () => !!previewPane?.offsetParent;

    const render = async () => {
      if (!previewVisible()) return;
      const markdown = editor.value;
      const key = `${layoutSelect?.value ?? ''} ${markdown}`;
      if (key === lastRendered) return;

      inFlight?.abort();
      const controller = new AbortController();
      inFlight = controller;
      if (status) status.textContent = 'در حال رندر…';

      const body = new FormData();
      body.append('body_markdown', markdown);
      if (layoutSelect) body.append('layout', layoutSelect.value);
      try {
        const res = await fetch('/api/admin/pages/preview', {
          method: 'POST',
          body,
          signal: controller.signal,
        });
        if (!res.ok) throw new Error(`خطای پیش‌نمایش (${res.status})`);
        preview.innerHTML = await res.text();
        lastRendered = key;
        if (status) status.textContent = '';
      } catch (err) {
        if (controller.signal.aborted) return;
        if (status) status.textContent = '';
        preview.textContent = err instanceof Error ? err.message : 'خطا در رندر پیش‌نمایش.';
      } finally {
        if (inFlight === controller) inFlight = null;
      }
    };

    const minRowsHeight = () => {
      const cs = getComputedStyle(editor);
      const line = parseFloat(cs.lineHeight) || 20;
      const rows = Number(editor.rows) || 10;
      return rows * line + parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
    };

    const autosize = () => {
      if (!editor.offsetParent) return;
      editor.style.minHeight = '0px';
      editor.style.minHeight = `${Math.max(editor.scrollHeight, minRowsHeight())}px`;
    };

    const scheduleRender = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(render, 350);
    };

    editor.addEventListener('input', () => {
      autosize();
      scheduleRender();
    });
    layoutSelect?.addEventListener('change', scheduleRender);
    window.addEventListener('resize', autosize);

    const modeButtons = form.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const setMode = (mode: string) => {
      modeButtons.forEach((button) => {
        const active = button.dataset.mode === mode;
        button.setAttribute('aria-pressed', String(active));
        button.classList.toggle('bg-brand-soft', active);
        button.classList.toggle('text-brand-fg', active);
        button.classList.toggle('text-muted', !active);
      });
      if (writePane) writePane.hidden = mode === 'preview';
      if (previewPane) previewPane.hidden = mode === 'write';
      panes?.classList.toggle('lg:grid', mode === 'split');
      panes?.classList.toggle('lg:grid-cols-2', mode === 'split');
      try {
        localStorage.setItem(MODE_KEY, mode);
      } catch {
        // ignore storage restrictions
      }
      if (mode !== 'write') render();
      autosize();
    };

    modeButtons.forEach((button) =>
      button.addEventListener('click', () => setMode(button.dataset.mode!)),
    );
    if (modeBar) modeBar.hidden = false;

    let initial = 'split';
    try {
      const stored = localStorage.getItem(MODE_KEY);
      if (stored === 'write' || stored === 'split' || stored === 'preview') initial = stored;
    } catch {
      // ignore
    }
    setMode(initial);

    const layoutHint = form.querySelector<HTMLElement>('[data-layout-hint]');
    layoutSelect?.addEventListener('change', () => {
      const hint = layoutSelect.selectedOptions[0]?.dataset.hint;
      if (layoutHint && hint) layoutHint.textContent = hint;
    });
  }
</script>

<style is:global>
  [data-preview] [data-source-line] {
    cursor: pointer;
    border-radius: 2px;
  }
  [data-preview] [data-source-line]:hover {
    background: rgba(108, 92, 231, 0.08);
  }
</style>
