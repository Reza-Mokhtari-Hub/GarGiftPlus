---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import AdminEmptyState from '../../../components/admin/AdminEmptyState.astro';
import { getConfig } from '../../../config';
import { listPages } from '../../../features/pages/db';
import { menuReferencesFor } from '../../../features/navigation/admin';
import { formatJalaliDate, toPersianDigits } from '../../../lib/format';

const pages = await listPages(env.DB);
const menuRefs = await menuReferencesFor(
  env.DB,
  'page',
  pages.map((p) => p.id),
);
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;
---

<AdminLayout
  title="صفحات محتوایی"
  active="pages"
  requiredPermission="content.manage"
  breadcrumbs={[{ label: 'محتوا و فروشگاه' }, { label: 'صفحات محتوایی' }]}
>
  <AdminPageHeader
    title="مدیریت صفحات محتوایی"
    subtitle="ایجاد و ویرایش صفحات قوانین، درباره ما، راهنمای خرید و حریم خصوصی با ویرایشگر Markdown"
    badge={`${toPersianDigits(pages.length)} صفحه`}
  >
    <a slot="actions" href="/admin/pages/new" class="gg-admin-btn-primary text-xs">
      + ایجاد صفحه جدید
    </a>
  </AdminPageHeader>

  <section class="gg-admin-card overflow-hidden p-5">
    {
      pages.length === 0 ? (
        <AdminEmptyState
          title="هنوز صفحه محتوایی ایجاد نشده است"
          description="صفحاتی مانند قوانین خرید، سوالات متداول یا درباره گارگیفت+ را ایجاد کرده و به منو اضافه کنید."
          actionLabel="ایجاد اولین صفحه"
          actionHref="/admin/pages/new"
        />
      ) : (
        <div class="overflow-x-auto">
          <table class="gg-admin-table">
            <thead>
              <tr>
                <th>عنوان صفحه</th>
                <th>نشانی (URL)</th>
                <th>وضعیت</th>
                <th>آخرین ویرایش</th>
                <th class="text-end">عملیات</th>
              </tr>
            </thead>
            <tbody>
              {pages.map((page) => (
                <tr>
                  <td>
                    <a
                      href={`/admin/pages/${page.public_id}/edit`}
                      class="font-semibold text-ink hover:text-brand-fg hover:underline"
                    >
                      {page.title}
                    </a>
                  </td>
                  <td>
                    <span class="ltr-inline font-mono text-xs text-muted">/pages/{page.slug}</span>
                  </td>
                  <td>
                    <span
                      class={`rounded-md px-2 py-0.5 text-[11px] font-semibold ${
                        page.published ? 'gg-status-success' : 'bg-surface-2 text-muted'
                      }`}
                    >
                      {page.published ? 'منتشرشده' : 'پیش‌نویس'}
                    </span>
                  </td>
                  <td class="text-xs text-muted">
                    {formatJalaliDate(page.updated_at, { timeZone })}
                  </td>
                  <td class="text-end">
                    <div class="inline-flex items-center gap-2">
                      {page.published !== 0 && (
                        <a
                          href={`/pages/${page.slug}`}
                          target="_blank"
                          rel="noopener"
                          class="gg-admin-btn-secondary py-1 text-xs"
                        >
                          مشاهده
                        </a>
                      )}
                      <a
                        href={`/admin/pages/${page.public_id}/edit`}
                        class="gg-admin-btn-secondary py-1 text-xs"
                      >
                        ویرایش
                      </a>
                      <form
                        method="POST"
                        action={`/api/admin/pages/${page.public_id}`}
                        data-confirm-message={
                          menuRefs.has(page.id)
                            ? `صفحه «${page.title}» در منوی ناوبری فروشگاه لینک شده است. با حذف آن لینک منو مخفی می‌شود؛ ادامه می‌دهید؟`
                            : `آیا از حذف صفحه «${page.title}» اطمینان دارید؟`
                        }
                      >
                        <input type="hidden" name="_action" value="delete" />
                        <button type="submit" class="gg-admin-btn-danger py-1 text-xs">
                          حذف
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</AdminLayout>
