---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';

const error = Astro.url.searchParams.get('error');
---

<AdminLayout
  title="ایجاد صفحه جدید"
  active="pages"
  requiredPermission="content.manage"
  breadcrumbs={[
    { label: 'محتوا و فروشگاه' },
    { label: 'صفحات محتوایی', href: '/admin/pages' },
    { label: 'صفحه جدید' },
  ]}
>
  <AdminPageHeader
    title="ایجاد صفحه محتوایی جدید"
    subtitle="پس از ساخت پیش‌نویس، وارد ویرایشگر کامل Markdown و پیش‌نمایش زنده خواهید شد."
  >
    <a slot="actions" href="/admin/pages" class="gg-admin-btn-secondary text-xs">
      بازگشت به صفحات ←
    </a>
  </AdminPageHeader>

  {error && <div class="gg-status-error mb-6 rounded-xl px-4 py-3 text-sm">{error}</div>}

  <form method="POST" action="/api/admin/pages" class="gg-admin-card max-w-xl space-y-4 p-6">
    <div>
      <label for="page-title" class="mb-1 block text-xs font-semibold text-muted">
        عنوان صفحه *
      </label>
      <input
        id="page-title"
        type="text"
        name="title"
        required
        maxlength="120"
        autofocus
        placeholder="مثال: قوانین و شرایط استفاده"
        class="gg-admin-input py-2 text-sm"
      />
    </div>

    <div>
      <label for="page-slug" class="mb-1 block text-xs font-semibold text-muted">
        نامک نشانی (Slug - اختیاری)
      </label>
      <input
        id="page-slug"
        type="text"
        name="slug"
        dir="ltr"
        placeholder="terms"
        class="gg-admin-input ltr-inline py-2 font-mono text-sm"
      />
      <p class="mt-1 text-[11px] text-faint">
        در صورت خالی بودن، به‌صورت خودکار از روی عنوان ساخته می‌شود. آدرس نهایی: <span class="ltr-inline font-mono">/pages/&lt;slug&gt;</span>
      </p>
    </div>

    <div class="pt-2">
      <button type="submit" class="gg-admin-btn-primary text-xs">
        ایجاد پیش‌نویس و ورود به ویرایشگر
      </button>
    </div>
  </form>
</AdminLayout>
