---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import MediaPicker from '../../../../features/media/MediaPicker.astro';
import ProductForm from '../../../../features/products/ProductForm.astro';
import { getProductByPublicId, listProductImages } from '../../../../features/products/db';
import { listProductCheckoutFields } from '../../../../features/products/customFieldsDb';
import { parsePublicId } from '../../../../features/ids/publicId';
import { listVariants, listExtras } from '../../../../features/products/variants';
import {
  listCategories,
  buildTree,
  flattenTree,
  categoriesForProduct,
} from '../../../../features/categories/db';
import { toMajorUnits, minorUnitsPerMajor, getConfig, currencyDecimals } from '../../../../config';
import { productImageSources } from '../../../../features/products/image';
import { zonesRequireWeight } from '../../../../features/shipping/calculator';
import { formatWeightValue } from '../../../../features/shipping/weight';
import { shippingFor } from '../../../../features/shipping/effective';
import { fa } from '../../../../i18n/fa';
import { toPersianDigits } from '../../../../lib/format';

const publicId = parsePublicId(Astro.params.id, 'product');
const product = publicId ? await getProductByPublicId(env.DB, publicId) : null;

if (!product) {
  return new Response('Not found', { status: 404 });
}

const categoryOptions = flattenTree(buildTree(await listCategories(env.DB)));
const selectedCategoryIds = (await categoriesForProduct(env.DB, product.id)).map((c) => c.id);
const images = await listProductImages(env.DB, product.id);
const checkoutFields = await listProductCheckoutFields(env.DB, product.id, true);
const error = Astro.url.searchParams.get('error');
const notice = Astro.url.searchParams.get('notice');

const variants = await listVariants(env.DB, product.id, true);
const extras = await listExtras(env.DB, product.id, true);

const imgBase = getConfig().images.baseUrl;
const imageDelivery = Astro.locals.settings?.imageDelivery;
const thumbnailSources = (imageKey: string | null, sizes = '64px') =>
  productImageSources(imageKey, {
    baseUrl: imgBase,
    delivery: imageDelivery,
    usage: 'thumbnail',
    sizes,
  });
const imageViews = images.map((image) => ({
  ...image,
  sources: thumbnailSources(image.image_key, '56px'),
}));
const imageById = new Map(imageViews.map((image) => [image.id, image]));
const mainPhoto = product.image_key ? thumbnailSources(product.image_key).src : null;

const decimals = currencyDecimals(product.currency);
const priceStep = 1 / minorUnitsPerMajor(product.currency);
const major = (cents: number) => toMajorUnits(cents, product.currency).toFixed(decimals);
const currencyCode = product.currency.toUpperCase();
const currencyLabel =
  currencyCode === 'IRT' ? fa.common.toman : currencyCode === 'IRR' ? fa.common.rial : currencyCode;
const weightUnit = Astro.locals.settings?.weightUnit ?? 'g';
const weightRequired = zonesRequireWeight(shippingFor(Astro.locals.settings).config);
const inputFieldCls =
  'rounded-md border border-line bg-paper px-2.5 py-1.5 text-sm text-ink placeholder:text-faint focus:border-brand focus:outline-none';
---

<AdminLayout title={`${fa.common.edit}: ${product.name}`} active="products" requiredPermission="products.manage">
  <a href="/admin/products" class="text-sm font-medium text-faint hover:text-brand-fg">
    &rarr; {fa.admin.products.backToList}
  </a>

  <div class="mt-4 mb-6 flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-extrabold text-ink">{fa.admin.products.editTitle}: {product.name}</h1>
    <div class="flex flex-wrap items-center gap-3">
      <form method="POST" action={`/api/admin/products/${product.public_id}`}>
        <input type="hidden" name="_action" value="duplicate" />
        <button
          type="submit"
          class="rounded-lg border border-line bg-surface px-3.5 py-1.5 text-xs font-semibold text-ink hover:border-brand hover:text-brand-fg"
        >
          {fa.admin.products.duplicateBtn}
        </button>
      </form>
      <a
        href={`/products/${product.slug}`}
        target="_blank"
        rel="noopener"
        class="rounded-lg border border-line bg-surface px-3.5 py-1.5 text-xs font-semibold text-brand-fg hover:border-brand"
      >
        {fa.admin.products.viewInStore} ↗
      </a>
    </div>
  </div>

  {
    notice && (
      <div class="gg-status-success mb-6 rounded-lg border px-4 py-3 text-sm font-medium">
        {notice}
      </div>
    )
  }

  <ProductForm
    action={`/api/admin/products/${product.public_id}`}
    submitLabel={fa.admin.products.saveProduct}
    product={product}
    categoryOptions={categoryOptions}
    selectedCategoryIds={selectedCategoryIds}
    checkoutFields={checkoutFields}
    error={error}
    showImage={false}
    formId="product-form"
    weightUnit={weightUnit}
    weightRequired={weightRequired}
  />

  {/* گالری تصاویر محصول */}
  <section id="gallery" class="mt-12 max-w-3xl scroll-mt-20 rounded-xl border border-line bg-surface p-5">
    <div class="mb-4 flex items-baseline justify-between gap-3">
      <h2 class="text-sm font-bold text-ink">{fa.admin.products.sectionMedia}</h2>
      <span class="text-xs text-faint">تغییرات گالری به‌صورت آنی ذخیره می‌شوند</span>
    </div>

    <form
      method="POST"
      action={`/api/admin/products/${product.public_id}/images`}
      enctype="multipart/form-data"
      class="mb-5 flex flex-wrap items-center gap-3"
    >
      <input type="hidden" name="_action" value="add" />
      <input
        type="file"
        name="images"
        accept="image/*"
        multiple
        class="block w-full text-sm text-muted file:me-3 file:cursor-pointer file:rounded-lg file:border-0 file:bg-brand file:px-4 file:py-2 file:text-xs file:font-semibold file:text-on-brand hover:file:bg-brand-hover sm:w-auto"
      />
      <button
        type="submit"
        class="rounded-lg border border-line bg-paper px-4 py-2 text-xs font-semibold text-ink hover:border-brand hover:text-brand-fg"
      >
        افزودن تصویر
      </button>
    </form>

    <div class="mb-5">
      <MediaPicker id="product-gallery" label="انتخاب از کتابخانه رسانه" />
      <form
        method="POST"
        action={`/api/admin/products/${product.public_id}/images`}
        data-attach-form
        class="hidden"
      >
        <input type="hidden" name="_action" value="attach" />
        <input type="hidden" name="media_id" data-attach-media-id />
      </form>
    </div>

    {
      images.length > 0 && (
        <ul data-gallery data-action={`/api/admin/products/${product.public_id}/images`} class="divide-y divide-line">
          {imageViews.map((img) => (
            <li data-image-id={img.public_id} class="flex flex-wrap items-center gap-3 py-3 sm:flex-nowrap">
              <span
                data-handle
                aria-hidden="true"
                class="shrink-0 cursor-grab text-faint hover:text-ink"
              >
                <svg width="12" height="20" viewBox="0 0 12 20" fill="currentColor">
                  <circle cx="3" cy="4" r="1.5" />
                  <circle cx="9" cy="4" r="1.5" />
                  <circle cx="3" cy="10" r="1.5" />
                  <circle cx="9" cy="10" r="1.5" />
                  <circle cx="3" cy="16" r="1.5" />
                  <circle cx="9" cy="16" r="1.5" />
                </svg>
              </span>

              <div class="flex shrink-0 flex-col text-base leading-none text-faint">
                <form data-js-action="up" method="POST" action={`/api/admin/products/${product.public_id}/images`}>
                  <input type="hidden" name="_action" value="move" />
                  <input type="hidden" name="direction" value="up" />
                  <input type="hidden" name="image_id" value={img.public_id} />
                  <button type="submit" data-up aria-label="انتقال به بالا" class="block px-1 hover:text-brand-fg">
                    ↑
                  </button>
                </form>
                <form data-js-action="down" method="POST" action={`/api/admin/products/${product.public_id}/images`}>
                  <input type="hidden" name="_action" value="move" />
                  <input type="hidden" name="direction" value="down" />
                  <input type="hidden" name="image_id" value={img.public_id} />
                  <button type="submit" data-down aria-label="انتقال به پایین" class="block px-1 hover:text-brand-fg">
                    ↓
                  </button>
                </form>
              </div>

              <div class="relative shrink-0">
                <img
                  src={img.sources.src}
                  srcset={img.sources.srcset}
                  sizes={img.sources.sizes}
                  alt={img.alt ?? ''}
                  class="h-14 w-14 rounded-md object-cover"
                />
                <span
                  data-primary-badge
                  title="تصویر اصلی"
                  class="absolute -top-1.5 -end-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-brand text-[11px] text-on-brand ring-2 ring-surface"
                >
                  ★
                </span>
              </div>

              <form
                data-js-action="alt"
                method="POST"
                action={`/api/admin/products/${product.public_id}/images`}
                class="flex flex-1 items-center gap-2"
              >
                <input type="hidden" name="_action" value="alt" />
                <input type="hidden" name="image_id" value={img.public_id} />
                <input
                  type="text"
                  name="alt"
                  value={img.alt ?? ''}
                  draggable="false"
                  placeholder="متن جایگزین تصویر (Alt)"
                  class="w-full border-b border-line bg-transparent py-1 text-sm text-ink focus:border-brand focus:outline-none"
                />
                <button
                  type="submit"
                  class="shrink-0 text-xs font-medium text-faint hover:text-brand-fg"
                >
                  {fa.common.save}
                </button>
              </form>

              <div class="flex shrink-0 items-center gap-3 text-xs font-medium">
                <form data-js-action="primary" method="POST" action={`/api/admin/products/${product.public_id}/images`}>
                  <input type="hidden" name="_action" value="primary" />
                  <input type="hidden" name="image_id" value={img.public_id} />
                  <button type="submit" data-make-primary class="text-brand-fg hover:underline">
                    تصویر اصلی
                  </button>
                </form>
                <form data-js-action="delete" method="POST" action={`/api/admin/products/${product.public_id}/images`}>
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="image_id" value={img.public_id} />
                  <button type="submit" class="text-red-500 hover:underline">
                    {fa.common.delete}
                  </button>
                </form>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {/* تنوع‌ها و افزودنی‌ها */}
  <section id="options" class="mt-10 max-w-3xl scroll-mt-20 rounded-xl border border-line bg-surface p-5">
    <div class="mb-5">
      <h2 class="text-sm font-bold text-ink">{fa.admin.products.sectionVariants}</h2>
      <p class="mt-1 text-xs text-muted">
        اختیاری. <strong>تنوع‌ها</strong> گزینه‌های قابل انتخاب با قیمت، ریجن، مقدار یا مدت زمان مجزا هستند و
        <strong>افزودنی‌ها</strong> امکانات اضافی قابل تیک زدن با مابه‌التفاوت قیمت‌اند. همه موارد با دکمه «ذخیره تغییرات» ذخیره می‌شوند.
      </p>
    </div>

    <label class="mb-6 flex max-w-xs flex-col gap-1 text-xs font-medium text-muted">
      عنوان گروه تنوع
      <input
        form="product-form"
        type="text"
        name="variant_group_label"
        value={product.variant_label ?? ''}
        placeholder="مثال: ریجن و اعتبار، پلن اشتراک"
        class={inputFieldCls}
      />
    </label>

    <h3 class="mb-3 text-sm font-semibold text-ink">تنوع‌های محصول</h3>
    <div data-variant-rows data-default-price={major(product.price_cents)} class="space-y-4">
      {
        [...variants, null].map((v) => (
          <div
            data-variant-row
            data-blank={v ? undefined : ''}
            class="rounded-xl border border-line bg-paper p-3.5 space-y-3"
          >
            <input form="product-form" type="hidden" name="v_id" value={v?.public_id ?? ''} />
            <input form="product-form" type="hidden" name="v_stock" value={String(v?.stock ?? 0)} />
            <input
              form="product-form"
              type="hidden"
              name="v_active"
              value={v ? (v.active === 1 ? '1' : '0') : '1'}
              data-v-active-value
            />

            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line pb-2">
              <div class="flex items-center gap-2">
                {(() => {
                  const sel = v?.image_id ? imageById.get(v.image_id) : null;
                  return (
                    <div class="relative">
                      <input form="product-form" type="hidden" name="v_image" value={sel?.public_id ?? ''} data-image-input />
                      <button
                        type="button"
                        data-photo-trigger
                        aria-label="انتخاب تصویر تنوع"
                        class="relative block h-11 w-11 shrink-0 overflow-hidden rounded-md border border-line hover:border-brand"
                      >
                        <img
                          data-photo-preview
                          src={sel ? sel.sources.src : (mainPhoto ?? undefined)}
                          alt=""
                          class:list={['h-full w-full object-cover', !sel && !mainPhoto && 'hidden']}
                        />
                        <span
                          data-photo-empty
                          class:list={[
                            'flex h-full w-full items-center justify-center text-center text-[9px] text-faint',
                            (sel || mainPhoto) && 'hidden',
                          ]}
                        >
                          تصویر
                        </span>
                      </button>

                      <div
                        data-palette
                        class="absolute start-0 top-full z-20 mt-1 hidden w-max max-w-[16rem] rounded-lg border border-line bg-surface p-2 shadow-lg"
                      >
                        <div class="flex flex-wrap gap-1.5">
                          <button
                            type="button"
                            data-thumb=""
                            data-src={mainPhoto ?? ''}
                            aria-pressed={!v?.image_id ? 'true' : 'false'}
                            title="تصویر اصلی محصول"
                            class:list={[
                              'relative flex h-11 w-11 items-center justify-center overflow-hidden rounded border border-line text-[9px] text-ink hover:border-brand',
                              !v?.image_id && 'ring-2 ring-brand',
                            ]}
                          >
                            {mainPhoto ? (
                              <img src={mainPhoto} alt="" class="h-full w-full object-cover opacity-70" />
                            ) : null}
                            <span class="absolute inset-0 flex items-center justify-center bg-paper/60 font-semibold">اصلی</span>
                          </button>
                          {imageViews.map((img, idx) => (
                            <button
                              type="button"
                              data-thumb={img.public_id}
                              data-src={img.sources.src}
                              aria-pressed={!!v && img.id === v.image_id ? 'true' : 'false'}
                              title={img.alt?.trim() || `تصویر ${toPersianDigits(idx + 1)}`}
                              class:list={[
                                'h-11 w-11 overflow-hidden rounded border border-line hover:border-brand',
                                !!v && img.id === v.image_id && 'ring-2 ring-brand',
                              ]}
                            >
                              <img src={img.sources.src} alt="" class="h-full w-full object-cover" />
                            </button>
                          ))}
                        </div>
                      </div>
                    </div>
                  );
                })()}
                <span class="text-xs font-semibold text-muted">
                  {v ? v.label : 'تنوع جدید'}
                </span>
              </div>

              <div class="flex items-center gap-2 text-xs">
                <label class="flex items-center gap-1.5 font-medium text-ink">
                  <input
                    type="checkbox"
                    checked={v ? v.active === 1 : true}
                    data-v-active-toggle
                    class="h-4 w-4 accent-[var(--gg-brand)]"
                  />
                  فعال
                </label>
                <button
                  type="button"
                  data-v-up
                  class="rounded border border-line px-2 py-1 text-muted hover:text-ink"
                  title="انتقال به بالا"
                >
                  ▲
                </button>
                <button
                  type="button"
                  data-v-down
                  class="rounded border border-line px-2 py-1 text-muted hover:text-ink"
                  title="انتقال به پایین"
                >
                  ▼
                </button>
                {v && (
                  <input form="product-form" type="checkbox" name="v_remove" value={v.public_id} class="hidden" data-remove-mark />
                )}
                <button
                  type="button"
                  data-remove-row
                  class="hidden px-2 py-1 text-xs font-medium text-red-500 hover:underline"
                >
                  {fa.common.delete}
                </button>
              </div>
            </div>

            <div class="grid gap-3 sm:grid-cols-4">
              <label class="flex flex-col gap-1 text-xs font-medium text-muted sm:col-span-2">
                عنوان تنوع *
                <input
                  form="product-form"
                  type="text"
                  name="v_label"
                  value={v?.label ?? ''}
                  placeholder="مثال: ۱۰ دلاری آمریکا"
                  class={inputFieldCls}
                />
              </label>

              <label class="flex flex-col gap-1 text-xs font-medium text-muted">
                قیمت ({currencyLabel}) *
                <input
                  form="product-form"
                  type="number"
                  name="v_price"
                  min="0"
                  step={priceStep}
                  value={v ? major(v.price_cents) : major(product.price_cents)}
                  placeholder="0"
                  class={`${inputFieldCls} ltr-inline tabular-nums`}
                />
              </label>

              <label class="flex flex-col gap-1 text-xs font-medium text-muted">
                قیمت قبلی ({currencyLabel})
                <input
                  form="product-form"
                  type="number"
                  name="v_compare_price"
                  min="0"
                  step={priceStep}
                  value={v?.compare_price_cents != null && v.compare_price_cents > 0 ? major(v.compare_price_cents) : ''}
                  placeholder="اختیاری"
                  class={`${inputFieldCls} ltr-inline tabular-nums`}
                />
              </label>

              <label class="flex flex-col gap-1 text-xs font-medium text-muted">
                ریجن / سرور
                <input
                  form="product-form"
                  type="text"
                  name="v_region"
                  value={v?.region ?? ''}
                  placeholder="مثال: آمریکا / گلوبال"
                  class={inputFieldCls}
                />
              </label>

              <label class="flex flex-col gap-1 text-xs font-medium text-muted">
                مقدار / اعتبار
                <input
                  form="product-form"
                  type="text"
                  name="v_amount"
                  value={v?.amount_label ?? ''}
                  placeholder="مثال: 660 UC یا 10$"
                  class={inputFieldCls}
                />
              </label>

              <label class="flex flex-col gap-1 text-xs font-medium text-muted">
                مدت اعتبار / پلن
                <input
                  form="product-form"
                  type="text"
                  name="v_duration"
                  value={v?.duration_label ?? ''}
                  placeholder="مثال: ۱ ماهه"
                  class={inputFieldCls}
                />
              </label>

              <label class="flex flex-col gap-1 text-xs font-medium text-muted">
                کد اختصاصی (SKU)
                <input
                  form="product-form"
                  type="text"
                  name="v_sku"
                  value={v?.sku ?? ''}
                  placeholder="اختیاری"
                  class={`${inputFieldCls} ltr-inline font-mono`}
                />
              </label>

              {product.requires_shipping === 1 && (
                <label class="flex flex-col gap-1 text-xs font-medium text-muted">
                  وزن ({weightUnit})
                  <input
                    form="product-form"
                    type="text"
                    name="v_weight"
                    inputmode="decimal"
                    value={v?.weight_grams != null ? formatWeightValue(v.weight_grams, weightUnit) : ''}
                    placeholder="پیش‌فرض محصول"
                    class={`${inputFieldCls} ltr-inline`}
                  />
                </label>
              )}
            </div>
          </div>
        ))
      }
    </div>
    <button
      type="button"
      data-add-variant
      class="mt-3 mb-8 hidden rounded-lg border border-line bg-paper px-4 py-2 text-xs font-semibold text-ink hover:border-brand hover:text-brand-fg"
    >
      + افزودن تنوع جدید
    </button>

    <h3 class="mb-3 text-sm font-semibold text-ink">{fa.product.addons}</h3>
    <div data-extra-rows class="space-y-3">
      {
        [...extras, null].map((ex) => (
          <div data-extra-row data-blank={ex ? undefined : ''} class="flex flex-wrap items-end gap-3 rounded-lg border border-line bg-paper p-3">
            <input form="product-form" type="hidden" name="e_id" value={ex?.public_id ?? ''} />
            <label class="flex flex-col gap-1 text-xs font-medium text-muted">
              عنوان افزودنی
              <input
                form="product-form"
                type="text"
                name="e_label"
                value={ex?.label ?? ''}
                placeholder="مثال: تحویل فوق‌سریع یا فعال‌سازی کامل"
                class={`${inputFieldCls} w-56`}
              />
            </label>
            <label class="flex flex-col gap-1 text-xs font-medium text-muted">
              مابه‌التفاوت قیمت ({currencyLabel})
              <input
                form="product-form"
                type="number"
                name="e_price"
                min="0"
                step={priceStep}
                value={ex ? major(ex.price_delta_cents) : ''}
                placeholder="0"
                class={`${inputFieldCls} w-32 ltr-inline tabular-nums`}
              />
            </label>
            {ex && (
              <input form="product-form" type="checkbox" name="e_remove" value={ex.public_id} class="hidden" data-remove-mark />
            )}
            <button
              type="button"
              data-remove-row
              class="hidden pb-1.5 text-xs font-medium text-red-500 hover:underline"
            >
              {fa.common.delete}
            </button>
          </div>
        ))
      }
    </div>
    <button
      type="button"
      data-add-extra
      class="mt-3 hidden rounded-lg border border-line bg-paper px-4 py-2 text-xs font-semibold text-ink hover:border-brand hover:text-brand-fg"
    >
      + افزودن گزینه اضافی
    </button>

    <div class="mt-8 border-t border-line pt-5">
      <button
        type="submit"
        form="product-form"
        class="rounded-lg bg-brand px-6 py-2.5 text-sm font-semibold text-on-brand hover:bg-brand-hover"
      >
        {fa.admin.products.saveProduct}
      </button>
    </div>
  </section>

  {/* اسکریپت گالری */}
  <script>
    // @ts-nocheck
    const list = document.querySelector('[data-gallery]');
    if (list instanceof HTMLElement) {
      const action = list.dataset.action || '';
      const rows = () =>
        Array.from(list.children).filter((el) => el instanceof HTMLElement);
      const send = (params) =>
        fetch(action, {
          method: 'POST',
          headers: { 'content-type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(params),
        });
      const persistOrder = () => {
        const p = new URLSearchParams();
        p.set('_action', 'reorder');
        for (const li of rows()) p.append('order', li.dataset.imageId || '');
        return send(p);
      };

      let dragging = null;
      for (const li of rows()) {
        li.setAttribute('draggable', 'true');
        li.addEventListener('dragstart', () => {
          dragging = li;
          li.classList.add('dragging');
        });
        li.addEventListener('dragend', () => {
          li.classList.remove('dragging');
          dragging = null;
          persistOrder();
        });
      }
      list.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (!dragging) return;
        const after = rows().find((el) => {
          if (el === dragging) return false;
          const r = el.getBoundingClientRect();
          return r.top + r.height / 2 >= e.clientY;
        });
        list.insertBefore(dragging, after || null);
      });

      list.addEventListener('submit', async (e) => {
        const form = e.target;
        if (!(form instanceof HTMLFormElement) || !form.dataset.jsAction) return;
        e.preventDefault();
        const type = form.dataset.jsAction;
        const li = form.closest('li');
        if (!li) return;
        if (type === 'up' && li.previousElementSibling) {
          list.insertBefore(li, li.previousElementSibling);
          await persistOrder();
        } else if (type === 'down' && li.nextElementSibling) {
          list.insertBefore(li.nextElementSibling, li);
          await persistOrder();
        } else if (type === 'primary') {
          list.insertBefore(li, list.firstElementChild);
          await persistOrder();
        } else if (type === 'delete') {
          if (!confirm('این تصویر حذف شود؟')) return;
          await send({ _action: 'delete', image_id: li.dataset.imageId });
          li.remove();
        } else if (type === 'alt') {
          await send(new FormData(form));
          const btn = form.querySelector('button[type="submit"]');
          if (btn) {
            const original = btn.textContent;
            btn.textContent = 'ذخیره شد';
            setTimeout(() => {
              btn.textContent = original;
            }, 1200);
          }
        }
      });
    }
  </script>

  {/* اسکریپت تنوع‌ها و افزودنی‌ها */}
  <script>
    // @ts-nocheck
    const closeAllPalettes = () => {
      for (const p of document.querySelectorAll('[data-palette]')) p.classList.add('hidden');
    };

    const selectThumb = (row, value) => {
      const input = row.querySelector('[data-image-input]');
      if (input instanceof HTMLInputElement) input.value = value;
      let src = '';
      for (const b of row.querySelectorAll('[data-thumb]')) {
        const on = (b.getAttribute('data-thumb') || '') === value;
        b.classList.toggle('ring-2', on);
        b.classList.toggle('ring-brand', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        if (on) src = b.getAttribute('data-src') || '';
      }
      const preview = row.querySelector('[data-photo-preview]');
      const empty = row.querySelector('[data-photo-empty]');
      if (preview instanceof HTMLImageElement && empty instanceof HTMLElement) {
        if (src) {
          preview.src = src;
          preview.classList.remove('hidden');
          empty.classList.add('hidden');
          empty.classList.remove('flex');
        } else {
          preview.removeAttribute('src');
          preview.classList.add('hidden');
          empty.classList.remove('hidden');
          empty.classList.add('flex');
        }
      }
    };

    const setupRows = (rowsSel, addSel) => {
      const rows = document.querySelector(rowsSel);
      const addBtn = document.querySelector(addSel);
      if (!(rows instanceof HTMLElement) || !(addBtn instanceof HTMLElement)) return;
      const blank = rows.querySelector('[data-blank]');
      if (!(blank instanceof HTMLElement)) return;
      addBtn.classList.remove('hidden');
      blank.remove();

      for (const b of rows.querySelectorAll('[data-remove-row]')) b.classList.remove('hidden');

      rows.addEventListener('change', (e) => {
        const el = e.target;
        if (el instanceof HTMLInputElement && el.hasAttribute('data-v-active-toggle')) {
          const row = el.closest('[data-variant-row]');
          const hiddenVal = row?.querySelector('[data-v-active-value]');
          if (hiddenVal instanceof HTMLInputElement) {
            hiddenVal.value = el.checked ? '1' : '0';
          }
        }
      });

      rows.addEventListener('click', (e) => {
        const el = e.target instanceof Element ? e.target : null;
        if (!el) return;

        const upBtn = el.closest('[data-v-up]');
        if (upBtn) {
          const row = upBtn.closest('[data-variant-row]');
          if (row && row.previousElementSibling) {
            rows.insertBefore(row, row.previousElementSibling);
          }
          return;
        }
        const downBtn = el.closest('[data-v-down]');
        if (downBtn) {
          const row = downBtn.closest('[data-variant-row]');
          if (row && row.nextElementSibling) {
            rows.insertBefore(row.nextElementSibling, row);
          }
          return;
        }

        const trigger = el.closest('[data-photo-trigger]');
        if (trigger) {
          const palette = trigger.parentElement?.querySelector('[data-palette]');
          const isHidden = palette?.classList.contains('hidden');
          closeAllPalettes();
          if (palette && isHidden) palette.classList.remove('hidden');
          return;
        }
        const thumb = el.closest('[data-thumb]');
        if (thumb) {
          const row = thumb.closest('[data-variant-row], [data-extra-row]');
          if (row) selectThumb(row, thumb.getAttribute('data-thumb') || '');
          closeAllPalettes();
          return;
        }
        const rm = el.closest('[data-remove-row]');
        if (rm) {
          const row = rm.closest('[data-variant-row], [data-extra-row]');
          if (!row) return;
          const mark = row.querySelector('[data-remove-mark]');
          if (mark instanceof HTMLInputElement) {
            mark.checked = true;
            row.classList.add('hidden');
          } else {
            row.remove();
          }
        }
      });

      const defaultPrice = rows.dataset.defaultPrice || '';
      addBtn.addEventListener('click', () => {
        const clone = blank.cloneNode(true);
        clone.removeAttribute('data-blank');
        for (const el of clone.querySelectorAll('input, select')) {
          if (el instanceof HTMLSelectElement) el.selectedIndex = 0;
          else if (el instanceof HTMLInputElement) {
            if (el.hasAttribute('data-v-active-toggle')) {
              el.checked = true;
            } else if (el.hasAttribute('data-v-active-value')) {
              el.value = '1';
            } else if (el.name.endsWith('_stock')) {
              el.value = '0';
            } else if (el.name === 'v_price') {
              el.value = defaultPrice;
            } else {
              el.value = '';
            }
          }
        }
        selectThumb(clone, '');
        clone.querySelector('[data-remove-row]')?.classList.remove('hidden');
        rows.appendChild(clone);
        clone.querySelector('input[name$="_label"]')?.focus();
      });
    };
    setupRows('[data-variant-rows]', '[data-add-variant]');
    setupRows('[data-extra-rows]', '[data-add-extra]');

    document.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      if (el && el.closest('[data-palette], [data-photo-trigger]')) return;
      closeAllPalettes();
    });
  </script>
</AdminLayout>

<script>
  document.addEventListener('media:selected', (event) => {
    const detail = (event as CustomEvent).detail as { id: string };
    const form = document.querySelector<HTMLFormElement>('[data-attach-form]');
    const field = form?.querySelector<HTMLInputElement>('[data-attach-media-id]');
    if (!form || !field) return;
    field.value = detail.id ?? '';
    form.submit();
  });
</script>
