  <script is:inline>
    (function () {
      var b = document.querySelector('[data-flash]');
      if (b)
        setTimeout(function () {
          b.style.transition = 'opacity .4s';
          b.style.opacity = '0';
          setTimeout(function () { b.remove(); }, 400);
        }, 3500);
      if (location.search.indexOf('msg=') !== -1)
        history.replaceState(null, '', location.pathname + location.hash);
    })();
  </script>

  <script is:inline>
    (function () {
      if (!window.fetch) return;
      var form = document.querySelector('[data-reindex-form]');
      if (!form) return;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var button = form.querySelector('button[type="submit"]');
        var label = form.querySelector('[data-reindex-label]');
        var status = document.querySelector('[data-reindex-status]');
        var cursor = form.querySelector('input[name="cursor"]');
        var processed = form.querySelector('input[name="processed"]');
        if (button) button.disabled = true;
        if (label) label.textContent = 'در حال بازسازی…';
        if (status) status.textContent = 'در حال شروع…';

        function nextBatch() {
          return fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json', 'X-Requested-With': 'fetch' },
          })
            .then(function (response) {
              return response.json().then(function (data) {
                if (!response.ok) throw new Error(data.error || 'خطا در ایندکس');
                return data;
              });
            })
            .then(function (data) {
              if (status) status.textContent = data.processed + ' / ' + data.total + ' محصول';
              if (data.done) {
                if (cursor) cursor.value = '';
                if (processed) processed.value = '0';
                if (button) button.disabled = false;
                if (label) label.textContent = 'بازسازی کامل ایندکس محصولات';
                if (status) {
                  status.textContent = 'ایندکس ' + data.processed + ' محصول با موفقیت بازسازی شد.';
                  status.className = 'text-xs font-semibold text-accent-fg';
                }
                return;
              }
              if (cursor) cursor.value = data.nextCursor || '';
              if (processed) processed.value = String(data.processed || 0);
              return nextBatch();
            });
        }

        nextBatch().catch(function (error) {
          if (button) button.disabled = false;
          if (label) label.textContent = 'ادامه بازسازی ایندکس';
          if (status) {
            status.textContent = error && error.message ? error.message : 'عملیات ناموفق بود';
            status.className = 'text-xs font-semibold text-coral';
          }
        });
      });
    })();
  </script>

  <script is:inline>
    (function () {
      function syncLightning(sel) {
        var card = sel.closest('form');
        if (!card) return;
        card.querySelectorAll('[data-lightning-when]').forEach(function (block) {
          block.hidden = block.getAttribute('data-lightning-when') !== sel.value;
        });
        card.querySelectorAll('[data-lightning-required-when]').forEach(function (field) {
          var active = field.getAttribute('data-lightning-required-when') === sel.value;
          var stored = field.getAttribute('data-secret-stored') === '1';
          field.required = active && !stored;
        });
      }
      document.addEventListener('change', function (e) {
        var target = e.target;
        if (target && target.matches && target.matches('[data-lightning-backend]')) syncLightning(target);
      });

      function syncProvider(sel) {
        var form = sel.closest('form');
        if (!form) return;
        form.querySelectorAll('[data-email-when]').forEach(function (el) {
          el.hidden = el.getAttribute('data-email-when') !== sel.value;
        });
      }
      document.addEventListener('change', function (e) {
        var t = e.target;
        if (t && t.matches && t.matches('[data-email-provider]')) syncProvider(t);
      });

      if (!window.fetch) return;
      document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!form || !form.matches || !form.matches('[data-email-test]')) return;
        e.preventDefault();
        var btn = form.querySelector('button[type="submit"]');
        var out = form.querySelector('[data-email-test-result]');
        if (btn) btn.disabled = true;
        if (out) { out.textContent = 'در حال ارسال…'; out.className = 'text-xs font-medium text-muted'; }
        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'X-Requested-With': 'fetch' },
        })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (out) {
              out.textContent = d.message || (d.ok ? 'ارسال شد.' : 'ناموفق بود.');
              out.className = 'text-xs font-semibold ' + (d.ok ? 'text-accent-fg' : 'text-coral');
            }
          })
          .catch(function () {
            if (out) { out.textContent = 'ارسال درخواست با خطا مواجه شد.'; out.className = 'text-xs font-semibold text-coral'; }
          })
          .then(function () { if (btn) btn.disabled = false; });
      });
    })();
  </script>
</AdminLayout>

<script>
  document.addEventListener('media:selected', (event) => {
    const field = document.querySelector<HTMLInputElement>('[data-logo-key]');
    if (!field) return;
    field.value = (event as CustomEvent).detail.imageKey;
    field.form?.submit();
  });

  document.querySelector('[data-logo-remove]')?.addEventListener('click', (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const field = button.form?.querySelector<HTMLInputElement>('[data-logo-key]');
    if (field) field.value = '';
  });
</script>

