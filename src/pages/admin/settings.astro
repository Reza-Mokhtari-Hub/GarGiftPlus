---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import MediaPicker from '../../features/media/MediaPicker.astro';
import { setLogoFromMedia } from '../../features/media/db';
import { homeTargetIsValid } from '../../features/settings/home';
import { listPublishedPageOptions, getPageByPublicId } from '../../features/pages/db';
import {
  listProducts,
  getProductsByIds,
  getProductByPublicId,
} from '../../features/products/db';
import { parsePublicId } from '../../features/ids/publicId';
import { mediaUrl } from '../../features/media/url';
import { getConfig, formatPrice } from '../../config';
import {
  isMethodAvailable,
  isPaymentMethod,
  type PaymentMethod,
} from '../../features/payments';
import {
  getStoreSettings,
  setSetting,
  setPaymentMethodDisabled,
  setFeatureEnabled,
} from '../../features/settings/db';
import {
  getSecret,
  setSecret,
  vaultReady,
  type SecretName,
} from '../../features/secrets/store';
import {
  featureAvailability,
  lightningConfigurationError,
  semanticSearchAvailable,
  turnstileConfigured,
  type RuntimeCapabilities,
} from '../../features/settings/availability';
import { getEmailProvider } from '../../features/email';
import { normalizeTimeZone, allTimeZones } from '../../features/settings/timeZone';
import { WEIGHT_UNITS, isWeightUnit } from '../../features/shipping/weight';
import { shippingFor } from '../../features/shipping/effective';
import SecretField from '../../components/SecretField.astro';
import MethodToggle from '../../components/MethodToggle.astro';
import { onDemandImageDeliveryAvailable } from '../../features/products/image';
import { catalogIsOrphaned } from '../../features/navigation/db';
import { CACHE_TAG } from '../../features/cache/tags';
import { purgeCacheTags } from '../../features/cache/purge';
import { guardAdminApi } from '../../features/fulfillment/actor';
import { recordAdminAuditLog } from '../../features/audit/db';
import {
  ADMIN_ROLES,
  ADMIN_ROLE_LABELS,
  parseStrictAdminRole,
} from '../../features/fulfillment/permissions';
import { toPersianDigits } from '../../lib/format';

const capabilities: RuntimeCapabilities = {
  vault: vaultReady(),
  authSecret: !!env.AUTH_SECRET,
  images: !!env.IMAGES,
  emailBinding: !!env.EMAIL,
  ai: !!env.AI,
  vectorize: !!env.VECTORIZE,
};

let validationError = '';
if (Astro.request.method === 'POST') {
  const auth = await guardAdminApi(
    env.DB,
    { locals: Astro.locals, cookies: Astro.cookies, request: Astro.request },
    'settings.manage',
  );
  if (!auth.ok) {
    return auth.response;
  }

  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  const returnTab = String(form.get('_tab') ?? '').trim();

  const applySecrets = async (names: SecretName[]) => {
    for (const n of names) {
      try {
        if (String(form.get(`clear:${n}`)) === '1') await setSecret(env.DB, n, null);
        else {
          const v = String(form.get(`secret:${n}`) ?? '').trim();
          if (v) await setSecret(env.DB, n, v);
        }
      } catch {
        // Vault بدون SECRETS_KEK غیرفعال است
      }
    }
  };

  if (action === 'toggle_payment') {
    const method = String(form.get('method') ?? '');
    const disabled = String(form.get('disabled')) === '1';
    const current = await getStoreSettings(env.DB);
    if (!isPaymentMethod(method)) {
      validationError = 'روش پرداخت شناخته‌شده نیست.';
    } else if (!disabled && !isMethodAvailable(method, current, capabilities.vault)) {
      validationError = 'ابتدا تنظیمات یا کلیدهای این روش پرداخت را تکمیل کنید.';
    } else {
      await setPaymentMethodDisabled(env.DB, method, disabled);
    }
  } else if (action === 'toggle_feature') {
    const feature = String(form.get('feature') ?? '');
    const on = String(form.get('enabled')) === '1';
    if (feature === 'cart_enabled' || feature === 'buy_now_enabled') {
      await setFeatureEnabled(env.DB, feature, on);
    } else if (
      feature === 'discounts_enabled' ||
      feature === 'tax_enabled' ||
      feature === 'accounts_enabled' ||
      feature === 'image_optimize' ||
      feature === 'shipping_enabled'
    ) {
      let prerequisiteError = '';
      if (on && (feature === 'discounts_enabled' || feature === 'tax_enabled')) {
        const stripeSecret = await getSecret(env.DB, 'stripe_secret_key');
        const stripeWebhook = await getSecret(env.DB, 'stripe_webhook_secret');
        if (!stripeSecret || !stripeWebhook) {
          prerequisiteError = 'برای این قابلیت وابسته به Stripe، ابتدا کلیدهای Stripe را ثبت کنید.';
        }
      } else if (on && feature === 'accounts_enabled') {
        if (!env.AUTH_SECRET && !import.meta.env.DEV) {
          prerequisiteError = 'پیش از فعال‌سازی حساب مشتریان، AUTH_SECRET باید تنظیم شود.';
        } else if (!(await getEmailProvider())) {
          prerequisiteError = 'ابتدا سرویس ایمیل را فعال و پیکربندی کنید.';
        }
      } else if (on && feature === 'image_optimize' && !env.IMAGES) {
        prerequisiteError = 'ابتدا بایندینگ IMAGES را در Worker فعال کنید.';
      }
      if (prerequisiteError) {
        validationError = prerequisiteError;
      } else {
        await setSetting(env.DB, feature, on ? '1' : '0');
      }
    }
  } else if (action === 'save_weight_unit') {
    const unit = String(form.get('weight_unit') ?? '');
    await setSetting(env.DB, 'weight_unit', isWeightUnit(unit) && unit !== 'g' ? unit : '');
  } else if (action === 'save_store') {
    await setSetting(env.DB, 'store_name', String(form.get('store_name') ?? '').trim());
    const zone = normalizeTimeZone(String(form.get('time_zone') ?? ''));
    if (zone) {
      await setSetting(env.DB, 'time_zone', zone);
    } else {
      validationError = 'یک منطقه زمانی معتبر IANA مانند Asia/Tehran وارد کنید.';
    }
  } else if (action === 'save_logo') {
    const key = String(form.get('logo_image_key') ?? '').trim();
    if (!key) {
      await setSetting(env.DB, 'logo_image_key', '');
    } else if (!(await setLogoFromMedia(env.DB, key))) {
      validationError = 'تصویر انتخاب‌شده دیگر در کتابخانه رسانه موجود نیست.';
    }
  } else if (action === 'save_home') {
    const choice = String(form.get('home_page') ?? '').trim();
    let stored: string | null = null;
    if (choice === '') {
      stored = '';
    } else if (choice.startsWith('page:')) {
      const pid = parsePublicId(choice.slice('page:'.length), 'page');
      const page = pid ? await getPageByPublicId(env.DB, pid) : null;
      if (page) stored = `page:${page.id}`;
    } else if (choice.startsWith('product:')) {
      const pid = parsePublicId(choice.slice('product:'.length), 'product');
      const product = pid ? await getProductByPublicId(env.DB, pid) : null;
      if (product) stored = `product:${product.id}`;
    }
    if (stored !== null && (await homeTargetIsValid(env.DB, stored))) {
      await setSetting(env.DB, 'home_page', stored);
    } else {
      validationError = 'فقط صفحه منتشرشده یا محصول فعال قابل انتخاب است.';
    }
  } else if (action === 'save_announcement') {
    const message = String(form.get('announcement') ?? '').trim().slice(0, 200);
    const href = String(form.get('announcement_href') ?? '').trim();
    const safeHref =
      !href ||
      (href.startsWith('/') && !href.startsWith('//')) ||
      /^https?:\/\//i.test(href);
    if (!safeHref) {
      validationError = 'لینک نوار اعلان باید مسیر داخلی (مانند /products) یا آدرس http(s) معتبر باشد.';
    } else {
      await setSetting(env.DB, 'announcement', message);
      await setSetting(env.DB, 'announcement_href', message ? href : '');
    }
  } else if (action === 'set_image_delivery') {
    const delivery = String(form.get('image_delivery') ?? '');
    if (delivery === 'cloudflare') {
      if (!onDemandImageDeliveryAvailable(getConfig().images.baseUrl)) {
        validationError = 'ابتدا دامنه اختصاصی R2 و IMAGE_BASE_URL را تنظیم کنید.';
      } else {
        await setSetting(env.DB, 'image_delivery', 'cloudflare');
      }
    } else if (delivery === 'original') {
      await setSetting(env.DB, 'image_delivery', null);
    } else {
      validationError = 'روش تحویل تصویر معتبر نیست.';
    }
  } else if (action === 'set_search') {
    const provider = String(form.get('provider') ?? '');
    if (provider === 'vector' && !semanticSearchAvailable(capabilities)) {
      validationError = 'جستجوی معنایی نیازمند بایندینگ‌های AI و VECTORIZE است.';
    } else if (provider === 'fts' || provider === 'vector') {
      await setSetting(env.DB, 'search_provider', provider);
    }
  } else if (action === 'save_email') {
    const requestedEnabled = String(form.get('email_enabled')) === '1';
    const ep = String(form.get('email_provider') ?? '');
    const provider = ep === 'cloudflare' ? 'cloudflare' : 'resend';
    const replyTo = String(form.get('email_reply_to') ?? '').trim();
    const testMode = form.get('email_test_mode') === '1';

    await setSetting(env.DB, 'email_provider', provider === 'cloudflare' ? 'cloudflare' : null);
    await setSetting(env.DB, 'email_from', String(form.get('email_from') ?? '').trim() || null);
    await setSetting(env.DB, 'email_from_name', String(form.get('email_from_name') ?? '').trim() || null);
    await setSetting(env.DB, 'email_notify_to', String(form.get('email_notify_to') ?? '').trim() || null);
    await setSetting(env.DB, 'email_reply_to', replyTo || null);
    await setSetting(env.DB, 'email_test_mode', testMode ? '1' : null);
    await applySecrets(['resend_api_key']);
    const ready =
      provider === 'cloudflare'
        ? !!env.EMAIL
        : !!(await getSecret(env.DB, 'resend_api_key'));
    await setSetting(env.DB, 'email_enabled', requestedEnabled && ready ? null : '0');
    if (requestedEnabled && !ready) {
      validationError =
        provider === 'cloudflare'
          ? 'ابتدا بایندینگ EMAIL را در Worker فعال کنید.'
          : 'پیش از فعال‌سازی ارسال ایمیل، کلید API سرویس Resend را وارد کنید.';
    }
  } else if (action === 'save_turnstile') {
    const requestedEnabled = String(form.get('turnstile_enabled')) === '1';
    const siteKey = String(form.get('turnstile_site_key') ?? '').trim();
    await setSetting(env.DB, 'turnstile_site_key', siteKey || null);
    await applySecrets(['turnstile_secret_key']);
    const secret = await getSecret(env.DB, 'turnstile_secret_key');
    const ready = !!siteKey && !!secret;
    await setSetting(env.DB, 'turnstile_enabled', requestedEnabled && ready ? '1' : null);
    if (requestedEnabled && !ready) {
      validationError = 'هر دو کلید Site Key و Secret Key سرویس Turnstile را وارد کنید.';
    }
  } else if (action === 'save_default') {
    const prov = String(form.get('payment_provider') ?? '');
    const current = await getStoreSettings(env.DB);
    const disabled = new Set(current.disabledPaymentMethods);
    if (
      !isPaymentMethod(prov) ||
      !isMethodAvailable(prov, current, capabilities.vault) ||
      disabled.has(prov)
    ) {
      validationError = 'فقط یک روش پرداخت پیکربندی‌شده و فعال می‌تواند پیش‌فرض باشد.';
    } else {
      await setSetting(env.DB, 'payment_provider', prov === 'stripe' ? null : prov);
    }
  } else if (action === 'save_stripe') {
    await applySecrets(['stripe_secret_key', 'stripe_webhook_secret']);
  } else if (action === 'save_lightning') {
    const requestedBackend = String(form.get('lightning_backend') ?? '');
    if (requestedBackend !== 'lnbits' && requestedBackend !== 'phoenixd') {
      validationError = 'بک‌اند لایتنینگ معتبر نیست.';
    } else {
      const backend = requestedBackend;
      const urlField = backend === 'lnbits' ? 'lnbits_url' : 'phoenixd_url';
      const secretName: SecretName =
        backend === 'lnbits' ? 'lnbits_api_key' : 'phoenixd_password';
      const url = String(form.get(urlField) ?? '').trim();
      const suppliedSecret = String(form.get(`secret:${secretName}`) ?? '').trim();
      const clearSecret = form.get(`clear:${secretName}`) === '1';
      const existingSecret = clearSecret ? null : await getSecret(env.DB, secretName);
      validationError =
        lightningConfigurationError(
          backend,
          url,
          !clearSecret && (!!suppliedSecret || !!existingSecret),
        ) ?? '';

      if (!validationError) {
        await setSetting(env.DB, 'lightning_backend', backend === 'lnbits' ? 'lnbits' : null);
        await setSetting(env.DB, urlField, url);
        await applySecrets([secretName]);
      }
    }
  } else if (action === 'save_shippo') {
    await applySecrets(['shippo_api_key']);
  } else if (action === 'save_opennode') {
    await setSetting(env.DB, 'opennode_api_url', String(form.get('opennode_api_url') ?? '').trim() || null);
    await applySecrets(['opennode_api_key']);
  } else if (action === 'save_zarinpal') {
    await setSetting(env.DB, 'zarinpal_sandbox', form.get('zarinpal_sandbox') === '1' ? '1' : '0');
    await applySecrets(['zarinpal_merchant_id']);
  } else if (action === 'save_zibal') {
    await setSetting(env.DB, 'zibal_sandbox', form.get('zibal_sandbox') === '1' ? '1' : '0');
    await applySecrets(['zibal_merchant_id']);
  } else if (action === 'save_bank_transfer') {
    await setSetting(
      env.DB,
      'bank_transfer_enabled',
      form.get('bank_transfer_enabled') === '1' ? '1' : '0',
    );
  } else if (action === 'save_wallet') {
    await setSetting(env.DB, 'wallet_enabled', form.get('wallet_enabled') === '1' ? '1' : '0');
    const minTopup = Number(form.get('wallet_min_topup') ?? 50000);
    const maxTopup = Number(form.get('wallet_max_topup') ?? 50000000);
    if (Number.isInteger(minTopup) && minTopup > 0) {
      await setSetting(env.DB, 'wallet_min_topup', String(minTopup));
    }
    if (Number.isInteger(maxTopup) && maxTopup >= minTopup) {
      await setSetting(env.DB, 'wallet_max_topup', String(maxTopup));
    }
  } else if (action === 'save_seo') {
    const seoTitle = String(form.get('seo_meta_title') ?? '').trim().slice(0, 120);
    const seoDesc = String(form.get('seo_meta_description') ?? '').trim().slice(0, 180);
    const ogKey = String(form.get('seo_og_image_key') ?? '').trim();
    const disallowAdmin = form.get('seo_robots_disallow_admin') === '1';

    if (ogKey) {
      const exists = await env.DB.prepare('SELECT 1 AS ok FROM media WHERE image_key = ?')
        .bind(ogKey)
        .first<{ ok: number }>();
      if (!exists) {
        validationError = 'کلید تصویر OpenGraph در کتابخانه رسانه یافت نشد.';
      }
    }
    if (!validationError) {
      await setSetting(env.DB, 'seo_meta_title', seoTitle || null);
      await setSetting(env.DB, 'seo_meta_description', seoDesc || null);
      await setSetting(env.DB, 'seo_og_image_key', ogKey || null);
      await setSetting(env.DB, 'seo_robots_disallow_admin', disallowAdmin ? '1' : '0');
    }
  } else if (action === 'save_security') {
    const adminTtl = Number(form.get('admin_session_ttl_hours') ?? 168);
    const custTtl = Number(form.get('customer_session_ttl_days') ?? 30);
    const defaultRoleRaw = String(form.get('admin_default_role') ?? '').trim();
    const parsedDefaultRole = defaultRoleRaw ? parseStrictAdminRole(defaultRoleRaw) : null;

    if (!Number.isInteger(adminTtl) || adminTtl < 1 || adminTtl > 720) {
      validationError = 'مدت اعتبار نشست مدیر باید بین ۱ تا ۷۲۰ ساعت باشد.';
    } else if (!Number.isInteger(custTtl) || custTtl < 1 || custTtl > 180) {
      validationError = 'مدت اعتبار نشست مشتری باید بین ۱ تا ۱۸۰ روز باشد.';
    } else if (defaultRoleRaw && !parsedDefaultRole) {
      validationError = 'نقش پیش‌فرض انتخاب‌شده معتبر نیست.';
    } else {
      await setSetting(env.DB, 'admin_session_ttl_hours', String(adminTtl));
      await setSetting(env.DB, 'customer_session_ttl_days', String(custTtl));
      await setSetting(
        env.DB,
        'admin_default_role',
        parsedDefaultRole,
      );
    }
  }

  await recordAdminAuditLog(env.DB, {
    action: `settings.${action || 'updated'}`,
    module: 'settings',
    targetType: 'settings',
    targetId: action || 'global',
    actor: auth.actor.id,
    result: validationError ? 'failed' : 'success',
    details: { action, returnTab: returnTab || null },
  });

  await purgeCacheTags([CACHE_TAG.shell, CACHE_TAG.catalog]);

  if (Astro.request.headers.get('x-requested-with') === 'fetch') {
    return validationError
      ? new Response(validationError, { status: 400 })
      : new Response(null, { status: 204 });
  }

  if (!validationError) {
    const fwdProto = Astro.request.headers.get('x-forwarded-proto')?.split(',')[0]?.trim().toLowerCase();
    Astro.cookies.set('flash', 'تنظیمات با موفقیت ذخیره و در فروشگاه اعمال شد.', {
      path: '/admin/settings',
      maxAge: 15,
      httpOnly: true,
      secure: Astro.url.protocol === 'https:' || fwdProto === 'https',
      sameSite: 'lax',
    });
    const dest = returnTab && returnTab !== 'all' ? `/admin/settings?tab=${encodeURIComponent(returnTab)}` : '/admin/settings';
    return Astro.redirect(dest, 303);
  }
}

const VALID_TABS = new Set(['all', 'general', 'accounts', 'payments', 'email', 'storefront', 'seo', 'security']);
const rawTab = (Astro.url.searchParams.get('tab') ?? 'all').trim();
const activeTab = VALID_TABS.has(rawTab) ? rawTab : 'all';
const showSection = (tabKey: string) => activeTab === 'all' || activeTab === tabKey;

const cfg = getConfig();
const { currency } = cfg;

const flash = Astro.cookies.get('flash')?.value ?? null;
if (flash) Astro.cookies.delete('flash', { path: '/admin/settings' });
const msg = validationError || flash || Astro.url.searchParams.get('msg');

const settings = await getStoreSettings(env.DB);
const disabledSet = new Set(settings.disabledPaymentMethods);
const storeName = settings.storeName ?? cfg.storeName;
const logoUrl = settings.logoImageKey ? mediaUrl(settings.logoImageKey, cfg.images.baseUrl) : null;
const HOME_PRODUCT_CHOICES = 100;
const homePages = await listPublishedPageOptions(env.DB);
const homeProducts = await listProducts(env.DB, HOME_PRODUCT_CHOICES, 0, 'name COLLATE NOCASE');
const homeChoice = settings.homePage ?? '';
const chosenProductId = homeChoice.startsWith('product:') ? Number(homeChoice.slice(8)) : null;
if (chosenProductId && !homeProducts.some((p) => p.id === chosenProductId)) {
  const [chosen] = await getProductsByIds(env.DB, [chosenProductId]);
  if (chosen) homeProducts.unshift(chosen);
}
const homeChoiceMissing =
  homeChoice !== '' &&
  !homePages.some((page) => `page:${page.id}` === homeChoice) &&
  !homeProducts.some((product) => `product:${product.id}` === homeChoice);
const catalogOrphaned = await catalogIsOrphaned(env.DB, settings.homePage);
const timeZone = settings.timeZone ?? cfg.timeZone;
const weightUnit = settings.weightUnit;
const effectiveShipping = shippingFor(settings).config;
const announcement = settings.announcement ?? '';
const announcementHref = settings.announcementHref ?? '';
const timeZones = allTimeZones();

const searchProvider = settings.searchProvider ?? cfg.search.provider;
const vectorBindingsReady = semanticSearchAvailable(capabilities);
const onDemandImagesReady = onDemandImageDeliveryAvailable(cfg.images.baseUrl);
const reindexCursor = parsePublicId(Astro.url.searchParams.get('reindex_cursor'), 'product') ?? '';
const reindexProcessedValue = Number(Astro.url.searchParams.get('reindex_processed'));
const reindexProcessed =
  Number.isInteger(reindexProcessedValue) && reindexProcessedValue > 0
    ? reindexProcessedValue
    : 0;

const baseFeatureRows: { key: string; label: string; desc: string; on: boolean }[] = [
  {
    key: 'cart_enabled',
    label: 'سبد خرید و تسویه‌حساب',
    desc: 'امکان افزودن به سبد و ثبت سفارش. در صورت خاموش بودن، فروشگاه فقط کاتالوگ نمایشی خواهد بود.',
    on: settings.cartEnabled,
  },
  {
    key: 'buy_now_enabled',
    label: 'دکمه خرید سریع (Buy Now)',
    desc: 'پرداخت مستقیم یک محصول از صفحه محصول، حتی زمانی که سبد خرید غیرفعال است.',
    on: settings.buyNowEnabled,
  },
  {
    key: 'accounts_enabled',
    label: 'حساب‌های کاربری مشتریان',
    desc: 'ورود بدون رمز با لینک یک‌بارمصرف ایمیلی، تاریخچه سفارش‌ها، کیف پول و تیکت‌ها.',
    on: settings.accountsEnabled ?? cfg.features.accounts,
  },
  {
    key: 'image_optimize',
    label: 'بهینه‌سازی خودکار تصاویر هنگام آپلود',
    desc: 'تبدیل خودکار تصاویر محصول به WebP با Cloudflare Images (در صورت اتصال بایندینگ).',
    on: settings.imageOptimize ?? cfg.images.optimizeOnUpload,
  },
  {
    key: 'discounts_enabled',
    label: 'کدهای تخفیف Stripe',
    desc: 'نمایش فیلد کد تخفیف برای پرداخت‌های Stripe.',
    on: settings.discountsEnabled ?? cfg.discounts.enabled,
  },
  {
    key: 'tax_enabled',
    label: 'مالیات خودکار Stripe',
    desc: 'محاسبه مالیات خودکار در درگاه Stripe.',
    on: settings.taxEnabled ?? cfg.tax.enabled,
  },
];
const featureRows = baseFeatureRows.map((row) => ({
  ...row,
  ...featureAvailability(row.key, settings, capabilities),
}));

const paymentMethods: { m: PaymentMethod; label: string }[] = [
  { m: 'wallet', label: 'کیف پول GarGift+ (Wallet)' },
  { m: 'bank_transfer', label: 'کارت‌به‌کارت و واریز بانکی (Bank Transfer)' },
  { m: 'zarinpal', label: 'درگاه زرین‌پال (Zarinpal)' },
  { m: 'zibal', label: 'درگاه زیبال (Zibal)' },
  { m: 'stripe', label: 'کارت بین‌المللی (Stripe)' },
  { m: 'lightning', label: 'لایتنینگ (Lightning)' },
  { m: 'opennode', label: 'بیت‌کوین (OpenNode)' },
  { m: 'demo', label: 'پرداخت آزمایشی (Demo)' },
];
const pmRows = paymentMethods.map((r) => {
  const installed = isMethodAvailable(r.m, settings, capabilities.vault);
  return { ...r, installed, enabled: installed && !disabledSet.has(r.m) };
});

const payments = {
  provider: settings.paymentProvider,
  lightningBackend: settings.lightningBackend,
  lnbitsUrl: settings.lnbitsUrl ?? '',
  phoenixdUrl: settings.phoenixdUrl ?? '',
  opennodeApiUrl: settings.opennodeApiUrl ?? '',
};

const vault = capabilities.vault;
const inD1 = (name: string) => settings.configuredSecrets.includes(name);
const pmMap = Object.fromEntries(pmRows.map((r) => [r.m, r])) as Record<
  string,
  (typeof pmRows)[number]
>;

const email = {
  enabled: settings.emailEnabled,
  provider: settings.emailProvider,
  from: settings.emailFrom ?? '',
  fromName: settings.emailFromName ?? '',
  fromPlaceholder: cfg.email.from,
  notifyTo: settings.emailNotifyTo ?? '',
  notifyPlaceholder: cfg.email.notifyTo || 'alerts@gargift.ir',
  replyTo: settings.emailReplyTo ?? '',
  testMode: settings.emailTestMode,
};
const resendStoredInD1 = inD1('resend_api_key');
const resendReady = !!(await getSecret(env.DB, 'resend_api_key'));
const emailBindingReady = !!env.EMAIL;
const selectedEmailReady =
  email.provider === 'cloudflare' ? emailBindingReady : resendReady;

const turnstile = {
  enabled: settings.turnstileEnabled,
  siteKey: settings.turnstileSiteKey ?? '',
};
const turnstileSecretInD1 = inD1('turnstile_secret_key');
const turnstileSecretReady = !!(await getSecret(env.DB, 'turnstile_secret_key'));
const turnstileReady =
  turnstileConfigured(settings, capabilities) && turnstileSecretReady;

const tabs = [
  { id: 'all', label: 'همه تنظیمات' },
  { id: 'general', label: 'عمومی و هویت' },
  { id: 'accounts', label: 'امکانات و مشتریان' },
  { id: 'payments', label: 'درگاه‌ها و پرداخت' },
  { id: 'email', label: 'ایمیل و اعلان‌ها' },
  { id: 'storefront', label: 'رسانه، صفحه اول و ارسال' },
  { id: 'seo', label: 'سئو و موتور جستجو' },
  { id: 'security', label: 'امنیت و نشست‌ها' },
];
---

<AdminLayout
  title="تنظیمات و مرکز پیکربندی فروشگاه"
  active="settings"
  requiredPermission="settings.manage"
  breadcrumbs={[{ label: 'سیستم و گزارش‌ها' }, { label: 'تنظیمات فروشگاه' }]}
>
  <AdminPageHeader
    title="مرکز کنترل تنظیمات فروشگاه GarGift+"
    subtitle="پیکربندی هویت فروشگاه، درگاه‌های پرداخت، سرویس ایمیل، سئو، جستجو و امنیت نشست‌ها"
  >
    <a slot="actions" href="/admin/shipping" class="gg-admin-btn-secondary text-xs">
      تنظیمات مناطق ارسال ({effectiveShipping.enabled ? 'فعال' : 'غیرفعال'})
    </a>
  </AdminPageHeader>

  {/* تب‌های ناوبری */}
  <nav
    aria-label="بخش‌های تنظیمات"
    class="gg-admin-card mb-6 flex flex-wrap items-center gap-1.5 p-2"
  >
    {
      tabs.map((t) => (
        <a
          href={t.id === 'all' ? '/admin/settings' : `/admin/settings?tab=${t.id}`}
          class={`rounded-xl px-3.5 py-2 text-xs font-semibold transition ${
            activeTab === t.id
              ? 'bg-brand text-on-brand shadow-xs'
              : 'text-muted hover:bg-surface-elevated hover:text-ink'
          }`}
        >
          {t.label}
        </a>
      ))
    }
  </nav>

  {
    msg && (
      <p
        data-flash
        class={`mb-6 rounded-xl border px-4 py-3 text-xs font-semibold ${
          validationError ? 'gg-status-error' : 'gg-status-success'
        }`}
      >
        {msg}
      </p>
    )
  }

  {/* ── ۱. عمومی و هویت فروشگاه ─────────────────────────────────────── */}
  {showSection('general') && (
    <section id="general" class="mb-8 scroll-mt-20 space-y-4">
      <div class="border-b border-line pb-2">
        <h2 class="text-base font-bold text-ink">اطلاعات پایه، لوگو و هویت فروشگاه</h2>
        <p class="text-xs text-muted">تغییرات بلافاصله در سراسر فروشگاه اعمال می‌شوند.</p>
      </div>

      <form method="POST" class="gg-admin-card p-5 space-y-4">
        <input type="hidden" name="_action" value="save_store" />
        <input type="hidden" name="_tab" value={activeTab} />
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-1.5 text-xs font-medium text-muted">
            نام فروشگاه
            <input type="text" name="store_name" value={storeName} class="gg-admin-input text-sm" />
          </label>
          <label class="flex flex-col gap-1.5 text-xs font-medium text-muted">
            منطقه زمانی نمایش تاریخ‌ها (IANA)
            <input
              type="text"
              name="time_zone"
              value={timeZone}
              required
              list="tz-list"
              placeholder="Asia/Tehran"
              class="gg-admin-input ltr-inline font-mono text-xs"
            />
            <datalist id="tz-list">
              {timeZones.map((z) => <option value={z} />)}
            </datalist>
          </label>
        </div>
        <p class="text-[11px] text-faint">
          منطقه زمانی برای نمایش دقیق تاریخ و ساعت شمسی در پنل و صفحات مشتری به‌کار می‌رود (پیش‌فرض: <code>Asia/Tehran</code>).
        </p>
        <button type="submit" class="gg-admin-btn-primary text-xs">ذخیره مشخصات فروشگاه</button>
      </form>

      <form method="POST" class="gg-admin-card p-5 space-y-4">
        <input type="hidden" name="_action" value="save_logo" />
        <input type="hidden" name="_tab" value={activeTab} />
        <p class="text-xs font-bold text-ink">لوگوی اصلی هدر فروشگاه</p>
        <div class="flex flex-wrap items-center gap-4">
          <div class="flex h-14 w-44 shrink-0 items-center justify-center rounded-xl border border-line bg-paper px-3">
            {
              logoUrl ? (
                <img src={logoUrl} alt="لوگوی فعلی" class="max-h-10 max-w-full object-contain" />
              ) : (
                <span class="text-sm font-extrabold text-muted">{storeName}</span>
              )
            }
          </div>
          <input type="hidden" name="logo_image_key" value={settings.logoImageKey ?? ''} data-logo-key />
          <MediaPicker id="logo" label={settings.logoImageKey ? 'تغییر لوگو' : 'انتخاب لوگو از کتابخانه'} />
          {
            settings.logoImageKey && (
              <button type="submit" data-logo-remove class="gg-admin-btn-secondary text-xs">
                حذف لوگو و بازگشت به متن
              </button>
            )
          }
        </div>
      </form>
    </section>
  )}

  {/* ── ۲. امکانات و حساب مشتریان ───────────────────────────────────── */}
  {showSection('accounts') && (
    <section id="accounts" class="mb-8 scroll-mt-20 space-y-4">
      <div class="border-b border-line pb-2">
        <h2 class="text-base font-bold text-ink">کلیدهای امکانات فروشگاه و حساب مشتریان</h2>
        <p class="text-xs text-muted">مدیریت وضعیت سبد خرید، خرید سریع و حساب کاربری مشتریان.</p>
      </div>

      <ul class="gg-admin-card divide-y divide-line overflow-hidden">
        {
          featureRows.map((f) => (
            <li class="flex items-center justify-between gap-4 px-5 py-4">
              <div class="min-w-0">
                <p class="text-sm font-bold text-ink">{f.label}</p>
                <p class={f.available ? 'text-xs text-muted' : 'text-xs text-amber'}>
                  {f.available ? f.desc : f.reason}
                </p>
              </div>
              {
                f.available || f.on ? (
                  <form method="POST" class="shrink-0">
                    <input type="hidden" name="_action" value="toggle_feature" />
                    <input type="hidden" name="_tab" value={activeTab} />
                    <input type="hidden" name="feature" value={f.key} />
                    <input type="hidden" name="enabled" value={f.on ? '0' : '1'} />
                    <button
                      type="submit"
                      dir="ltr"
                      role="switch"
                      aria-checked={f.on ? 'true' : 'false'}
                      aria-label={`${f.on ? 'غیرفعال‌سازی' : 'فعال‌سازی'} ${f.label}`}
                      class={`relative inline-flex h-6 w-11 items-center rounded-full transition ${
                        f.on ? 'bg-brand' : 'bg-faint'
                      }`}
                    >
                      <span
                        class={`inline-block size-5 rounded-full bg-white shadow transition ${
                          f.on ? 'translate-x-5' : 'translate-x-0.5'
                        }`}
                      />
                    </button>
                  </form>
                ) : (
                  <span class="shrink-0 text-[11px] font-bold text-faint">نیازمند پیش‌نیاز</span>
                )
              }
            </li>
          ))
        }
      </ul>
    </section>
  )}

  {/* ── ۳. ویترین، نوار اعلان، تصاویر و ارسال ────────────────────────── */}
  {showSection('storefront') && (
    <section id="images" class="mb-8 scroll-mt-20 space-y-4">
      <div class="border-b border-line pb-2">
        <h2 class="text-base font-bold text-ink">صفحه اول، نوار اطلاعیه، تصاویر و ارسال</h2>
        <p class="text-xs text-muted">تعیین مقصد صفحه خانه، نوار اعلان بالای سایت و روش سرو تصاویر.</p>
      </div>

      <form method="POST" class="gg-admin-card p-5 space-y-4">
        <input type="hidden" name="_action" value="save_home" />
        <input type="hidden" name="_tab" value={activeTab} />
        <label class="flex flex-col gap-1.5 text-xs font-medium text-muted">
          محتوای مسیر اصلی (<code>/</code>) — پیش‌فرض صفحه اصلی داینامیک CMS گرگیفت+ است
          <select name="home_page" class="gg-admin-input w-80 max-w-full text-xs">
            <option value="" selected={homeChoice === ''}>صفحه اصلی پیش‌فرض فروشگاه (CMS)</option>
            {
              homePages.length > 0 && (
                <optgroup label="صفحه محتوایی">
                  {homePages.map((p) => (
                    <option value={`page:${p.public_id}`} selected={homeChoice === `page:${p.id}`}>
                      {p.title}
                    </option>
                  ))}
                </optgroup>
              )
            }
            {
              homeProducts.length > 0 && (
                <optgroup label="محصول تک‌صفحه‌ای">
                  {homeProducts.map((p) => (
                    <option value={`product:${p.public_id}`} selected={homeChoice === `product:${p.id}`}>
                      {p.name}
                    </option>
                  ))}
                </optgroup>
              )
            }
          </select>
        </label>
        {homeChoiceMissing && (
          <p class="gg-status-warning rounded-xl border px-3 py-2 text-xs">
            صفحه یا محصول قبلی غیرفعال شده و صفحه اصلی به حالت پیش‌فرض برگشته است.
          </p>
        )}
        {catalogOrphaned && (
          <p class="gg-status-warning rounded-xl border px-3 py-2 text-xs">
            با جایگزینی صفحه اول، لینک فروشگاه در <a href="/admin/navigation" class="underline">منوها و ناوبری</a> توصیه می‌شود.
          </p>
        )}
        <button type="submit" class="gg-admin-btn-primary text-xs">ذخیره تنظیمات صفحه خانه</button>
      </form>

      <form method="POST" class="gg-admin-card p-5 space-y-4">
        <input type="hidden" name="_action" value="save_announcement" />
        <input type="hidden" name="_tab" value={activeTab} />
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-1.5 text-xs font-medium text-muted">
            متن نوار اطلاعیه بالای فروشگاه (خالی = پنهان)
            <input type="text" name="announcement" value={announcement} maxlength="200" placeholder="مثال: تحویل فوری کلیه اشتراک‌های هوش مصنوعی با ضمانت کامل" class="gg-admin-input text-xs" />
          </label>
          <label class="flex flex-col gap-1.5 text-xs font-medium text-muted">
            لینک مقصد نوار اعلان (اختیاری)
            <input type="text" name="announcement_href" value={announcementHref} placeholder="/products" class="gg-admin-input ltr-inline font-mono text-xs" />
          </label>
        </div>
        <button type="submit" class="gg-admin-btn-primary text-xs">ذخیره نوار اطلاعیه</button>
      </form>

      <form method="POST" class="gg-admin-card p-5 space-y-4">
        <input type="hidden" name="_action" value="set_image_delivery" />
        <input type="hidden" name="_tab" value={activeTab} />
        <p class="text-xs font-bold text-ink">روش سرو و بهینه‌سازی تصاویر R2</p>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-line bg-paper p-3.5 text-xs">
            <input type="radio" name="image_delivery" value="original" checked={settings.imageDelivery === 'original'} class="mt-0.5 accent-brand" />
            <span>
              <strong class="block text-ink">تصاویر اصلی بدون تغییر</strong>
              <span class="mt-0.5 block text-muted">سرو مستقیم فایل از R2 بدون نیاز به دامنه تبدیل تصویر.</span>
            </span>
          </label>
          <label class={`flex items-start gap-3 rounded-xl border border-line bg-paper p-3.5 text-xs ${onDemandImagesReady ? 'cursor-pointer' : 'cursor-not-allowed opacity-60'}`}>
            <input type="radio" name="image_delivery" value="cloudflare" checked={settings.imageDelivery === 'cloudflare'} disabled={!onDemandImagesReady} class="mt-0.5 accent-brand" />
            <span>
              <strong class="block text-ink">تبدیل در لحظه Cloudflare</strong>
              <span class="mt-0.5 block text-muted">
                {onDemandImagesReady ? 'ارائه خودکار AVIF/WebP ریسپانسیو' : 'نیازمند دامنه اختصاصی R2 و متغیر IMAGE_BASE_URL'}
              </span>
            </span>
          </label>
        </div>
        <button type="submit" class="gg-admin-btn-primary text-xs">ذخیره روش سرو تصاویر</button>
      </form>

      <div class="gg-admin-card grid gap-4 p-5 lg:grid-cols-2">
        <form method="POST" class="space-y-3">
          <input type="hidden" name="_action" value="save_weight_unit" />
          <input type="hidden" name="_tab" value={activeTab} />
          <label class="flex flex-col gap-1.5 text-xs font-medium text-muted">
            واحد وزن (برای محصولات فیزیکی احتمالی)
            <select name="weight_unit" class="gg-admin-input w-28 text-xs">
              {WEIGHT_UNITS.map((u) => <option value={u} selected={u === weightUnit}>{u}</option>)}
            </select>
          </label>
          <button type="submit" class="gg-admin-btn-secondary text-xs">ذخیره واحد وزن</button>
        </form>

        <form method="POST" class="space-y-3">
          <input type="hidden" name="_action" value="save_shippo" />
          <input type="hidden" name="_tab" value={activeTab} />
          <SecretField name="shippo_api_key" label="توکن Shippo (برچسب پستی بین‌المللی)" hint="shippo_live_… or shippo_test_…" storedInD1={inD1('shippo_api_key')} vault={vault} />
          {vault && <button type="submit" class="gg-admin-btn-secondary text-xs">ذخیره توکن Shippo</button>}
        </form>
      </div>
    </section>
  )}

  {/* ── ۴. پرداخت‌ها و درگاه‌ها ────────────────────────────────────── */}
  {showSection('payments') && (
    <section id="payments" class="mb-8 scroll-mt-20 space-y-4">
      <div class="border-b border-line pb-2">
        <h2 class="text-base font-bold text-ink">پیکربندی درگاه‌های پرداخت، کیف پول و کارت‌به‌کارت</h2>
        <p class="text-xs text-muted">
          تمام کلیدها به‌صورت رمزگذاری‌شده با AES-GCM در D1 ذخیره می‌شوند و پس از ذخیره هرگز نمایش داده نمی‌شوند.
        </p>
      </div>

      {!vault && (
        <div class="gg-status-warning rounded-xl border px-4 py-3 text-xs">
          کلید رمزگذاری <code>SECRETS_KEK</code> روی Worker تنظیم نشده است؛ فیلدهای رمزنگاری در این حالت قفل هستند و برای تست محلی فقط روش‌های بدون کلید یا Sandbox قابل استفاده است.
        </div>
      )}

      {/* درگاه پیش‌فرض */}
      <form method="POST" class="gg-admin-card flex flex-wrap items-end justify-between gap-4 p-5">
        <input type="hidden" name="_action" value="save_default" />
        <input type="hidden" name="_tab" value={activeTab} />
        <label class="flex flex-col gap-1.5 text-xs font-medium text-muted">
          روش پرداخت پیش‌فرض در صفحه تسویه‌حساب
          <select name="payment_provider" class="gg-admin-input w-72 max-w-full text-xs">
            {
              pmRows.map((row) => (
                <option value={row.m} selected={payments.provider === row.m} disabled={!row.enabled}>
                  {row.label}{row.enabled ? '' : ' — غیرفعال / پیکربندی‌نشده'}
                </option>
              ))
            }
          </select>
        </label>
        <button type="submit" disabled={!pmRows.some((row) => row.enabled)} class="gg-admin-btn-primary text-xs">
          ذخیره روش پیش‌فرض
        </button>
      </form>

      {/* کیف پول و کارت‌به‌کارت */}
      <div class="grid gap-4 lg:grid-cols-2">
        <div class="gg-admin-card p-5 space-y-3">
          <div class="flex items-center justify-between gap-3">
            <div>
              <h3 class="text-sm font-bold text-ink">کیف پول مشتریان (Wallet)</h3>
              <p class="text-xs text-muted">پرداخت آنی و بازگشت وجه خودکار به کیف پول</p>
            </div>
            {pmMap.wallet.installed && <MethodToggle method="wallet" enabled={pmMap.wallet.enabled} label="کیف پول" />}
          </div>
          <form method="POST" class="space-y-3 border-t border-line pt-3">
            <input type="hidden" name="_action" value="save_wallet" />
            <input type="hidden" name="_tab" value={activeTab} />
            <label class="flex items-center gap-2 text-xs text-ink">
              <input type="checkbox" name="wallet_enabled" value="1" checked={settings.walletEnabled} class="accent-brand" />
              <span>فعال‌سازی سیستم کیف پول مشتریان</span>
            </label>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="flex flex-col gap-1 text-xs text-muted">
                حداقل شارژ (تومان)
                <input type="number" name="wallet_min_topup" value={settings.walletMinTopup} min="1000" step="1000" class="gg-admin-input ltr-inline font-mono text-xs" />
              </label>
              <label class="flex flex-col gap-1 text-xs text-muted">
                حداکثر شارژ (تومان)
                <input type="number" name="wallet_max_topup" value={settings.walletMaxTopup} min="10000" step="10000" class="gg-admin-input ltr-inline font-mono text-xs" />
              </label>
            </div>
            <button type="submit" class="gg-admin-btn-primary text-xs">ذخیره تنظیمات کیف پول</button>
          </form>
        </div>

        <div class="gg-admin-card p-5 space-y-3">
          <div class="flex items-center justify-between gap-3">
            <div>
              <h3 class="text-sm font-bold text-ink">کارت‌به‌کارت و واریز بانکی</h3>
              <p class={pmMap.bank_transfer.installed ? 'text-xs text-accent-fg' : 'text-xs text-amber'}>
                {pmMap.bank_transfer.installed ? 'حساب بانکی مقصد فعال است' : 'ابتدا یک کارت یا شبا در بخش حساب‌های بانکی ثبت کنید'}
              </p>
            </div>
            {pmMap.bank_transfer.installed && <MethodToggle method="bank_transfer" enabled={pmMap.bank_transfer.enabled} label="کارت‌به‌کارت" />}
          </div>
          <form method="POST" class="flex flex-wrap items-center justify-between gap-3 border-t border-line pt-3">
            <input type="hidden" name="_action" value="save_bank_transfer" />
            <input type="hidden" name="_tab" value={activeTab} />
            <label class="flex items-center gap-2 text-xs text-ink">
              <input type="checkbox" name="bank_transfer_enabled" value="1" checked={settings.bankTransferEnabled} class="accent-brand" />
              <span>فعال‌سازی درگاه کارت‌به‌کارت در تسویه‌حساب</span>
            </label>
            <button type="submit" class="gg-admin-btn-primary text-xs">ذخیره</button>
          </form>
          <div class="pt-1">
            <a href="/admin/bank-accounts" class="text-xs font-semibold text-brand-fg hover:underline">
              مدیریت کارت‌ها و حساب‌های بانکی مقصد ←
            </a>
          </div>
        </div>
      </div>

      {/* زرین‌پال و زیبال */}
      <div class="grid gap-4 lg:grid-cols-2">
        <div class="gg-admin-card p-5 space-y-3">
          <div class="flex items-center justify-between gap-3">
            <div>
              <h3 class="text-sm font-bold text-ink">درگاه زرین‌پال (Zarinpal)</h3>
              <p class={pmMap.zarinpal.installed ? 'text-xs text-accent-fg' : 'text-xs text-amber'}>
                {pmMap.zarinpal.installed ? 'آماده دریافت پرداخت' : 'کد مرچنت یا سندباکس را تنظیم کنید'}
              </p>
            </div>
            {pmMap.zarinpal.installed && <MethodToggle method="zarinpal" enabled={pmMap.zarinpal.enabled} label="زرین‌پال" />}
          </div>
          <form method="POST" class="space-y-3 border-t border-line pt-3">
