---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../components/admin/AdminPageHeader.astro';
import { getConfig, toMinorUnits } from '../../config';
import { guardAdminApi } from '../../features/fulfillment/actor';
import { recordAdminAuditLog } from '../../features/audit/db';
import { zonesRequireWeight, type ShippingConfig } from '../../features/shipping/calculator';
import { countProductsMissingWeight, sampleProductsMissingWeight } from '../../features/shipping/sellability';
import { formatWeightValue, type WeightUnit } from '../../features/shipping/weight';
import { countryOptions } from '../../features/shipping/countries';
import {
  SHIPPING_LIMITS,
  documentToForm,
  errorsFor,
  fingerprintRawConfig,
  migrationCandidate,
  parseShippingForm,
  replaceInvalidShippingConfig,
  saveRuntimeShippingConfig,
  validateShippingDocument,
  type ShippingFormModel,
  type ShippingValidationError,
} from '../../features/shipping/settings';

export const prerender = false;

const settings = Astro.locals.settings;
const config = getConfig();
const currency = config.currency;
const unit: WeightUnit = settings?.weightUnit ?? 'g';
const parsed = settings?.shippingConfig ?? { status: 'absent' as const };

const invalidFingerprint =
  parsed.status === 'invalid' ? await fingerprintRawConfig(parsed.raw) : null;

const countries = countryOptions();
let errors: ShippingValidationError[] = [];
let notice: string | null = null;
let conflict = false;
let saved = Astro.url.searchParams.get('saved') === '1';

function blankRate(token: string) {
  return { token, label: '', mode: 'flat' as const, amountValue: '', bands: [] };
}
function blankZone(token: string) {
  return {
    token,
    name: '',
    countries: [] as string[],
    rates: [blankRate(`${token}_r1`)],
    freeOverValue: '',
  };
}

function initialModel(): ShippingFormModel {
  if (parsed.status === 'valid') {
    return documentToForm(parsed.config, currency, unit, formatWeightValue);
  }
  return migrationCandidate(config.shipping, settings?.shippingEnabled ?? null, currency);
}

let model: ShippingFormModel = initialModel();
let prepopulated = false;

if (Astro.request.method === 'POST') {
  const guard = await guardAdminApi(env.DB, {
    locals: Astro.locals,
    cookies: Astro.cookies,
    request: Astro.request,
  }, 'settings.manage');
  if (!guard.ok) return guard.response;

  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? 'save');
  const parsedForm = parseShippingForm(form, { currency, unit });
  model = parsedForm.model;

  if (action === 'add_zone') {
    model.zones = [...model.zones, blankZone(`z${model.zones.length + 1}_${Date.now()}`)].slice(
      0,
      SHIPPING_LIMITS.zones,
    );
  } else if (action.startsWith('remove_zone:')) {
    const token = action.slice('remove_zone:'.length);
    model.zones = model.zones.filter((z) => z.token !== token);
  } else if (action.startsWith('move_zone:')) {
    const [token, dir] = action.slice('move_zone:'.length).split(':');
    const i = model.zones.findIndex((z) => z.token === token);
    const j = dir === 'up' ? i - 1 : i + 1;
    if (i >= 0 && j >= 0 && j < model.zones.length) {
      const next = [...model.zones];
      [next[i], next[j]] = [next[j]!, next[i]!];
      model.zones = next;
    }
  } else if (action.startsWith('add_rate:')) {
    const token = action.slice('add_rate:'.length);
    model.zones = model.zones.map((z) =>
      z.token === token
        ? { ...z, rates: [...z.rates, blankRate(`${z.token}_r${z.rates.length + 1}_${Date.now()}`)] }
        : z,
    );
  } else if (action.startsWith('remove_rate:')) {
    const [zoneToken, rateToken] = action.slice('remove_rate:'.length).split(':');
    model.zones = model.zones.map((z) =>
      z.token === zoneToken ? { ...z, rates: z.rates.filter((r) => r.token !== rateToken) } : z,
    );
  } else if (action.startsWith('add_band:')) {
    const [zoneToken, rateToken] = action.slice('add_band:'.length).split(':');
    model.zones = model.zones.map((z) =>
      z.token !== zoneToken
        ? z
        : {
            ...z,
            rates: z.rates.map((r) =>
              r.token !== rateToken
                ? r
                : {
                    ...r,
                    bands: [
                      ...r.bands,
                      {
                        token: `${r.token}_b${r.bands.length + 1}_${Date.now()}`,
                        upToValue: '',
                        noMax: false,
                        amountValue: '',
                      },
                    ].slice(0, SHIPPING_LIMITS.bandsPerRate),
                  },
            ),
          },
    );
  } else if (action.startsWith('remove_band:')) {
    const [zoneToken, rateToken, bandToken] = action.slice('remove_band:'.length).split(':');
    model.zones = model.zones.map((z) =>
      z.token !== zoneToken
        ? z
        : {
            ...z,
            rates: z.rates.map((r) =>
              r.token !== rateToken ? r : { ...r, bands: r.bands.filter((b) => b.token !== bandToken) },
            ),
          },
    );
  } else {
    errors = parsedForm.errors;

    if (errors.length === 0 && zonesRequireWeight({ ...parsedForm.document } as ShippingConfig)) {
      const missing = await countProductsMissingWeight(env.DB);
      if (missing > 0) {
        const names = await sampleProductsMissingWeight(env.DB);
        errors = [
          {
            field: 'document',
            message: `${missing} محصول (${names.join('، ')}) فاقد وزن ارسال هستند و امکان ثبت تعرفه وزنی وجود ندارد.`,
          },
        ];
      }
    }

    if (errors.length === 0) {
      const result =
        action === 'replace' && invalidFingerprint
          ? await replaceInvalidShippingConfig(env.DB, String(form.get('fingerprint') ?? ''), parsedForm.document)
          : await saveRuntimeShippingConfig(env.DB, parsedForm.revision, parsedForm.document);

      if (result.ok) {
        await recordAdminAuditLog(env.DB, {
          action: 'shipping.updated',
          module: 'settings',
          targetType: 'shipping',
          targetId: 'shipping_config',
          actor: guard.actor.id,
        });
        return Astro.redirect('/admin/shipping?saved=1', 303);
      }
      if (result.reason === 'conflict') {
        conflict = true;
        notice = 'تنظیمات ارسال در تب دیگری تغییر کرده است. صفحه را بازخوانی کرده و دوباره ذخیره کنید.';
      } else if (result.reason === 'too_large') {
        notice = 'حجم پیکربندی ارسال بیش از حد مجاز است. برخی مناطق یا تعرفه‌ها را کم کنید.';
      } else {
        errors = result.errors ?? [];
      }
    }
    saved = false;
  }
} else if (parsed.status !== 'valid') {
  const preview = parseModelForPreview(model);
  errors = preview;
  prepopulated = preview.length > 0;
}

function parseModelForPreview(m: ShippingFormModel): ShippingValidationError[] {
  return validateShippingDocument({
    schema: 2,
    revision: m.revision + 1,
    enabled: m.enabled,
    packageWeightGrams: 0,
    zones: m.zones.map((z) => ({
      name: z.name,
      countries: z.countries,
      freeOverCents: z.freeOverValue === '' ? null : toMinorUnits(Number(z.freeOverValue), currency),
      rates: z.rates.map((r) => ({
        label: r.label,
        pricing:
          r.mode === 'weight'
            ? {
                type: 'weight' as const,
                bands: r.bands.map((b) => ({
                  upToGrams: b.noMax ? null : Number(b.upToValue),
                  amountCents: toMinorUnits(Number(b.amountValue), currency),
                })),
              }
            : { type: 'flat' as const, amountCents: toMinorUnits(Number(r.amountValue), currency) },
      })),
    })),
  });
}

const documentErrors = errorsFor(errors).filter((e) => e.field === 'document' || e.field === 'packageWeight');
const isFirstSave = parsed.status !== 'valid';
---

<AdminLayout
  title="تنظیمات ارسال و تعرفه‌ها"
  active="shipping"
  requiredPermission="settings.manage"
  breadcrumbs={[{ label: 'سیستم و پیکربندی' }, { label: 'تنظیمات ارسال' }]}
>
  <AdminPageHeader
    title="مدیریت روش‌های ارسال و تعرفه‌ها"
    subtitle={`پیکربندی مناطق ارسال، تعرفه‌های ثابت یا وزنی (بر حسب ${currency.toUpperCase()}) و آستانه ارسال رایگان`}
  >
    <a slot="actions" href="/admin/settings" class="gg-admin-btn-secondary text-xs">
      بازگشت به تنظیمات ←
    </a>
  </AdminPageHeader>

  {saved && (
    <div class="gg-status-success mb-6 rounded-xl px-4 py-3 text-sm">
      پیکربندی ارسال و تعرفه‌ها با موفقیت ذخیره شد.
    </div>
  )}
  {notice && (
    <div class={`mb-6 rounded-xl px-4 py-3 text-sm ${conflict ? 'gg-status-warning' : 'gg-status-error'}`}>
      {notice}
    </div>
  )}
  {parsed.status === 'invalid' && (
    <div class="gg-status-error mb-6 rounded-xl px-4 py-3 text-sm">
      <strong>پیکربندی ذخیره‌شده ارسال قابل خواندن نیست:</strong> {parsed.error}
    </div>
  )}
  {prepopulated && (
    <div class="gg-status-warning mb-6 rounded-xl px-4 py-3 text-sm">
      این فروشگاه هنوز از تنظیمات پیش‌فرض فایل پیکربندی استفاده می‌کند؛ موارد مشخص‌شده را بررسی و ذخیره کنید.
    </div>
  )}
  {isFirstSave && !prepopulated && (
    <div class="gg-admin-card mb-6 px-4 py-3 text-xs text-muted">
      برای سفارش‌های دیجیتال نیازی به فعال‌سازی ارسال فیزیکی نیست؛ این بخش صرفاً برای محصولات فیزیکی یا تحویل زمان‌دار استفاده می‌شود.
    </div>
  )}

  <form method="POST" class="space-y-6">
    <input type="hidden" name="revision" value={model.revision} />
    {invalidFingerprint && <input type="hidden" name="fingerprint" value={invalidFingerprint} />}
    <input type="hidden" name="zone_order" value={model.zones.map((z) => z.token).join(',')} />

    <section class="gg-admin-card p-5">
      <label class="flex items-center gap-3 text-sm font-semibold text-ink">
        <input type="checkbox" name="enabled" value="1" checked={model.enabled} class="h-4 w-4 rounded border-line text-brand" />
        <span>فعال‌سازی محاسبه ارسال در تسویه‌حساب (فقط برای کالاهای نیازمند آدرس/ارسال)</span>
      </label>
      <div class="mt-4 flex flex-wrap items-end gap-3">
        <label class="block">
          <span class="mb-1 block text-xs font-semibold text-muted">وزن بسته‌بندی ({unit})</span>
          <input
            type="text"
            name="package_weight"
            value={model.packageWeightValue}
            inputmode="decimal"
            dir="ltr"
            class="gg-admin-input ltr-inline w-32 py-1.5 font-mono text-xs"
          />
        </label>
        <p class="text-xs text-muted">یک‌بار برای هر سفارش به وزن کل اقلام اضافه می‌شود.</p>
      </div>
      {documentErrors.map((e) => (
        <p class="mt-3 text-xs text-coral">{e.message}</p>
      ))}
    </section>

    {model.zones.map((zone, zoneIndex) => (
      <section class="gg-admin-card p-5">
        <input type="hidden" name={`zone[${zone.token}][rate_order]`} value={zone.rates.map((r) => r.token).join(',')} />
        <div class="flex flex-wrap items-end justify-between gap-3">
          <label class="block flex-1">
            <span class="mb-1 block text-xs font-semibold text-muted">نام منطقه ارسال</span>
            <input
              type="text"
              name={`zone[${zone.token}][name]`}
              value={zone.name}
              maxlength={SHIPPING_LIMITS.zoneName}
              class="gg-admin-input py-1.5 text-sm"
            />
          </label>
          <div class="flex gap-2 text-xs">
            <button name="_action" value={`move_zone:${zone.token}:up`} class="gg-admin-btn-secondary py-1 text-xs" disabled={zoneIndex === 0}>بالا</button>
            <button name="_action" value={`move_zone:${zone.token}:down`} class="gg-admin-btn-secondary py-1 text-xs" disabled={zoneIndex === model.zones.length - 1}>پایین</button>
            <button name="_action" value={`remove_zone:${zone.token}`} class="gg-admin-btn-danger py-1 text-xs">حذف منطقه</button>
          </div>
        </div>
        {errorsFor(errors, zoneIndex).map((e) => (
          <p class="mt-2 text-xs text-coral">{e.message}</p>
        ))}

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="mb-1 block text-xs font-semibold text-muted">کشورها / مقصدها</span>
            <select
              name={`zone[${zone.token}][countries][]`}
              multiple
              size="5"
              class="gg-admin-input text-xs"
            >
              <option value="*" selected={zone.countries.includes('*')}>سایر نقاط / سراسری (*)</option>
              {countries.map((c) => (
                <option value={c.code} selected={zone.countries.includes(c.code)}>{c.name}</option>
              ))}
            </select>
            {zone.countries.filter((c) => c !== '*' && !countries.some((k) => k.code === c)).map((c) => (
              <span class="gg-status-error mt-1 inline-block rounded px-2 py-0.5 text-xs">
                کد نامشخص: {c}
                <input type="hidden" name={`zone[${zone.token}][countries][]`} value={c} />
              </span>
            ))}
          </label>
          <label class="block">
            <span class="mb-1 block text-xs font-semibold text-muted">آستانه ارسال رایگان ({currency.toUpperCase()})</span>
            <input
              type="text"
              name={`zone[${zone.token}][free_over]`}
              value={zone.freeOverValue}
              inputmode="decimal"
              dir="ltr"
              class="gg-admin-input ltr-inline py-1.5 font-mono text-sm"
            />
            <span class="mt-1 block text-[11px] text-faint">در صورت خالی بودن غیرفعال است.</span>
          </label>
        </div>

        <div class="mt-5 space-y-3">
          {zone.rates.map((rate, rateIndex) => (
            <div class="rounded-xl border border-line bg-surface-2 p-4">
              <div class="flex flex-wrap items-end gap-3">
                <label class="block">
                  <span class="mb-1 block text-xs font-semibold text-muted">عنوان تعرفه</span>
                  <input
                    type="text"
                    name={`zone[${zone.token}][rate][${rate.token}][label]`}
                    value={rate.label}
                    maxlength={SHIPPING_LIMITS.rateLabel}
                    class="gg-admin-input w-44 py-1.5 text-xs"
                  />
                </label>
                <label class="block">
                  <span class="mb-1 block text-xs font-semibold text-muted">نحوه محاسبه</span>
                  <select name={`zone[${zone.token}][rate][${rate.token}][mode]`} class="gg-admin-input py-1.5 text-xs">
                    <option value="flat" selected={rate.mode === 'flat'}>نرخ ثابت</option>
                    <option value="weight" selected={rate.mode === 'weight'}>بر اساس وزن</option>
                    <option value="pickup" selected={rate.mode === 'pickup'}>تحویل حضوری</option>
                  </select>
                </label>
                {rate.mode !== 'weight' && (
                  <label class="block">
                    <span class="mb-1 block text-xs font-semibold text-muted">
                      {rate.mode === 'pickup' ? 'هزینه (۰ = رایگان)' : 'مبلغ'}
                    </span>
                    <input
                      type="text"
                      name={`zone[${zone.token}][rate][${rate.token}][amount]`}
                      value={rate.amountValue}
                      inputmode="decimal"
                      dir="ltr"
                      class="gg-admin-input ltr-inline w-32 py-1.5 font-mono text-xs"
                    />
                  </label>
                )}
                <button
                  name="_action"
                  value={`remove_rate:${zone.token}:${rate.token}`}
                  class="gg-admin-btn-danger ms-auto py-1.5 text-xs"
                >
                  حذف تعرفه
                </button>
              </div>
              {errorsFor(errors, zoneIndex, rateIndex).map((e) => (
                <p class="mt-2 text-xs text-coral">{e.message}</p>
              ))}

              {rate.mode === 'weight' && (
                <div class="mt-3 border-t border-line pt-3">
                  <input
                    type="hidden"
                    name={`zone[${zone.token}][rate][${rate.token}][band_order]`}
                    value={rate.bands.map((b) => b.token).join(',')}
                  />
                  <p class="mb-2 text-xs font-semibold text-muted">بازه‌های وزنی</p>
                  {rate.bands.map((band, bandIndex) => (
                    <div class="mb-2 flex flex-wrap items-end gap-3">
                      <label class="block">
                        <span class="text-xs text-muted">تا سقف ({unit})</span>
                        <input
                          type="text"
                          name={`zone[${zone.token}][rate][${rate.token}][band][${band.token}][up_to]`}
                          value={band.upToValue}
                          disabled={band.noMax}
                          inputmode="decimal"
                          dir="ltr"
                          class="gg-admin-input ltr-inline mt-1 w-28 py-1 font-mono text-xs disabled:opacity-50"
                        />
                      </label>
                      {bandIndex === rate.bands.length - 1 && (
                        <label class="flex items-center gap-2 pb-1 text-xs text-muted">
                          <input
                            type="checkbox"
                            name={`zone[${zone.token}][rate][${rate.token}][band][${band.token}][no_max]`}
                            value="1"
                            checked={band.noMax}
                            class="h-4 w-4 rounded border-line text-brand"
                          />
                          بدون سقف
                        </label>
                      )}
                      <label class="block">
                        <span class="text-xs text-muted">هزینه</span>
                        <input
                          type="text"
                          name={`zone[${zone.token}][rate][${rate.token}][band][${band.token}][amount]`}
                          value={band.amountValue}
                          inputmode="decimal"
                          dir="ltr"
                          class="gg-admin-input ltr-inline mt-1 w-28 py-1 font-mono text-xs"
                        />
                      </label>
                      <button
                        name="_action"
                        value={`remove_band:${zone.token}:${rate.token}:${band.token}`}
                        class="pb-1 text-xs font-semibold text-coral hover:underline"
                      >
                        حذف
                      </button>
                      {errorsFor(errors, zoneIndex, rateIndex, bandIndex).map((e) => (
                        <p class="w-full text-xs text-coral">{e.message}</p>
                      ))}
                    </div>
                  ))}
                  <button
                    name="_action"
                    value={`add_band:${zone.token}:${rate.token}`}
                    class="text-xs font-semibold text-brand-fg hover:underline"
                  >
                    + افزودن بازه وزنی
                  </button>
                </div>
              )}
            </div>
          ))}
          <button
            name="_action"
            value={`add_rate:${zone.token}`}
            class="text-xs font-semibold text-brand-fg hover:underline"
          >
            + افزودن تعرفه ارسال
          </button>
        </div>
      </section>
    ))}

    <div class="flex flex-wrap items-center gap-4">
      <button
        name="_action"
        value={parsed.status === 'invalid' ? 'replace' : 'save'}
        class="gg-admin-btn-primary text-xs"
      >
        {parsed.status === 'invalid' ? 'جایگزینی پیکربندی خراب و ذخیره' : 'ذخیره تنظیمات ارسال'}
      </button>
      <button name="_action" value="add_zone" class="gg-admin-btn-secondary text-xs">
        + افزودن منطقه ارسال جدید
      </button>
    </div>
  </form>
</AdminLayout>
