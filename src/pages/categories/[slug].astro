---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import {
  getCategoryBySlug,
  ancestors,
  listCategories,
  childrenOf,
  productsInCategory,
  countProductsInCategory,
} from '../../features/categories/db';
import { loadVariantSummariesForProducts } from '../../features/homepage/db';
import ProductCard from '#theme/ProductCard.astro';
import { buildProductCard } from '../../features/storefront/productCard';
import { getConfig } from '../../config';
import { publicOrigin } from '../../features/http/origin';
import { orderByClause, parseStoreSortQuery } from '../../features/products/sort';
import { MAX_PUBLIC_PAGE, paginate, queryHref } from '../../pagination';
import Pagination from '../../components/Pagination.astro';
import CatalogSort from '../../features/storefront/controls/CatalogSort.astro';
import { buildSortModel } from '../../features/storefront/catalog';
import { catalogPath } from '../../features/settings/home';
import { addCacheTags, productCacheTags } from '../../features/cache/tags';
import { fa } from '../../i18n/fa';
import { toPersianDigits } from '../../lib/format';

const { slug } = Astro.params;
const category = slug ? await getCategoryBySlug(env.DB, slug) : null;

if (!category) {
  return new Response('یافت نشد', { status: 404 });
}

const { sort, dir } = parseStoreSortQuery(
  Astro.url.searchParams.get('sort'),
  Astro.url.searchParams.get('dir'),
);
const order = orderByClause(sort, dir);

const PAGE_SIZE = 24;
const [trail, categories, total] = await Promise.all([
  ancestors(env.DB, category.id),
  listCategories(env.DB),
  countProductsInCategory(env.DB, category.id),
]);
const subcats = childrenOf(categories, category.id);
const { page, offset, totalPages } = paginate(
  Astro.url.searchParams,
  total,
  PAGE_SIZE,
  MAX_PUBLIC_PAGE,
);
const products = await productsInCategory(env.DB, category.id, PAGE_SIZE, offset, order);
addCacheTags(Astro.response.headers, productCacheTags(products.map((product) => product.public_id)));

const variantSummaries = await loadVariantSummariesForProducts(
  env.DB,
  products.map((p) => p.id),
);

const cards = products.map((product, i) => {
  const card = buildProductCard(product, {
    baseUrl: getConfig().images.baseUrl,
    currency: getConfig().currency,
    delivery: Astro.locals.settings?.imageDelivery,
    sizes: '(min-width: 1024px) 352px, calc(50vw - 36px)',
    priority: i === 0,
  });
  const v = variantSummaries.get(product.id);
  if (v && v.count > 0) {
    return {
      ...card,
      variantCount: v.count,
      variantSummary:
        v.sampleLabels.length > 0 ? v.sampleLabels.slice(0, 2).join(' · ') : `${v.count} گزینه`,
    };
  }
  return card;
});

const base = `/categories/${category.slug}`;
const hrefFor = (p: number) =>
  queryHref(base, {
    sort: sort === 'newest' ? undefined : sort,
    dir: dir === 'desc' ? undefined : dir,
    page: p > 1 ? p : undefined,
  });
const shopHref = catalogPath(Astro.locals.settings?.homePage);
const categoryDesc = (category as { description?: string | null }).description ?? null;

const origin = publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN);
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: category.name,
      description: categoryDesc || `خرید محصولات دسته‌بندی ${category.name} در GarGift+`,
      url: `${origin}${base}`,
      inLanguage: 'fa-IR',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: fa.navigation.home,
          item: `${origin}/`,
        },
        ...trail.map((c, idx) => ({
          '@type': 'ListItem',
          position: idx + 2,
          name: c.name,
          item: `${origin}/categories/${c.slug}`,
        })),
      ],
    },
  ],
});
---

<Layout
  title={category.name}
  description={categoryDesc || `خرید محصولات دسته‌بندی ${category.name} در فروشگاه GarGift+`}
  jsonLd={jsonLd}
>
  <nav
    aria-label="مسیر صفحه"
    class="mb-4 flex flex-wrap items-center gap-x-2 text-xs font-medium text-faint"
  >
    <a href="/" class="transition-colors hover:text-brand-fg">{fa.navigation.home}</a>
    <span aria-hidden="true">/</span>
    <a href={shopHref} class="transition-colors hover:text-brand-fg">{fa.navigation.shop}</a>
    {
      trail.map((c) => (
        <span class="flex items-center gap-x-2">
          <span aria-hidden="true">/</span>
          <a href={`/categories/${c.slug}`} class="transition-colors hover:text-brand-fg">
            {c.name}
          </a>
        </span>
      ))
    }
  </nav>

  <div class="mb-8 rounded-2xl border border-line bg-surface p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-xs font-bold text-accent-fg">دسته‌بندی محصولات دیجیتال</p>
        <h1 class="gg-h1 mt-1 text-ink">{category.name}</h1>
      </div>
      <span class="gg-numeric rounded-lg border border-line bg-paper px-3 py-1.5 text-xs font-bold text-muted">
        {toPersianDigits(total)} محصول فعال
      </span>
    </div>
    {categoryDesc && (
      <p class="mt-2.5 max-w-3xl text-xs leading-relaxed text-muted sm:text-sm">
        {categoryDesc}
      </p>
    )}
  </div>

  {
    subcats.length > 0 && (
      <div class="mb-8 flex flex-wrap gap-2 text-xs">
        {subcats.map((c) => (
          <a
            href={`/categories/${c.slug}`}
            class="rounded-lg border border-line bg-surface px-3.5 py-1.5 font-medium text-muted transition-colors hover:border-brand-accent hover:text-brand-fg"
          >
            {c.name}
          </a>
        ))}
      </div>
    )
  }

  <CatalogSort model={buildSortModel(base, sort, dir)} />

  {
    products.length === 0 && (
      <div
        role="status"
        class="rounded-xl border border-dashed border-line bg-surface p-8 text-center text-sm text-muted"
      >
        هنوز محصولی در این دسته‌بندی ثبت نشده است.
      </div>
    )
  }

  <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      cards.map((card, i) => (
        <ProductCard card={card} index={i} />
      ))
    }
  </ul>

  <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
</Layout>
