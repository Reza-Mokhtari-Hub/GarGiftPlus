---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { formatPrice } from '../config';
import { getProductByPublicId } from '../features/products/db';
import { listVariants, getExtrasByPublicIds } from '../features/products/variants';
import { parsePublicId } from '../features/ids/publicId.ts';
import { lineUnitPriceCents } from '../features/cart/key';
import { shippingFor } from '../features/shipping/effective';
import { shipmentWeightFor } from '../features/shipping/lines';
import { stripeDestination } from '../features/shipping/destination';
import { readCart, resolveCart } from '../features/cart/cart';
import { enabledMethods } from '../features/payments';
import ProductImage from '../features/products/ProductImage.astro';
import { listProductCheckoutFields } from '../features/products/customFieldsDb';
import {
  validateCustomerInputs,
  type NormalizedCustomerInput,
} from '../features/products/customFields';
import {
  getCartLineInputForProduct,
  getCartSession,
  getOrCreateCartSession,
  saveCartLineInputs,
} from '../features/cart/inputsDb';
import { getVerifiedCustomer } from '../features/auth/customer';
import { getOrCreateWalletByCustomerId } from '../features/wallet/db';
import { fa } from '../i18n/fa';

// Express checkout — a single payment-method-picker step (first listed = the
// store's default). Accepts POST for Buy now so customer custom fields are
// NEVER sent or leaked in URL query parameters.
const isPost = Astro.request.method === 'POST';
const form = isPost ? await Astro.request.formData() : null;
const fld = (n: string) => (form?.get(n) ?? Astro.url.searchParams.get(n) ?? '').toString().trim();

interface DisplayLine {
  name: string;
  imageKey: string | null;
  unitPriceCents: number;
  qty: number;
  currency?: string;
  customerInputs?: NormalizedCustomerInput[];
}

const productPublicId = parsePublicId(fld('product_id'), 'product');
const isBuyNow = productPublicId !== null;

let lines: DisplayLine[] = [];
let weightLines: Parameters<typeof shipmentWeightFor>[0] = [];
let carry: { name: string; value: string }[] = [];
let backHref = '/';

if (isBuyNow && productPublicId) {
  const product = await getProductByPublicId(env.DB, productPublicId);
  if (!product || !product.active || !product.public_id) return Astro.redirect('/', 303);
  backHref = `/products/${product.slug}`;

  const variantPublicId = parsePublicId(fld('variant_id'), 'variant');
  const extraPublicIds = (isPost ? form!.getAll('extra') : Astro.url.searchParams.getAll('extra'))
    .map((e) => parsePublicId(e, 'extra'))
    .filter((x): x is string => x !== null);

  const variants = await listVariants(env.DB, product.id);
  const variant =
    variants.length > 0 && variantPublicId
      ? (variants.find((v) => v.public_id === variantPublicId) ?? null)
      : null;
  if (variants.length > 0 && !variant) {
    return Astro.redirect(
      `/products/${product.slug}?error=${encodeURIComponent(`لطفاً ${product.variant_label || 'گزینه'} را انتخاب کنید.`)}`,
      303,
    );
  }
  const extras = extraPublicIds.length
    ? await getExtrasByPublicIds(env.DB, product.id, extraPublicIds)
    : [];

  // Only physical shipping products check stock; digital products never block on stock <= 0.
  if (product.requires_shipping === 1 && (variant ? variant.stock : product.stock) <= 0) {
    return Astro.redirect(`/products/${product.slug}?error=${encodeURIComponent(fa.product.unavailable)}`, 303);
  }

  // Validate custom checkout fields on Buy Now and persist in D1 (never URL query params).
  const checkoutFields = await listProductCheckoutFields(env.DB, product.id);
  let customerInputs: NormalizedCustomerInput[] = [];
  let cartInputId: string | null = null;
  const cartSession = getCartSession(Astro.cookies);
  const passedInputId = parsePublicId(fld('cart_input_id'), 'cartInput');

  if (passedInputId && cartSession) {
    const stored = await getCartLineInputForProduct(env.DB, cartSession, passedInputId, product.public_id);
    if (stored) {
      const check = validateCustomerInputs(
        checkoutFields,
        Object.fromEntries(stored.map((item) => [item.key, item.value])),
      );
      if (!check.ok) {
        return Astro.redirect(`/products/${product.slug}?error=${encodeURIComponent(check.error)}`, 303);
      }
      customerInputs = check.values;
      cartInputId = passedInputId;
    }
  } else if (checkoutFields.some((f) => f.is_active === 1)) {
    if (!isPost) {
      return Astro.redirect(
        `/products/${product.slug}?error=${encodeURIComponent('لطفاً ابتدا فرم اطلاعات مورد نیاز محصول را تکمیل کنید.')}`,
        303,
      );
    }
    const check = validateCustomerInputs(checkoutFields, form!);
    if (!check.ok) {
      return Astro.redirect(`/products/${product.slug}?error=${encodeURIComponent(check.error)}`, 303);
    }
    customerInputs = check.values;
    if (customerInputs.length > 0) {
      const sid = getOrCreateCartSession(Astro.cookies, Astro.url.protocol === 'https:');
      cartInputId = await saveCartLineInputs(env.DB, sid, product.public_id, customerInputs);
    }
  }

  lines = [
    {
      name:
        product.name +
        (variant ? ` — ${variant.label}` : '') +
        (extras.length ? ` (${extras.map((e) => e.label).join(', ')})` : ''),
      imageKey: product.image_key,
      unitPriceCents: lineUnitPriceCents(product.price_cents, variant, extras),
      qty: 1,
      currency: product.currency,
      ...(customerInputs.length > 0 ? { customerInputs } : {}),
    },
  ];
  weightLines = [{ product, variant, qty: 1 }];
  carry = [{ name: 'product_id', value: productPublicId }];
  if (variant?.public_id) carry.push({ name: 'variant_id', value: variant.public_id });
  for (const e of extras) {
    if (e.public_id) carry.push({ name: 'extra', value: e.public_id });
  }
  if (cartInputId) carry.push({ name: 'cart_input_id', value: cartInputId });
} else {
  const { lines: cartLines } = await resolveCart(
    env.DB,
    readCart(Astro.cookies),
    getCartSession(Astro.cookies),
  );
  if (cartLines.length === 0) return Astro.redirect('/cart', 303);
  const short = cartLines.find((l) => l.product.requires_shipping === 1 && l.qty > l.availableStock);
  if (short) {
    return Astro.redirect(
      `/cart?error=${encodeURIComponent(fa.cart.unavailableItem)}`,
      303,
    );
  }
  backHref = '/cart';
  lines = cartLines.map((l) => ({
    name:
      l.product.name +
      (l.variant ? ` — ${l.variant.label}` : '') +
      (l.extras.length ? ` (${l.extras.map((e) => e.label).join(', ')})` : ''),
    imageKey: l.product.image_key,
    unitPriceCents: l.unitPriceCents,
    qty: l.qty,
    currency: l.product.currency,
    ...(l.customerInputs && l.customerInputs.length > 0 ? { customerInputs: l.customerInputs } : {}),
  }));
  weightLines = cartLines.map((l) => ({ product: l.product, variant: l.variant, qty: l.qty }));
  carry = [{ name: 'source', value: 'cart' }];
}

const totalCents = lines.reduce((s, l) => s + l.unitPriceCents * l.qty, 0);
const lineCurrency = lines[0]?.currency;

const customer = await getVerifiedCustomer(Astro.cookies);
const wallet = customer ? await getOrCreateWalletByCustomerId(env.DB, customer.id) : null;
const walletHint =
  customer && wallet
    ? `موجودی فعلی: ${formatPrice(wallet.balance, wallet.currency)}${wallet.balance < totalCents ? ' (نیازمند شارژ)' : ''}`
    : fa.checkout.walletMethodHint;

// Only the actually-usable rails, default first.
const methods = Astro.locals.settings ? enabledMethods(Astro.locals.settings) : [];
if (methods.length === 0) return Astro.redirect(backHref, 303);

const effectiveShipping = shippingFor(Astro.locals.settings).config;
const destination = stripeDestination(
  Astro.locals.settings,
  effectiveShipping,
  shipmentWeightFor(weightLines).shippingRequired,
  Astro.request.headers.get('cf-ipcountry'),
);

const heading = isBuyNow ? fa.checkout.buyNowHeading : fa.checkout.checkoutHeading;
const METHOD: Record<string, { label: string; hint: string }> = {
  wallet: { label: fa.checkout.walletMethodLabel, hint: walletHint },
  bank_transfer: { label: fa.checkout.bankTransferMethodLabel, hint: fa.checkout.bankTransferMethodHint },
  zarinpal: { label: fa.checkout.zarinpalMethodLabel, hint: fa.checkout.zarinpalMethodHint },
  zibal: { label: fa.checkout.zibalMethodLabel, hint: fa.checkout.zibalMethodHint },
  stripe: { label: fa.checkout.stripeMethodLabel, hint: fa.checkout.stripeMethodHint },
  lightning: { label: fa.checkout.lightningMethodLabel, hint: fa.checkout.lightningMethodHint },
  opennode: { label: fa.checkout.opennodeMethodLabel, hint: fa.checkout.opennodeMethodHint },
  demo: { label: fa.checkout.demoMethodLabel, hint: fa.checkout.demoMethodHint },
};
---

<Layout title={fa.checkout.title} description={fa.checkout.expressLabel}>
  <div class="mx-auto max-w-md">
    <p class="text-xs font-medium text-brand">{fa.checkout.expressLabel}</p>
    <h1 class="gg-h1 mt-2 mb-6 text-ink">{heading}</h1>

    <ul class="divide-y divide-line border-y border-line">
      {
        lines.map((l) => (
          <li class="flex items-start gap-4 py-4">
            <ProductImage
              imageKey={l.imageKey}
              alt=""
              usage="thumbnail"
              fade
              class="h-16 w-16 shrink-0 rounded-xl object-cover"
            />
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold text-ink">{l.name}</p>
              <p class="mt-0.5 text-xs text-muted">{fa.cart.quantity}: {l.qty}</p>
              {l.customerInputs && l.customerInputs.length > 0 && (
                <dl class="mt-2 space-y-1 rounded-lg border border-line bg-surface/60 px-2.5 py-2 text-xs">
                  {l.customerInputs.map((ci) => (
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <dt class="text-muted">{ci.label}:</dt>
                      <dd class={ci.type === 'email' || ci.type === 'number' ? 'ltr-inline font-medium text-ink' : 'font-medium text-ink'}>
                        {ci.value}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>
            <span class="tabular-nums font-semibold text-ink">{formatPrice(l.unitPriceCents * l.qty, l.currency)}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-4 flex items-center justify-between">
      <span class="text-xs font-medium text-muted">{fa.checkout.total}</span>
      <span class="text-lg font-bold tabular-nums text-ink">{formatPrice(totalCents, lineCurrency)}</span>
    </div>

    <div class="mt-6 space-y-2.5">
      {
        methods.map((m, i) => (
          <form method="POST" action="/api/checkout">
            {carry.map((c) => (
              <input type="hidden" name={c.name} value={c.value} />
            ))}
            <input type="hidden" name="method" value={m} />
            {m === 'stripe' && destination.showSelect && (
              <label class="mb-2 flex items-center justify-between gap-2 text-xs text-muted">
                مقصد ارسال
                <select
                  name="country"
                  class="rounded-lg border border-line bg-surface px-2.5 py-1.5 text-sm text-ink"
                >
                  {destination.countries.map((c) => (
                    <option value={c} selected={c === destination.defaultCountry}>
                      {destination.label(c)}
                    </option>
                  ))}
                </select>
              </label>
            )}
            {m === 'stripe' && destination.hiddenOnly && (
              <input type="hidden" name="country" value={destination.countries[0]} />
            )}
            <button
              type="submit"
              class={`flex w-full items-center justify-between gap-3 rounded-xl px-5 py-3.5 text-start transition ${
                i === 0
                  ? 'bg-brand text-on-brand hover:bg-brand-hover'
                  : 'border border-line text-ink hover:border-brand'
              }`}
            >
              <span>
                <span class="block text-sm font-semibold">{METHOD[m]?.label ?? m}</span>
                <span class={`block text-xs ${i === 0 ? 'text-on-brand/80' : 'text-muted'}`}>
                  {METHOD[m]?.hint ?? ''}
                </span>
              </span>
              <span aria-hidden="true" class={i === 0 ? 'text-on-brand/80' : 'text-faint'}>
                &larr;
              </span>
            </button>
          </form>
        ))
      }
    </div>

    <a
      href={backHref}
      class="mt-6 inline-block text-xs font-medium text-faint hover:text-brand"
    >
      &rarr; {fa.common.back}
    </a>
  </div>
</Layout>
