---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { formatPrice, getConfig } from '../../config';
import { getOrderByPublicId, listOrderItems } from '../../features/orders/db';
import { orderNumber } from '../../features/orders/number';
import { isLegacyPublicId, publicIdToken } from '../../features/ids/publicId.ts';
import { isAccessToken } from '../../features/ids/token.ts';
import { resolveAccessToken } from '../../features/orders/guestAccess.ts';
import { clearCart } from '../../features/cart/cart';
import { catalogPath } from '../../features/settings/home';
import { parseStoredCustomerInputs } from '../../features/products/customFields';
import { fa } from '../../i18n/fa';
import { getCustomerOrderDeliveryView } from '../../features/fulfillment/db';
import CustomerOrderDeliveryPanel from '../../features/fulfillment/CustomerOrderDeliveryPanel.astro';

const { token } = Astro.params;
let order = null;
if (token && isAccessToken(token)) {
  const access = await resolveAccessToken(env.DB, token);
  order = access ? await getOrderByPublicId(env.DB, access.order_public_id) : null;
} else if (token && isLegacyPublicId(token)) {
  order = await getOrderByPublicId(env.DB, token);
} else if (token) {
  return new Response('Not found', { status: 404 });
}

Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');

if (order) clearCart(Astro.cookies);
const items = order ? await listOrderItems(env.DB, order.id) : [];
const deliveryView = order ? await getCustomerOrderDeliveryView(env.DB, order, items) : null;
const timeZone = Astro.locals.settings?.timeZone ?? getConfig().timeZone;

const orderRef = order
  ? (publicIdToken(order.public_id ?? '', 'order') ?? String(orderNumber(order.id, getConfig().orderNumber)))
  : null;

const PAYMENT_LABELS: Record<string, string> = {
  wallet: 'کیف پول GarGift+',
  bank_transfer: 'کارت‌به‌کارت و واریز بانکی',
  zarinpal: 'درگاه پرداخت زرین‌پال',
  zibal: 'درگاه پرداخت زیبال',
  stripe: 'کارت بانکی بین‌المللی',
  lightning: 'لایتنینگ',
  opennode: 'بیت‌کوین',
  demo: 'پرداخت آزمایشی (دمو)',
};
const paymentLabel = order?.payment_method ? PAYMENT_LABELS[order.payment_method] ?? null : null;
const shopHref = catalogPath(Astro.locals.settings?.homePage);
---

<Layout title={order ? fa.orders.confirmedHeading : fa.orders.confirmingHeading}>
  {
    order ? (
      <Fragment>
        <h1 class="gg-h1 mb-2 text-ink">{fa.orders.confirmedHeading}</h1>
        <p class="mb-6 text-sm text-muted">
          {fa.orders.orderNumber} <span class="ltr-inline font-mono font-semibold text-ink">#{orderRef}</span>
          {order.email && (
            <Fragment>
              {' '}· {fa.orders.receiptSentPrefix} <span class="ltr-inline">{order.email}</span>
            </Fragment>
          )}
        </p>

        <div class="overflow-hidden rounded-2xl border border-line bg-surface">
          <table class="w-full text-start text-sm">
            <thead class="bg-surface text-muted">
              <tr>
                <th class="px-4 py-3 font-medium">{fa.orders.itemCol}</th>
                <th class="px-4 py-3 font-medium">{fa.orders.qtyCol}</th>
                <th class="px-4 py-3 text-end font-medium">{fa.orders.totalCol}</th>
              </tr>
            </thead>
            <tbody>
              {items.map((it) => {
                const customerInputs = parseStoredCustomerInputs(it.customer_inputs_json);
                return (
                  <tr class="border-t border-line align-top">
                    <td class="px-4 py-3">
                      <div class="font-medium text-ink">{it.name}</div>
                      {customerInputs.length > 0 && (
                        <dl class="mt-2 space-y-1 rounded-xl border border-line bg-paper/70 px-3 py-2 text-xs">
                          <dt class="sr-only">{fa.orders.customerInputsLabel}</dt>
                          {customerInputs.map((ci) => (
                            <div class="flex flex-wrap items-baseline justify-between gap-2">
                              <dt class="text-muted">{ci.label}:</dt>
                              <dd
                                class={
                                  ci.type === 'email' || ci.type === 'number'
                                    ? 'ltr-inline font-medium text-ink'
                                    : 'font-medium text-ink'
                                }
                              >
                                {ci.value}
                              </dd>
                            </div>
                          ))}
                        </dl>
                      )}
                    </td>
                    <td class="px-4 py-3 tabular-nums">{it.quantity}</td>
                    <td class="px-4 py-3 text-end font-semibold tabular-nums">
                      {formatPrice(it.price_cents * it.quantity, order.currency)}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <p class="mt-4 text-lg font-bold tabular-nums text-ink">
          {fa.orders.totalAmount}: {formatPrice(order.amount_total_cents, order.currency)}
        </p>

        {deliveryView && (
          <CustomerOrderDeliveryPanel
            order={order}
            deliveryView={deliveryView}
            timeZone={timeZone}
            attachmentDownloadBasePath={`/order/${token}/attachments`}
          />
        )}

        {items.some((item) => item.file_key) && isAccessToken(token) && (
          <section class="mt-8 rounded-2xl border border-line bg-surface p-5">
            <h2 class="gg-h2 text-ink">{fa.orders.downloadsHeading}</h2>
            <ul class="mt-3 space-y-3">
              {items.filter((item) => item.file_key && item.public_id).map((item) => (
                <li class="flex flex-wrap items-center justify-between gap-3">
                  <span>
                    <strong>{item.file_name ?? item.name}</strong>
                    {item.file_mime && <small class="ms-2 text-muted ltr-inline">{item.file_mime}</small>}
                    {item.file_size_bytes != null && (
                      <small class="ms-2 text-muted">{Math.ceil(item.file_size_bytes / 1024)} KB</small>
                    )}
                  </span>
                  {order.refunded_cents >= order.amount_total_cents ? (
                    <span class="text-sm text-muted">{fa.orders.unavailableAfterRefund}</span>
                  ) : (
                    <a
                      href={`/order/${token}/download/${item.public_id}`}
                      class="rounded-xl bg-brand px-4 py-2 text-sm font-medium text-on-brand hover:bg-brand-hover"
                    >
                      {fa.orders.downloadBtn}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
        {paymentLabel && (
          <p class="mt-4 text-sm text-muted">{fa.orders.paidWith}: {paymentLabel}</p>
        )}
        {order.refunded_cents > 0 && (
          <p class="mt-2 text-sm text-muted">
            مبلغ {formatPrice(order.refunded_cents, order.currency)} بازگشت داده شده است.
          </p>
        )}
        <a href={shopHref} class="mt-6 inline-block text-sm font-medium text-brand hover:underline">
          &rarr; {fa.cart.continueShopping}
        </a>
      </Fragment>
    ) : (
      <Fragment>
        <meta http-equiv="refresh" content="3" />
        <h1 class="gg-h1 mb-2 text-ink">{fa.orders.confirmingHeading}</h1>
        <p class="text-sm text-muted">{fa.orders.confirmingHint}</p>
      </Fragment>
    )
  }
</Layout>
