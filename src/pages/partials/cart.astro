---
import { env } from 'cloudflare:workers';
import { formatPrice } from '../../config';
import { readCart, resolveCart, cartCount } from '../../features/cart/cart';
import { getCartSession } from '../../features/cart/inputsDb';
import ProductImage from '../../features/products/ProductImage.astro';
import { getSetting } from '../../features/settings/db';
import { fa } from '../../i18n/fa';

// Astro partial: renders ONLY this fragment (no surrounding document), so the
// cart drawer can fetch and inject it. Server-rendered, so pricing still comes
// from D1 — the drawer holds no client-side cart state.
export const partial = true;
export const prerender = false;

const cart = readCart(Astro.cookies);
const cartSession = getCartSession(Astro.cookies);
const [{ lines, subtotalCents }, imageDeliverySetting] = await Promise.all([
  resolveCart(env.DB, cart, cartSession),
  getSetting(env.DB, 'image_delivery'),
]);
const imageDelivery = imageDeliverySetting === 'cloudflare' ? 'cloudflare' : 'original';
const count = cartCount(cart);
---

<div data-cart-count={count}>
  {
    lines.length === 0 ? (
      <div class="py-12 text-center">
        <p class="text-sm text-muted">{fa.cart.empty}</p>
        <a
          href="/"
          class="mt-4 inline-flex items-center justify-center rounded-xl border border-line px-4 py-2 text-xs font-medium text-ink transition hover:border-brand hover:text-brand"
        >
          {fa.cart.continueShopping}
        </a>
      </div>
    ) : (
      <Fragment>
        <ul class="divide-y divide-line">
          {lines.map((l) => (
            <li class="flex gap-3.5 py-4">
              <a href={`/products/${l.product.slug}`} class="shrink-0">
                <ProductImage
                  imageKey={l.product.image_key}
                  alt=""
                  sizes="64px"
                  fade
                  usage="thumbnail"
                  delivery={imageDelivery}
                  class="h-16 w-16 rounded-xl object-cover"
                />
              </a>
              <div class="flex min-w-0 flex-1 flex-col">
                <a
                  href={`/products/${l.product.slug}`}
                  class="text-sm font-medium leading-snug text-ink hover:text-brand"
                >
                  {l.product.name}
                </a>
                {(l.variant || l.extras.length > 0) && (
                  <span class="mt-0.5 text-xs text-muted">
                    {[l.variant?.label, ...l.extras.map((e) => e.label)].filter(Boolean).join(' · ')}
                  </span>
                )}
                {l.customerInputs && l.customerInputs.length > 0 && (
                  <dl class="mt-1.5 space-y-0.5 rounded-lg border border-line bg-surface/60 px-2.5 py-1.5 text-[11px]">
                    {l.customerInputs.map((ci) => (
                      <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <dt class="text-muted">{ci.label}:</dt>
                        <dd
                          class={
                            ci.type === 'email' || ci.type === 'number'
                              ? 'ltr-inline font-medium text-ink'
                              : 'font-medium text-ink'
                          }
                        >
                          {ci.value}
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
                <span class="mt-1 text-xs tabular-nums text-muted">
                  {formatPrice(l.unitPriceCents)}
                </span>
                <div class="mt-auto flex items-center gap-4 pt-2">
                  <form method="POST" action="/api/cart" class="flex items-center gap-2">
                    <input type="hidden" name="_action" value="update" />
                    <input type="hidden" name="key" value={l.key} />
                    <input
                      type="number"
                      name="qty"
                      min="0"
                      max="99"
                      value={l.qty}
                      aria-label={fa.cart.quantity}
                      class="w-12 rounded-md border border-line bg-transparent py-0.5 text-center text-sm tabular-nums focus:border-brand focus:outline-none"
                    />
                    <button
                      type="submit"
                      class="text-xs font-medium text-faint hover:text-brand"
                    >
                      {fa.cart.update}
                    </button>
                  </form>
                  <form method="POST" action="/api/cart" class="flex items-center">
                    <input type="hidden" name="_action" value="remove" />
                    <input type="hidden" name="key" value={l.key} />
                    <button
                      type="submit"
                      class="text-xs font-medium text-faint hover:text-red-500"
                    >
                      {fa.cart.remove}
                    </button>
                  </form>
                </div>
              </div>
              <span class="shrink-0 text-sm font-semibold tabular-nums text-ink">
                {formatPrice(l.lineTotalCents)}
              </span>
            </li>
          ))}
        </ul>

        <div class="mt-6 border-t border-line pt-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-muted">{fa.cart.subtotal}</span>
            <span class="text-lg font-bold tabular-nums text-ink">{formatPrice(subtotalCents)}</span>
          </div>
          <a
            href="/express"
            class="mt-4 block w-full rounded-xl bg-brand px-6 py-3 text-center text-sm font-semibold text-on-brand transition hover:bg-brand-hover"
          >
            {fa.cart.checkout}
          </a>
          <a
            href="/cart"
            class="mt-3 block text-center text-xs font-medium text-faint hover:text-brand"
          >
            {fa.cart.viewFullCart}
          </a>
        </div>
      </Fragment>
    )
  }
</div>
