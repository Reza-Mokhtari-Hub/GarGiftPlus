---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { getConfig } from '../../config';
import { getPendingByPublicId } from '../../features/payments/lightning/pending';
import { getOrderByPublicId } from '../../features/orders/db';
import { isLegacyPublicId } from '../../features/ids/publicId.ts';
import { isAccessToken } from '../../features/ids/token.ts';
import { resolveAccessToken } from '../../features/orders/guestAccess.ts';
import DemoCheckout from '../../features/payments/checkout/DemoCheckout.astro';
import LightningPay from '../../features/payments/checkout/LightningPay.astro';
import BankTransferPay from '../../features/payments/checkout/BankTransferPay.astro';
import {
  settleDemoCheckout,
  settleLightningOnLoad,
} from '../../features/payments/checkout/settle';
import { getVerifiedCustomer } from '../../features/auth/customer';
import { parsePublicId } from '../../features/ids/publicId.ts';
import { getLatestPaymentTxForTarget } from '../../features/payments/transactionsDb';
import { handleBankTransferReceiptPost } from '../../features/payments/receiptUpload';

// Single "complete your payment" entry point for the self-rendered rails. The
// URL carries the guest access token for new checkouts (resolved through the
// registry) or a legacy public id for pre-cutover ones — a bare ord_ public ID
// never grants guest access, unless the authenticated customer owns that order's
// payment transaction.
const guestParam = Astro.params.publicId;
let orderPublicId: string | null = null;
if (guestParam && isAccessToken(guestParam)) {
  const access = await resolveAccessToken(env.DB, guestParam);
  orderPublicId = access?.order_public_id ?? null;
} else if (guestParam && isLegacyPublicId(guestParam)) {
  orderPublicId = guestParam;
} else if (guestParam) {
  const parsedOrd = parsePublicId(guestParam, 'order');
  if (parsedOrd) {
    const customer = await getVerifiedCustomer(Astro.cookies);
    if (customer) {
      const tx = await getLatestPaymentTxForTarget(env.DB, 'order', parsedOrd);
      if (tx && (tx.customer_id === customer.id || tx.customer_email?.toLowerCase() === customer.email.toLowerCase())) {
        orderPublicId = parsedOrd;
      }
    }
  }
}
if (!orderPublicId) return new Response('Not found', { status: 404 });

// Capability URL: never cache, never leak in referrers.
Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');

// STATUS-FIRST: a settled order redirects to /order/<same guest param>
// unconditionally — even when the original pending payment has expired.
// Expiry gates only the unpaid flow below.
if (await getOrderByPublicId(env.DB, orderPublicId)) {
  return Astro.redirect(`/order/${guestParam}`, 303);
}

const pending = await getPendingByPublicId(env.DB, orderPublicId);
if (!pending) return new Response('Not found', { status: 404 });

const isDemo = pending.backend === 'demo';
const isLightning = pending.backend === 'lnbits' || pending.backend === 'phoenixd';
const isBankTransfer = pending.backend === 'bank_transfer';
const isGateway = pending.backend === 'zarinpal' || pending.backend === 'zibal';
// An unexpected backend landing here → just show the order page.
if (!isDemo && !isLightning && !isBankTransfer && !isGateway) {
  return Astro.redirect(`/order/${guestParam}`, 303);
}

// Every self-rendered pending payment now carries an expiry (Lightning: the
// invoice's; Demo: 24h; Bank transfer: 48h). Past it, the unpaid flow fails closed.
const payExpired =
  pending.status === 'expired' ||
  (pending.expires_at != null && Date.parse(pending.expires_at) <= Date.now());

// The execution context lets the confirmation emails finish after the redirect
// — settlement commits the outbox rows with the order, delivery follows behind.
const ctx = Astro.locals.cfContext;
const waitUntil = ctx ? ctx.waitUntil.bind(ctx) : undefined;

let declined: string | null = null;
if (isDemo && Astro.request.method === 'POST' && !payExpired) {
  const result = await settleDemoCheckout(
    pending,
    await Astro.request.formData(),
    Astro.url.origin,
    Astro.locals.settings,
    waitUntil,
  );
  if (result.settled) return Astro.redirect(`/order/${guestParam}`, 303);
  declined = result.declined ?? null;
}

if (isBankTransfer && Astro.request.method === 'POST' && !payExpired) {
  const receiptResult = await handleBankTransferReceiptPost(
    Astro.request,
    Astro.cookies,
    `/pay/${guestParam}`,
  );
  if ('badRequest' in receiptResult) {
    return new Response(receiptResult.badRequest, { status: 400 });
  }
  return Astro.redirect(receiptResult.redirectTo, 303);
}

if (
  isLightning &&
  !payExpired &&
  (await settleLightningOnLoad(pending, Astro.url.origin, Astro.locals.settings, waitUntil))
) {
  return Astro.redirect(`/order/${guestParam}`, 303);
}

const lightningExpired = isLightning && payExpired;
const queryError = Astro.url.searchParams.get('error');
const querySuccess = Astro.url.searchParams.get('success');

const { storeName } = getConfig();
const title = isDemo
  ? 'پرداخت آزمایشی (دمو)'
  : isBankTransfer
    ? 'پرداخت کارت‌به‌کارت'
    : isGateway
      ? 'وضعیت پرداخت درگاه بانکی'
      : 'پرداخت با لایتنینگ';
const description = isDemo
  ? `تسویه حساب آزمایشی برای ${storeName}`
  : isBankTransfer
    ? `پرداخت کارت‌به‌کارت و ثبت فیش واریزی در ${storeName}`
    : `پرداخت سفارش در ${storeName} از طریق شبکه Bitcoin Lightning`;
---

<Layout title={title} description={description}>
  {isDemo && payExpired && (
    <div class="mx-auto max-w-md rounded-2xl border border-line bg-surface p-6 text-center">
      <h1 class="gg-h2 mb-2 text-ink">مهلت پرداخت آزمایشی به پایان رسید</h1>
      <p class="text-sm text-muted">این صفحه پرداخت آزمایشی منقضی شده است. لطفاً از سبد خرید دوباره اقدام کنید.</p>
      <a
        href="/cart"
        class="mt-5 inline-flex rounded-xl bg-brand px-5 py-2.5 text-sm font-semibold text-on-brand hover:bg-brand-hover"
      >
        بازگشت به سبد خرید
      </a>
    </div>
  )}
  {isDemo && !payExpired && <DemoCheckout pending={pending} declined={declined} />}
  {isLightning && <LightningPay pending={pending} expired={lightningExpired} />}
  {isBankTransfer && (
    <BankTransferPay
      pending={pending}
      guestToken={guestParam!}
      expired={payExpired}
      errorMsg={queryError}
      successMsg={querySuccess}
    />
  )}
  {isGateway && (
    <div class="mx-auto max-w-md rounded-2xl border border-line bg-surface p-6 text-center">
      <h1 class="gg-h2 text-ink">پرداخت سفارش تکمیل نشد</h1>
      <p class="mt-2 text-sm text-muted">
        {queryError || 'تراکنش در درگاه بانکی لغو شد یا به خطا برخورد کرد. هیچ مبلغی از حساب شما کسر نشده است (یا در صورت کسر، طی ۷۲ ساعت توسط بانک بازگردانده می‌شود).'}
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a
          href="/cart"
          class="rounded-xl bg-brand px-5 py-2.5 text-sm font-semibold text-on-brand transition hover:bg-brand-hover"
        >
          بازگشت به سبد خرید و تلاش مجدد
        </a>
        <a
          href="/account/orders"
          class="rounded-xl border border-line bg-paper px-4 py-2.5 text-sm font-medium text-ink transition hover:border-brand"
        >
          سفارش‌های من
        </a>
      </div>
    </div>
  )}
</Layout>
