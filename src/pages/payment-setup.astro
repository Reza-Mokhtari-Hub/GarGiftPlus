---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

// Reached from the cart when a buyer taps a payment method that isn't configured
// yet. It's owner-facing setup help — how to turn that rail on — so the store can
// graduate from Demo to real payments without leaving a dead button.
const method = (Astro.url.searchParams.get('method') ?? '').toLowerCase();
const origin = Astro.url.origin;

interface Guide {
  title: string;
  intro: string;
  steps: string[];
}
const GUIDES: Record<string, Guide> = {
  zarinpal: {
    title: 'راه‌اندازی درگاه زرین‌پال (Zarinpal)',
    intro: 'پرداخت آنلاین ریالی با تمام کارت‌های عضو شبکه شتاب.',
    steps: [
      'کد پذیرنده (Merchant ID) را از پنل زرین‌پال دریافت کنید.',
      'در پنل مدیریت ← تنظیمات ← درگاه‌های پرداخت، حالت پیش‌فرض را روی زرین‌پال قرار داده و کلید پذیرنده را ثبت کنید.',
    ],
  },
  zibal: {
    title: 'راه‌اندازی درگاه زیبال (Zibal)',
    intro: 'درگاه پرداخت اینترنتی شتابی زیبال با تایید خودکار تراکنش.',
    steps: [
      'کد پذیرنده (Merchant) را از پنل زیبال دریافت کنید.',
      'در پنل مدیریت ← تنظیمات ← درگاه‌های پرداخت، کد پذیرنده زیبال را وارد و ذخیره کنید.',
    ],
  },
  bank_transfer: {
    title: 'راه‌اندازی کارت‌به‌کارت و فیش بانکی',
    intro: 'نمایش شماره کارت / شبا به مشتری و بررسی فیش واریزی در پنل مدیریت.',
    steps: [
      'در پنل مدیریت ← حساب‌های بانکی، حداقل یک شماره کارت فعال ثبت کنید.',
      'در تنظیمات پرداخت، روش کارت‌به‌کارت را فعال کنید تا در سبد خرید نمایش داده شود.',
    ],
  },
  lightning: {
    title: 'راه‌اندازی پرداخت Bitcoin Lightning',
    intro: 'دریافت پرداخت آنی از طریق نود LNbits یا phoenixd.',
    steps: [
      'یک سرویس LNbits یا نود phoenixd راه‌اندازی کنید.',
      'در پنل مدیریت ← تنظیمات ← پرداخت‌ها، نود و نشانی آن را تنظیم و کلید API را در گاوصندوق کلیدها ذخیره کنید.',
    ],
  },
  stripe: {
    title: 'راه‌اندازی پرداخت کارتی بین‌المللی (Stripe)',
    intro: 'دریافت پرداخت با Visa و Mastercard از طریق Stripe Checkout.',
    steps: [
      'کلید Secret Key را از داشبورد Stripe دریافت کنید.',
      'در پنل مدیریت ← تنظیمات ← کلیدهای پرداخت ثبت کنید.',
      `وب‌هوک Stripe را به نشانی ${origin}/api/webhook/stripe متصل کنید.`,
    ],
  },
  opennode: {
    title: 'راه‌اندازی درگاه OpenNode',
    intro: 'پرداخت بیت‌کوین و Lightning از طریق OpenNode.',
    steps: [
      'کلید API را از حساب OpenNode دریافت کنید و در تنظیمات پرداخت وارد نمایید.',
      `نشانی وب‌هوک را روی ${origin}/api/webhook/opennode تنظیم کنید.`,
    ],
  },
};
const guide = GUIDES[method] ?? null;
---

<Layout title="راهنمای راه‌اندازی پرداخت" description="نحوه فعال‌سازی روش‌های پرداخت در فروشگاه">
  <div class="mx-auto max-w-xl py-8">
    <a href="/cart" class="text-xs font-medium text-faint hover:text-brand-fg">
      ← بازگشت به سبد خرید
    </a>

    {
      guide ? (
        <>
          <h1 class="gg-h2 mt-4 text-ink">{guide.title}</h1>
          <p class="mt-3 text-sm text-muted">{guide.intro}</p>
          <ol class="mt-6 space-y-3">
            {guide.steps.map((s, i) => (
              <li class="flex gap-3 text-sm">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand/10 text-xs font-semibold text-brand-fg">
                  {i + 1}
                </span>
                <span class="pt-0.5 leading-6 text-muted">{s}</span>
              </li>
            ))}
          </ol>
        </>
      ) : (
        <>
          <h1 class="gg-h2 mt-4 text-ink">راه‌اندازی روش‌های پرداخت</h1>
          <p class="mt-3 text-sm leading-7 text-muted">
            این روش پرداخت هنوز پیکربندی نشده است. از بخش
            <strong class="mx-1 text-ink">پنل مدیریت ← تنظیمات ← روش‌های پرداخت</strong>
            می‌توانید کیف پول، کارت‌به‌کارت یا درگاه‌های زرین‌پال و زیبال را فعال کنید.
          </p>
        </>
      )
    }

    <div class="mt-8 rounded-xl border border-amber-400/50 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:bg-amber-950/40 dark:text-amber-200">
      تا زمان تکمیل تنظیمات درگاه، در صورت فعال بودن <strong class="font-semibold">حالت آزمایشی (Demo)</strong> می‌توانید کل فرآیند ثبت سفارش را بدون کسر وجه واقعی آزمایش کنید.
    </div>
  </div>
</Layout>
