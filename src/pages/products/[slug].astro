---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import ProductDetail from '#theme/ProductDetail.astro';
import { loadProductDetail } from '../../features/storefront/productDetail';
import { getConfig } from '../../config';
import { publicOrigin } from '../../features/http/origin';
import { addCacheTags, productCacheTags } from '../../features/cache/tags';

const loaded = await loadProductDetail(env.DB, {
  slug: Astro.params.slug,
  searchParams: Astro.url.searchParams,
  settings: Astro.locals.settings,
  imageBaseUrl: getConfig().images.baseUrl,
  delivery: Astro.locals.settings?.imageDelivery,
  currency: getConfig().currency,
  origin: publicOrigin(Astro.url.origin, env.CANONICAL_ORIGIN),
  pathname: Astro.url.pathname,
});

if (loaded.status === 'not_found') {
  return new Response('یافت نشد', { status: 404 });
}

const { model, purchase, seo } = loaded;
addCacheTags(Astro.response.headers, productCacheTags(loaded.cacheTagIds));
if (loaded.backfillRelated) {
  Astro.locals.cfContext?.waitUntil(loaded.backfillRelated());
}
---

<Layout title={seo.title} description={seo.description ?? undefined} image={seo.imagePath}>
  <ProductDetail model={model} purchase={purchase} />

  <script is:inline type="application/ld+json" set:html={seo.jsonLd} />

  <script>
    // @ts-nocheck -- plain-JS client script
    const form = document.querySelector('[data-options-form]');
    const out = document.querySelector('[data-price-display]');
    const outValue = document.querySelector('[data-price-value]');
    const compareOut = document.querySelector('[data-compare-price-display]');
    const track = document.querySelector('[data-hero-track]');
    if (form instanceof HTMLFormElement && out instanceof HTMLElement) {
      const currency = (out.dataset.currency || 'irt').toUpperCase();
      const base = Number(out.dataset.base || '0');
      const persianDigits = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
      const toFaDigits = (s) => String(s).replace(/\d/g, (d) => persianDigits[Number(d)] ?? d);
      const isIranCurrency = currency === 'IRT' || currency === 'IRR';
      const intFmt = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0, useGrouping: true });
      const fmt = isIranCurrency
        ? null
        : new Intl.NumberFormat('en-US', { style: 'currency', currency });
      const divisor = isIranCurrency ? 1 : 10 ** (fmt.resolvedOptions().maximumFractionDigits ?? 2);
      const formatAmount = (amount) => {
        if (currency === 'IRT') {
          return `${toFaDigits(intFmt.format(Math.trunc(amount)).replace(/,/g, '٬'))} تومان`;
        }
        if (currency === 'IRR') {
          return `${toFaDigits(intFmt.format(Math.trunc(amount)).replace(/,/g, '٬'))} ریال`;
        }
        return fmt.format(amount / divisor);
      };

      const showImage = (imageId) => {
        if (!(track instanceof HTMLElement) || !imageId) return;
        const img = document.getElementById(`pi-${imageId}`);
        if (img instanceof HTMLElement && track.contains(img)) {
          track.scrollLeft = img.offsetLeft;
        }
      };

      const update = (scroll, eventTarget) => {
        // Only update price/gallery — never touch or reset customer custom inputs (`cf_*`).
        const v = form.querySelector('input[name="variant_id"]:checked');
        let cents = v ? Number(v.getAttribute('data-price')) : base;
        for (const e of form.querySelectorAll('input[name="extra"]:checked')) {
          cents += Number(e.getAttribute('data-price')) || 0;
        }
        const formatted = formatAmount(cents);
        if (outValue instanceof HTMLElement) {
          outValue.textContent = formatted;
        } else {
          out.textContent = formatted;
        }
        if (compareOut instanceof HTMLElement) {
          const vCmp = v ? Number(v.getAttribute('data-compare') || '0') : 0;
          if (vCmp > cents) {
            compareOut.textContent = formatAmount(vCmp);
            compareOut.classList.remove('hidden');
          } else if (!v) {
            // Keep server-rendered product compare price when no variant exists
          } else {
            compareOut.classList.add('hidden');
          }
        }
        if (scroll && v && (!eventTarget || eventTarget.getAttribute?.('name') === 'variant_id')) {
          showImage(v.getAttribute('data-image-id') || '');
        }
      };

      form.addEventListener('change', (ev) => update(true, ev.target));
      update(false, null);
    }
  </script>

  <script>
    // @ts-nocheck -- plain-JS client script
    const btn = document.querySelector('[data-share]');
    if (btn instanceof HTMLElement) {
      const canShare = typeof navigator.share === 'function';
      const canCopy = !!navigator.clipboard?.writeText;
      if (canShare || canCopy) {
        btn.classList.remove('hidden');
        btn.classList.add('inline-flex');
        const label = btn.querySelector('[data-share-label]');
        btn.addEventListener('click', async () => {
          const url = location.href;
          const title = btn.dataset.shareTitle || document.title;
          if (canShare) {
            try {
              await navigator.share({ title, url });
            } catch {
              /* user cancelled */
            }
            return;
          }
          await navigator.clipboard.writeText(url);
          if (label) {
            const prev = label.textContent;
            label.textContent = 'لینک کپی شد';
            setTimeout(() => {
              label.textContent = prev;
            }, 1500);
          }
        });
      }
    }
  </script>
</Layout>
