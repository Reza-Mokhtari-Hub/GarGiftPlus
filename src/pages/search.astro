---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { getSearchProvider } from '../features/search';
import { productsInSharedCategories } from '../features/categories/db';
import ProductCard from '#theme/ProductCard.astro';
import { buildProductCard } from '../features/storefront/productCard';
import { getConfig } from '../config';
import { MAX_PUBLIC_PAGE, paginate, queryHref, requestedPage } from '../pagination';
import Pagination from '../components/Pagination.astro';
import { normalizeSearchQuery } from '../features/search/query';
import { addCacheTags, productCacheTags } from '../features/cache/tags';
import { fa } from '../i18n/fa';
import { toPersianDigits } from '../lib/format';

const q = normalizeSearchQuery(Astro.url.searchParams.get('q') ?? '');
const PAGE_SIZE = 24;
const requested = requestedPage(Astro.url.searchParams, MAX_PUBLIC_PAGE);
const requestedOffset = (requested - 1) * PAGE_SIZE;

const provider = await getSearchProvider();
let result = q
  ? await provider.search(q, { limit: PAGE_SIZE, offset: requestedOffset })
  : { products: [], total: 0, correctedTo: null };
const pageInfo = paginate(Astro.url.searchParams, result.total, PAGE_SIZE, MAX_PUBLIC_PAGE);
if (q && pageInfo.offset !== requestedOffset) {
  result = await provider.search(q, { limit: PAGE_SIZE, offset: pageInfo.offset });
}
const { products, total, correctedTo: suggestion } = result;
const { page, totalPages } = pageInfo;
const hrefFor = (p: number) =>
  queryHref('/search', { q, page: p > 1 ? p : undefined });
const autoCorrected = suggestion !== null;

const TARGET = 12;
const fillers =
  page === 1 && total < TARGET && products.length > 0 && products.length < TARGET
    ? await productsInSharedCategories(
        env.DB,
        products.map((p) => p.id),
        TARGET - products.length,
      )
    : [];
addCacheTags(
  Astro.response.headers,
  productCacheTags([...products, ...fillers].map((product) => product.public_id)),
);

const cardOptions = {
  baseUrl: getConfig().images.baseUrl,
  currency: getConfig().currency,
  delivery: Astro.locals.settings?.imageDelivery,
  sizes: '(min-width: 1024px) 352px, calc(50vw - 36px)',
};
const cards = products.map((product, i) =>
  buildProductCard(product, { ...cardOptions, priority: i === 0 }),
);
const fillerCards = fillers.map((product) => buildProductCard(product, cardOptions));
---

<Layout title={q ? `${fa.navigation.search}: ${q}` : fa.navigation.search}>
  <div class="mb-8">
    <p class="text-xs font-semibold text-accent-fg">{fa.navigation.search}</p>
    <h1 class="gg-h1 mt-2 text-ink">
      {q ? q : fa.navigation.searchAriaLabel}
    </h1>
  </div>

  <form method="GET" action="/search" class="mb-10 max-w-lg" role="search">
    <div class="flex gap-2">
      <input
        type="search"
        name="q"
        value={q}
        placeholder={fa.navigation.searchPlaceholder}
        aria-label={fa.navigation.searchAriaLabel}
        autofocus={!q}
        class="w-full rounded-lg border border-line bg-surface px-4 py-2.5 text-sm text-ink transition-colors focus:border-brand focus:outline-none"
      />
      <button
        type="submit"
        class="rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-on-brand transition-colors hover:bg-brand-hover"
      >
        {fa.navigation.search}
      </button>
    </div>
  </form>

  {
    q &&
      (autoCorrected ? (
        <p class="mb-8 text-sm text-muted">
          نتیجه‌ای برای «{q}» پیدا نشد — نمایش نتایج برای{' '}
          <strong class="font-semibold text-ink">{suggestion}</strong>
        </p>
      ) : products.length > 0 ? (
        <p class="mb-6 text-xs font-medium text-muted">
          {toPersianDigits(total)} نتیجه برای «{q}»
        </p>
      ) : null)
  }

  {
    products.length > 0 && (
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {cards.map((card, i) => (
          <ProductCard card={card} index={i} />
        ))}
      </ul>
    )
  }

  {
    fillers.length > 0 && (
      <>
        <p class="mb-6 mt-14 text-sm font-semibold text-muted">
          محصولات بیشتر از همین دسته‌بندی‌ها
        </p>
        <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {fillerCards.map((card, i) => (
            <ProductCard card={card} index={i} />
          ))}
        </ul>
      </>
    )
  }

  {
    q && products.length === 0 && (
      <div
        role="status"
        class="rounded-xl border border-dashed border-line bg-surface p-8 text-center text-sm text-muted"
      >
        محصولی مطابق با «{q}» پیدا نشد. عبارت دیگری را امتحان کنید.
      </div>
    )
  }

  <Pagination page={page} totalPages={totalPages} hrefFor={hrefFor} />
</Layout>
