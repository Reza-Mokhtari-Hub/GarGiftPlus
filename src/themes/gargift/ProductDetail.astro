---
import type { ProductDetailModel, ProductPurchaseModel } from '../../features/storefront/models';
import ProductCard from './ProductCard.astro';
import ProductGallery from '../../features/storefront/controls/ProductGallery.astro';
import ProductPurchaseForm from '../../features/storefront/controls/ProductPurchaseForm.astro';

/**
 * صفحه جزئیات محصول دیجیتال GarGift+ با مشخصات برند، ریجن، زمان تحویل،
 * قیمت تخفیف‌خورده، راهنمای فعال‌سازی، سوالات متداول و فرم سفارش سفارشی.
 */
interface Props {
  model: ProductDetailModel;
  purchase: ProductPurchaseModel;
}

const { model, purchase } = Astro.props;
const faq = model.faq ?? [];
---

<a
  href={model.backHref}
  class="inline-flex items-center gap-1.5 text-xs font-medium text-faint transition-colors hover:text-brand-fg"
>
  <span aria-hidden="true">&rarr;</span>
  <span>بازگشت به فروشگاه</span>
</a>

{
  model.error && (
    <p
      role="alert"
      class="gg-status-warning mt-4 rounded-lg border px-4 py-2.5 text-sm font-medium"
    >
      {model.error}
    </p>
  )
}

<div class="mt-6 grid gap-8 md:grid-cols-2 md:gap-12">
  <ProductGallery
    images={model.images}
    hero={model.heroImage}
    soldOut={model.soldOut}
    soldOutLabel="غیرفعال"
    class="reveal"
  />

  <div class="reveal flex flex-col" style="animation-delay:80ms">
    {
      model.categories.length > 0 && (
        <div class="mb-3 flex flex-wrap gap-2 text-xs">
          {model.categories.map((category) => (
            <a
              href={category.href}
              class="rounded-md bg-brand-soft px-2.5 py-1 font-medium text-brand-fg transition-colors hover:bg-brand hover:text-on-brand"
            >
              {category.text}
            </a>
          ))}
        </div>
      )
    }

    <div class="flex flex-wrap items-center gap-2">
      {
        model.badge && (
          <span class="rounded-md bg-brand-soft px-2.5 py-1 text-xs font-semibold text-brand-fg">
            {model.badge}
          </span>
        )
      }
      {
        model.digitalDelivery && (
          <span class="rounded-md bg-surface-elevated px-2.5 py-1 text-xs font-medium text-accent-fg">
            سرویس و محصول دیجیتال
          </span>
        )
      }
      <span
        class={`rounded-md border px-2.5 py-1 text-xs font-medium ${
          model.soldOut
            ? 'gg-status-disabled'
            : 'border-brand/25 bg-surface text-ink'
        }`}
      >
        {model.availabilityLabel || (model.soldOut ? 'غیرفعال' : 'قابل سفارش')}
      </span>
    </div>

    <h1 class="gg-h1 mt-3 text-ink">{model.name}</h1>

    {
      model.shortDescription && (
        <p class="mt-2 text-sm leading-relaxed text-muted">{model.shortDescription}</p>
      )
    }

    {
      (model.brand || model.region || model.estimatedDelivery) && (
        <dl class="mt-4 grid grid-cols-1 gap-2 rounded-xl border border-line bg-surface p-3.5 text-xs sm:grid-cols-2">
          {model.brand && (
            <div class="flex items-center justify-between gap-2">
              <dt class="text-faint">برند / پلتفرم:</dt>
              <dd class="font-semibold text-ink">{model.brand}</dd>
            </div>
          )}
          {model.region && (
            <div class="flex items-center justify-between gap-2">
              <dt class="text-faint">ریجن / منطقه:</dt>
              <dd class="font-semibold text-ink">{model.region}</dd>
            </div>
          )}
          {model.estimatedDelivery && (
            <div class="flex items-center justify-between gap-2 sm:col-span-2">
              <dt class="text-faint">زمان تقریبی تحویل:</dt>
              <dd class="font-semibold text-accent-fg">{model.estimatedDelivery}</dd>
            </div>
          )}
          <div class="flex items-center justify-between gap-2 sm:col-span-2">
            <dt class="text-faint">نحوه تحویل:</dt>
            <dd class="font-medium text-muted">تحویل دستی توسط تیم گرگیفت+ پس از تایید پرداخت</dd>
          </div>
        </dl>
      )
    }

    <div class="mt-5 flex flex-wrap items-baseline gap-3">
      <p
        class="gg-numeric text-2xl font-extrabold text-ink"
        data-price-display
        data-base={model.priceCents}
        data-currency={model.currency}
      >
        {model.priceVaries && (
          <span data-price-prefix class="text-sm font-medium text-faint">
            شروع قیمت از{' '}
          </span>
        )}
        <span data-price-value>{model.formattedPrice}</span>
      </p>
      <span
        data-compare-price-display
        class={`gg-numeric text-sm text-faint line-through${model.formattedComparePrice ? '' : ' hidden'}`}
      >
        {model.formattedComparePrice ?? ''}
      </span>
      {
        model.discountPercent && (
          <span class="rounded-md bg-brand-soft px-2 py-0.5 text-xs font-semibold text-brand-fg">
            {model.discountPercent}٪ تخفیف
          </span>
        )
      }
    </div>

    {
      model.lowStock && (
        <p
          data-low-stock
          class="gg-status-warning mt-2 w-fit rounded-md border px-2.5 py-1 text-xs font-medium"
        >
          محدودیت ثبت سفارش موقت
        </p>
      )
    }

    {
      model.descriptionHtml && (
        <div
          class="markdown-content mt-6 max-w-prose text-sm text-muted"
          set:html={model.descriptionHtml}
        />
      )
    }

    <ProductPurchaseForm model={purchase} />

    <button
      type="button"
      data-share
      data-share-title={model.name}
      class="mt-6 hidden w-fit items-center gap-2 rounded-md border border-line bg-surface px-3 py-1.5 text-xs font-medium text-muted transition-colors hover:border-brand hover:text-brand-fg"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="18" cy="5" r="3" />
        <circle cx="6" cy="12" r="3" />
        <circle cx="18" cy="19" r="3" />
        <line x1="8.6" y1="13.5" x2="15.4" y2="17.5" />
        <line x1="15.4" y1="6.5" x2="8.6" y2="10.5" />
      </svg>
      <span data-share-label>اشتراک‌گذاری</span>
    </button>
  </div>
</div>

{
  (model.instructionsHtml || faq.length > 0) && (
    <div class="mt-12 grid gap-8 border-t border-line pt-10 lg:grid-cols-2">
      {model.instructionsHtml && (
        <section class="rounded-xl border border-line bg-surface p-6">
          <h2 class="gg-h2 mb-4 text-ink">راهنمای استفاده و فعال‌سازی</h2>
          <div class="markdown-content text-sm text-muted" set:html={model.instructionsHtml} />
        </section>
      )}

      {faq.length > 0 && (
        <section class="rounded-xl border border-line bg-surface p-6">
          <h2 class="gg-h2 mb-4 text-ink">پرسش‌های متداول</h2>
          <div class="flex flex-col gap-3">
            {faq.map((item) => (
              <details class="group rounded-lg border border-line bg-paper px-4 py-3">
                <summary class="cursor-pointer text-sm font-semibold text-ink marker:text-brand-fg">
                  {item.q}
                </summary>
                <p class="mt-2 border-t border-line pt-2 text-sm leading-relaxed text-muted">
                  {item.a}
                </p>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>
  )
}

{
  model.related.length > 0 && (
    <section class="mt-16 border-t border-line pt-10">
      <h2 class="gg-h2 mb-6 text-ink">محصولات مرتبط</h2>
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {model.related.map((card, i) => (
          <ProductCard card={card} index={i} headingLevel="h3" />
        ))}
      </ul>
    </section>
  )
}
