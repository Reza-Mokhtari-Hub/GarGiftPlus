{
  // GarGift+ Cloudflare Worker instance template.
  // scripts/provision-cf.sh fills the __…__ placeholders, renders wrangler.jsonc,
  // deploys, and restores the original config. Keep shared runtime settings aligned.
  //
  // FREE-PLAN DEFAULT: D1 + two R2 buckets (public media + private deliverables/receipts).
  // Optional bindings (add + redeploy to enable; code degrades gracefully when absent):
  //   • Semantic search — add "ai": { "binding": "AI" } and
  //     "vectorize": [{ "binding": "VECTORIZE", "index_name": "<name>-products" }]
  //     then enable in Admin → Settings → Search. Default: SQLite FTS5.
  //   • Image optimize-on-upload — add "images": { "binding": "IMAGES" }, set
  //     images.optimizeOnUpload in src/store.config.ts, and redeploy.
  //   • Cloudflare-native email — add "send_email": [{ "name": "EMAIL" }] (Workers
  //     Paid plan + onboarded sender domain). Resend (HTTP) works on the free plan
  //     and its API key is stored encrypted in Admin → Settings → Email.
  //
  // Provider keys (Zarinpal, Zibal, Resend, Turnstile) are stored encrypted in D1 via
  // Admin → Settings; only SECRETS_KEK, AUTH_SECRET, and optional CACHE_PURGE_SECRET
  // live in Wrangler secrets (`wrangler secret put`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__NAME__",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  // Recurring jobs (handler: src/worker.ts) — retries queued notifications and
  // releases expired inventory holds without waiting for the next shopper.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 1 } },
  // Fresh instances begin on workers.dev and stay uncached. Custom-domain production
  // configs should enable cache alongside CANONICAL_ORIGIN and workers_dev: false,
  // plus a dedicated CACHE_PURGE_SECRET for post-deploy cache invalidation.
  "cache": { "enabled": false },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "CHECKOUT_RATE_LIMITER",
      "namespace_id": "10002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "10003",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__DB_NAME__",
      "database_id": "__DB_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "__BUCKET__" },
    // Private deliverables: never enable r2.dev or attach a custom domain.
    { "binding": "FILES", "bucket_name": "__FILES_BUCKET__" }
  ],
  "vars": {
    "STORE_NAME": "GarGift+",
    "TIME_ZONE": "Asia/Tehran"
    // Custom domain canonical HTTPS origin (set for custom-domain production/staging):
    // "CANONICAL_ORIGIN": "https://shop.example.com"
    //
    // Serve product images from an R2 custom domain (bypasses the Worker /images
    // route and unlocks on-demand delivery in Admin):
    // "IMAGE_BASE_URL": "https://images.example.com"
    //
    // Optional Cloudflare Access JWT verification for /admin/*:
    // "CF_ACCESS_TEAM_DOMAIN": "https://<team>.cloudflareaccess.com",
    // "CF_ACCESS_AUD": "<access-application-aud-tag>"
    //
    // Optional MCP endpoint advertised in llms.txt only when configured:
    // "MCP_URL": "https://your-mcp-host/mcp"
  }
}
